        local dug, digReason = action.dig()
        if dug then
          state.stats.blocksDug = (state.stats.blocksDug or 0) + 1
          if not preserveSealMarker then noteMinedMaterial(name) end
          commitPhysicalAction()
          sleep(0.1)
        else
          cancelPhysicalAction()
          lastReason = digReason or ("Cannot dig " .. name)
          sleep(retryDelay)
        end
      end
    end

    local after = geo.poseAfterMove(state.pose, direction)
    local prepared, prepareError = beginPhysicalAction("move_" .. direction, nil, after)
    if not prepared then return false, prepareError end
    local moved, moveReason = action.move()
    if moved then
      updatePoseAfterMove(direction)
      -- A successful move normally ends a fluid-seal run.  When the moved
      -- block was the seal marker we just carved, preserve the run so a
      -- contiguous fluid column reaches maxContinuousSeal across cells.
      if preserveSealMarker then
        state.fluidSealMarker = nil
      else
        state.fluidSealRun = 0
        state.water.continuousSeals = 0
        state.fluidSealMarker = nil
      end
      local gpsOK, gpsError = verifyGPS(false)
      if not gpsOK then return false, gpsError end
      commitPhysicalAction()
      heartbeat(false)
      return true
    end
    cancelPhysicalAction()
    lastReason = moveReason or lastReason
    local blockedNow = action.inspect()
    if not blockedNow then
      if config.attackEntities and action.attack then pcall(action.attack) end
      sleep(retryDelay)
    else
      sleep(0.1)
    end
  end
  return false, lastReason
end

local function moveX(targetX, context)
  while state.pose.x ~= targetX do
    local targetDir = state.pose.x < targetX and 1 or 3
    local ok, err = turnTo(targetDir)
    if not ok then return false, err end
    ok, err = moveOne("forward", context)
    if not ok then return false, err end
  end
  return true
end

local function moveZ(targetZ, context)
  while state.pose.z ~= targetZ do
    local targetDir = state.pose.z < targetZ and 0 or 2
    local ok, err = turnTo(targetDir)
    if not ok then return false, err end
    ok, err = moveOne("forward", context)
    if not ok then return false, err end
  end
  return true
end

local function moveY(targetY, context)
  while state.pose.y < targetY do
    local ok, err = moveOne("up", context)
    if not ok then return false, err end
  end
  while state.pose.y > targetY do
    local ok, err = moveOne("down", context)
    if not ok then return false, err end
  end
  return true
end

local function navigateTo(target, route, context)
  target = target or { x = 0, y = 0, z = 0 }
  local ok, err
  if route == "home" then
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
  elseif route == "inside" then
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
  else
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
  end
  return true
end

local function chunkAnchor(plan, key, y)
  local chunk = plan and plan.chunks and plan.chunks[key]
  if not chunk then return nil, "Unknown chunk " .. tostring(key) end
  return { x = chunk.anchor.x, y = y, z = chunk.anchor.z }
end

local function serviceDockAnchor(plan, y)
  local key = plan and (plan.dockKey or plan.entranceKey or plan.rootKey)
  if not key then return nil, "Service plan has no dock chunk." end
  local anchor, err = chunkAnchor(plan, key, y)
  if not anchor then return nil, err end
  anchor.chunkKey = key
  return anchor, key
end

local function moveBetweenChunkAnchors(plan, fromKey, toKey, y, context)
  local from = plan.chunks[fromKey]
  local target, err = chunkAnchor(plan, toKey, y)
  if not from or not target then return false, err or "Missing chunk anchor." end
  local adjacent = false
  for _, key in ipairs(from.neighbors or {}) do if key == toKey then adjacent = true; break end end
  if not adjacent then return false, "Chunk route is not adjacent: " .. tostring(fromKey) .. " -> " .. tostring(toKey) end
  return navigateTo(target, "inside", context)
end

local function normalizeWaypoint(value, fallbackY)
  if type(value) ~= "table" then return nil end
  local pose = value.pose or value.position or value.target or value
  if type(pose) ~= "table" then return nil end
  local x, z = tonumber(pose.x), tonumber(pose.z)
  if not x or not z then return nil end
  return { x = x, y = tonumber(pose.y) or tonumber(fallbackY) or 0, z = z,
    dir = pose.dir ~= nil and ((tonumber(pose.dir) or 0) % 4) or nil }
end

local function routeChunkKeys(plan, fromKey, toKey)
  if type(quarry.shortestChunkPath) == "function" then
    local ok, path = pcall(quarry.shortestChunkPath, plan, fromKey, toKey)
    if ok and type(path) == "table" then path = path.chunkKeys or path.path or path.keys end
    if ok and type(path) == "table" and #path > 0 then return path, "bfs" end
  end
  if fromKey == toKey then return { fromKey }, "same" end
  return nil
end

-- Assigned plans intentionally do not persist mutable parent pointers, so a
-- worker that resumes with an older quarry module may not have pathToRoot.
-- Keep a bounded graph-only DFS fallback over the validated neighbor edges.
local function dfsChunkPath(plan, fromKey, toKey)
  if fromKey == toKey then return { fromKey } end
  local chunks = plan and plan.chunks or {}
  if not chunks[fromKey] or not chunks[toKey] then return nil end
  local visited = { [fromKey] = true }
  local stack = { { key = fromKey, next = 1 } }
  local parent = {}
  while #stack > 0 do
    local frame = stack[#stack]
    if frame.key == toKey then
      local path, key = {}, toKey
      while key do path[#path + 1] = key; key = parent[key] end
      local reversed = {}
      for index = #path, 1, -1 do reversed[#reversed + 1] = path[index] end
      return reversed
    end
    local neighbors = chunks[frame.key].neighbors or {}
    local nextKey
    while frame.next <= #neighbors do
      local candidate = tostring(neighbors[frame.next]); frame.next = frame.next + 1
      if chunks[candidate] and not visited[candidate] then nextKey = candidate; break end
    end
    if nextKey then
      visited[nextKey] = true; parent[nextKey] = frame.key
      stack[#stack + 1] = { key = nextKey, next = 1 }
    else
      stack[#stack] = nil
    end
  end
  return nil
end

local function transitionWaypoints(plan, fromKey, toKey, y)
  if type(quarry.edgeTransition) == "function" then
    local attempts = {
      function() return quarry.edgeTransition(plan, fromKey, toKey, y) end,
      function() return quarry.edgeTransition(plan, plan.chunks[fromKey], plan.chunks[toKey], y) end,
    }
    for _, attempt in ipairs(attempts) do
      local ok, result = pcall(attempt)
      if ok and result then
        if type(result) == "table" and (result.waypoints or result.path) then result = result.waypoints or result.path end
        if type(result) == "table" and result.from and result.to then
          -- New quarry API returns one validated edge as `{from,to}`;
          -- normalize it to the waypoint sequence consumed by the turtle.
          result = { result.from, result.to }
        end
        if type(result) == "table" then
          local normalized = {}
          for _, waypoint in ipairs(result) do
            local item = normalizeWaypoint(waypoint, y)
            if item then normalized[#normalized + 1] = item end
          end
          if #normalized > 0 then return normalized end
        end
      end
    end
  end
  return nil
end

local function navigateServiceRoute(plan, fromPose, toPose, context, mode)
  if not plan then return navigateTo(toPose, mode or "work", context) end
  fromPose, toPose = poseCopy(fromPose), poseCopy(toPose)
  local endpointFromKey = quarry.findChunk(plan, fromPose.x, fromPose.z)
  local endpointToKey = quarry.findChunk(plan, toPose.x, toPose.z)
  if not endpointFromKey or not endpointToKey then
    return false, "Service route endpoint is outside the assigned chunk plan."
  end
  local routeResult
  if type(quarry.shortestServiceRoute) == "function" then
    local ok, result = pcall(quarry.shortestServiceRoute, plan, fromPose, toPose, {
      mode = mode or "work", context = context,
      breadcrumbs = state.job and state.job.route and state.job.route.breadcrumbs or nil,
    })
    if ok and type(result) == "table" then routeResult = result end
  end
  if routeResult and type(routeResult.waypoints) == "table" then
    local waypoints = routeResult.waypoints
    if waypoints.from and waypoints.to then waypoints = { waypoints.from, waypoints.to } end
    for _, waypoint in ipairs(waypoints) do
      local target = normalizeWaypoint(waypoint, toPose.y)
      if target and not samePosePosition(state.pose, target) then
        local ok, err = navigateTo(target, "inside", context)
        if not ok then return false, err end
      end
    end
    if routeResult.distance then
      state.routeMetrics = state.routeMetrics or {}
      state.routeMetrics.lastRoute = { distance = routeResult.distance, fallback = routeResult.fallback }
    end
    return navigateTo(toPose, "inside", context)
  end

  local fromKey, toKey = endpointFromKey, endpointToKey
  if fromKey and toKey then
    local keys, routeKind = routeChunkKeys(plan, fromKey, toKey)
    if not keys and state.job and state.job.route and type(state.job.route.breadcrumbs) == "table" then
      -- Breadcrumbs are only a fallback.  They are generated from accepted
      -- chunk transitions and therefore cannot introduce an unplanned edge.
      local crumbs = state.job.route.breadcrumbs
      local start = nil
      for index, key in ipairs(crumbs) do if key == fromKey then start = index; break end end
      if start then
        keys = {}
        for index = start, #crumbs do keys[#keys + 1] = crumbs[index] end
        if keys[#keys] ~= toKey then keys[#keys + 1] = toKey end
        routeKind = "breadcrumbs"
      end
    end
    if not keys then
      keys = dfsChunkPath(plan, fromKey, toKey)
      if keys then routeKind = "dfs" end
    end
    if not keys then
      local path, pathError = quarry.pathToRoot(plan, fromKey)
      if path and toKey == plan.rootKey then keys, routeKind = path, "dfs" end
      if not keys then
        local reverse, reverseError = quarry.pathFromRoot(plan, toKey)
        if reverse and fromKey == plan.rootKey then keys, routeKind = reverse, "dfs" end
        if not keys then return false, pathError or reverseError or "No safe chunk service route." end
      end
    end
    for index = 2, #keys do
      local edge = transitionWaypoints(plan, keys[index - 1], keys[index], fromPose.y)
      if edge then
        for _, waypoint in ipairs(edge) do
          local ok, err = navigateTo(waypoint, "inside", context)
          if not ok then return false, err end
        end
      else
        local ok, err = moveBetweenChunkAnchors(plan, keys[index - 1], keys[index], fromPose.y, context)
        if not ok then return false, err end
      end
    end
    state.routeMetrics = state.routeMetrics or {}
    state.routeMetrics.lastRoute = { kind = routeKind or "fallback", chunkKeys = common.copy(keys) }
    return navigateTo(toPose, "inside", context)
  end
  return false, "No safe chunk service route."
end

local function navigateChunkPlanHome(context)
  local plan = state.job and state.job.chunkPlan
  if not plan then return navigateTo({ x = 0, y = 0, z = 0 }, "home", context) end
  if isHome() then return true end
  local currentKey = quarry.findChunk(plan, state.pose.x, state.pose.z)
  if not currentKey then return false, "Current position is outside every allowed chunk." end
  local dock, dockError = serviceDockAnchor(plan, state.pose.y)
  if not dock then return false, dockError end
  local ok, err = navigateServiceRoute(plan, state.pose, dock, context, "home")
  if not ok then return false, err end
  return navigateTo({ x = 0, y = 0, z = 0 }, "home", context)
end

local function navigateChunkPlanWork(checkpoint, context)
  local plan = state.job and state.job.chunkPlan
  if not plan then return navigateTo(checkpoint, "work", context) end
  local targetKey = quarry.findChunk(plan, checkpoint.x, checkpoint.z)
  if not targetKey then return false, "Checkpoint is outside every allowed chunk." end
  local fromKey = quarry.findChunk(plan, state.pose.x, state.pose.z)
  if not fromKey then
    local dock, dockError = serviceDockAnchor(plan, state.pose.y)
    if not dock then return false, dockError end
    local bridged, bridgeError = navigateTo(dock, "home", context)
    if not bridged then return false, bridgeError end
    return navigateServiceRoute(plan, dock, checkpoint, context, "work")
  end
  return navigateServiceRoute(plan, state.pose, checkpoint, context, "work")
end

local function estimatedReturnDistance(pose)
  pose = pose or state.pose
  if tonumber(pose.x) == 0 and tonumber(pose.y) == 0 and tonumber(pose.z) == 0 then return 0 end
  if not state.job or state.job.strategy ~= "chunk_plan" or not state.job.chunkPlan then
    return distance(pose, { x = 0, y = 0, z = 0 })
  end

  local plan = state.job.chunkPlan
  local currentKey = quarry.findChunk(plan, pose.x, pose.z)
  if not currentKey then return nil, "Current position is outside every allowed chunk." end
  if type(quarry.shortestServiceRoute) == "function" then
    local dockKey = plan.dockKey or plan.entranceKey or plan.rootKey
    local dock = plan.chunks and plan.chunks[dockKey]
    if dock then
      local dockPose = { x = dock.anchor.x, y = pose.y, z = dock.anchor.z }
      local ok, route = pcall(quarry.shortestServiceRoute, plan, pose, dockPose, { allowFallback = true })
      if ok and type(route) == "table" and tonumber(route.distance) then
        return tonumber(route.distance) + math.abs(dock.anchor.x) + math.abs(dock.anchor.z) + math.abs(tonumber(pose.y) or 0)
      end
    end
  end
  local dockKey = plan.dockKey or plan.entranceKey or plan.rootKey
  local path, pathError = quarry.pathToRoot(plan, currentKey)
  if not path or path[#path] ~= dockKey then path = dfsChunkPath(plan, currentKey, dockKey); pathError = pathError or "dfs_unavailable" end
  if not path then return nil, pathError end

  local current = plan.chunks[currentKey]
  local total = math.abs(pose.x - current.anchor.x) + math.abs(pose.z - current.anchor.z)
  for index = 2, #path do
    local from, target = plan.chunks[path[index - 1]], plan.chunks[path[index]]
    if not from or not target then return nil, "Chunk return path references a missing chunk." end
    total = total + math.abs(from.anchor.x - target.anchor.x) + math.abs(from.anchor.z - target.anchor.z)
  end
  local root = plan.chunks[dockKey]
  if not root then return nil, "Chunk return path has no entrance chunk." end
  total = total + math.abs(tonumber(pose.y) or 0)
  total = total + math.abs(root.anchor.x) + math.abs(root.anchor.z)
  return total
end

local function firstEmptySlot()
  for slot = 1, 16 do if not isReservedSlot(slot) and turtle.getItemCount(slot) == 0 then return slot end end
  return nil
end

local function firstFuelSlot()
  local materials = materialsConfig()
  local preferred = materials.fuelReserveSlots or config.fuelReserveSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "fuel") and turtle.getItemCount(slot) == 0 then return slot end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "fuel") and turtle.getItemCount(slot) == 0 then return slot end
  end
  return nil
end

local function looksLikeInventoryBlock(data)
  local name = string.lower(blockName(data))
  if name == "minecraft:chest" or name == "minecraft:trapped_chest" or name == "minecraft:barrel" then return true end
  return name:match("^minecraft:[%w_]+shulker_box$") ~= nil
end

local function discardPolicy()
  local policy = config.discard or {}
  local mode = tostring(policy.mode or policy.policy or "KEEP_ALL"):upper()
  if mode ~= "KEEP_ALL" and mode ~= "DISCARD_EXCESS_STONE" and mode ~= "CUSTOM_ALLOWLIST" then mode = "KEEP_ALL" end
  return policy, mode
end

local function isOreOrRawMaterial(name)
  name = string.lower(tostring(name or ""))
  -- Keep all ores/raw materials regardless of the selected allowlist.  The
  -- broad suffix/prefix checks intentionally err on the side of retention
  -- for modded names (an unknown resource is safer in the output chest).
  return name:find("_ore", 1, true) ~= nil
    or name:find("ore_", 1, true) ~= nil
    or name:find("raw_", 1, true) ~= nil
    or name:find("_raw", 1, true) ~= nil
    or name:find("rawore", 1, true) ~= nil
end

local function isUnknownModItem(name)
  local namespace = tostring(name or ""):match("^([^:]+):")
  if not namespace or namespace == "" then return true end
  if namespace == "minecraft" or namespace == "computercraft" or namespace == "cc_tweaked" then return false end
  local policy = config.discard or {}
  local known = policy.knownNamespaces or policy.knownMods
  if type(known) == "table" and (known[namespace] == true or known[namespace] == 1) then return false end
  return true
end

local function discardProtectedItem(slot, name)
  if not name or name == "unknown" then return true end
  if isTorchItemName(name) or isFuelItem(slot) then return true end
  if isOreOrRawMaterial(name) or isUnknownModItem(name) then return true end
  return false
end

local function explicitAllowlisted(name, policy)
  local allowlist = policy and (policy.allowlist or policy.allowList or policy.allowedItems)
  if type(allowlist) ~= "table" then return false end
  if allowlist[name] == true or allowlist[name] == 1 then return true end
  for _, item in ipairs(allowlist) do if tostring(item) == tostring(name) then return true end end
  return false
end

local function discardCandidate(slot, name, totalSeal, policy, mode)
  if mode == "KEEP_ALL" then return false end
  if mode == "CUSTOM_ALLOWLIST" then
    -- Torches, fuel, ores and raw materials remain hard protected.  Seal
    -- blocks may be selected, but the caller still enforces retainSealTarget.
    -- Unknown mod items are discardable only when their exact name is explicitly allowlisted.
    if isTorchItemName(name) or isFuelItem(slot) or isOreOrRawMaterial(name) then return false end
    if not explicitAllowlisted(name, policy) then return false end
    if isSealItemName(name) then
      local keep = math.max(0, tonumber(policy.retainSealTarget) or 64)
      return totalSeal > keep
    end
    return true
  end
  if discardProtectedItem(slot, name) then return false end
  if mode == "DISCARD_EXCESS_STONE" then
    local stone = policy.stoneAllowlist or {
      ["minecraft:stone"] = true, ["minecraft:cobblestone"] = true,
      ["minecraft:cobbled_deepslate"] = true,
    }
    if not (stone[name] == true or name == "minecraft:stone" or name == "minecraft:cobblestone" or name == "minecraft:cobbled_deepslate") then
      return false
    end
    -- Seal stock is retained by item count.  We drop whole stacks only when
    -- doing so leaves the configured 64 (or explicit) reserve intact.
    if isSealItemName(name) then
      local keep = math.max(1, tonumber(config.discard and config.discard.retainSealTarget) or 64)
      return totalSeal > keep
    end
    return true
  end
  return false
end

local function discardStatsTable()
  state.discardStats = state.discardStats or {}
  state.discard = state.discard or state.discardStats
  local stats = state.discardStats
  state.discard = common.merge(stats, state.discard)
  stats.mode = (config.discard and config.discard.mode) or stats.mode or "KEEP_ALL"
  stats.triggerEmptySlots = tonumber(config.discard and config.discard.triggerEmptySlots) or 3
  stats.maxStacksPerPass = tonumber(config.discard and config.discard.maxStacksPerPass) or 8
  stats.byName = stats.byName or {}
  return stats
end

local function noteDiscard(name, count)
  local stats = discardStatsTable()
  count = math.max(0, tonumber(count) or 0)
  stats.items = (stats.items or 0) + count
  stats.discarded = (stats.discarded or 0) + count
  stats.stacks = (stats.stacks or 0) + 1
  stats.byName[name] = (stats.byName[name] or 0) + count
  stats.lastAt = common.nowSeconds()
  state.stats.discardedBlocks = (state.stats.discardedBlocks or 0) + count
  state.stats.discardPasses = (state.stats.discardPasses or 0) + 1
end

local function noteDiscardSkip(name, unknown)
  local stats = discardStatsTable()
  stats.skipped = (stats.skipped or 0) + 1
  if unknown then stats.unknown = (stats.unknown or 0) + 1; state.stats.discardUnknown = (state.stats.discardUnknown or 0) + 1 end
  state.stats.discardSkipped = (state.stats.discardSkipped or 0) + 1
  stats.lastAt = common.nowSeconds()
end

local function sideTargetDirection(baseDir, side)
  side = tostring(side or "front"):lower()
  if side == "up" then side = "top" end
  if side == "down" then side = "bottom" end
  local relative = { front = 0, right = 1, back = 2, left = 3 }
  if relative[side] == nil then return nil end
  return ((tonumber(baseDir) or 0) + relative[side]) % 4
end

local function recycleRetainTarget()
  local materials, recycle = materialsConfig()
  local target = materials.retainSealTarget
    or recycle.maxHeld
    or recycle.retainSealTarget
    or config.retainSealTarget
    or config.sealTarget
    or 64
  return math.max(0, math.floor(tonumber(target) or 64))
end

local function homeRetainCounts()
  local policy = config.discard or {}
  local lighting = config.lighting or {}
  local materials = materialsConfig()
  local sealRemaining = math.max(0, math.floor(tonumber(policy.retainSealTarget
    or materials.retainSealTarget or config.sealTarget) or 64))
  local torchRemaining = effectiveLighting() == "off" and 0
    or math.max(0, math.floor(tonumber(lighting.target or lighting.torchTarget
      or materials.torchTarget or config.torchTarget) or 32))
  local keep = {}
  local function reserveRole(role, predicate, remaining)
    local order, seen = {}, {}
    local sets = materialSlotSets()
    for slot = 1, 16 do
      if sets[role] and sets[role][slot] then order[#order + 1], seen[slot] = slot, true end
    end
    for slot = 1, 16 do if not seen[slot] then order[#order + 1] = slot end end
    for _, slot in ipairs(order) do
      local count, name = turtle.getItemCount(slot), itemName(slot)
      if count > 0 and predicate(slot, name) and remaining > 0 then
        local amount = math.min(count, remaining)
        keep[slot], remaining = (keep[slot] or 0) + amount, remaining - amount
      end
    end
  end
  reserveRole("seal", function(_, name) return isSealItemName(name) end, sealRemaining)
  reserveRole("torch", function(_, name) return isTorchItemName(name) end, torchRemaining)
  for slot = 1, 16 do
    if slotRoleContains(slot, "fuel") and isFuelItem(slot) then keep[slot] = turtle.getItemCount(slot)
    elseif slotRoleContains(slot, "generic") then keep[slot] = turtle.getItemCount(slot) end
  end
  return keep
end

local function compressSealStacks()
  local originalSlot = turtle.getSelectedSlot()
  local moved = 0
  local function compactRole(role, predicate)
    local sets = materialSlotSets()
    local order, seen = {}, {}
    for slot = 1, 16 do
      if sets[role] and sets[role][slot] and not isReservedSlot(slot, role) then
        order[#order + 1], seen[slot] = slot, true
      end
    end
    for slot = 1, 16 do
      if not seen[slot] and not isReservedSlot(slot, role) then order[#order + 1] = slot end
    end
    for _, destination in ipairs(order) do
      -- Empty designated slots are filled first.  Older code only merged into
      -- occupied slots, so the documented material slots often stayed empty.
      if turtle.getItemCount(destination) == 0 and sets[role] and sets[role][destination] then
        for source = 1, 16 do
          if source ~= destination and not isReservedSlot(source, role)
            and turtle.getItemCount(source) > 0 and predicate(itemName(source)) then
            turtle.select(source)
            local before = turtle.getItemCount(source)
            if turtle.transferTo(destination) then moved = moved + before - turtle.getItemCount(source) end
            break
          end
        end
      end
      local name = itemName(destination)
      if name and predicate(name) then
        local space = turtle.getItemSpace(destination)
        for source = 1, 16 do
          if space <= 0 then break end
          if source ~= destination and not isReservedSlot(source, role)
            and turtle.getItemCount(source) > 0 and itemName(source) == name then
            turtle.select(source)
            local before = turtle.getItemCount(source)
            if turtle.transferTo(destination, math.min(space, before)) then
              moved = moved + before - turtle.getItemCount(source)
              space = turtle.getItemSpace(destination)
            end
          end
        end
      end
    end
  end
  compactRole("seal", isSealItemName)
  compactRole("torch", isTorchItemName)
  turtle.select(originalSlot)
  return moved
end

local function compressInventoryAtField()
  -- compactEvery is a local inventory operation.  It must never create a
  -- service/return merely to consolidate stacks, and it must not touch
  -- protected reserve slots or split a stack while moving items.
  local originalSlot = turtle.getSelectedSlot()
  local moved = compressSealStacks()
  for destination = 1, 16 do
    if not isReservedSlot(destination) and turtle.getItemCount(destination) > 0 then
      local name = itemName(destination)
      if name then
        local space = turtle.getItemSpace(destination)
        if space > 0 then
          for source = 1, 16 do
            if source ~= destination and not isReservedSlot(source)
              and turtle.getItemCount(source) > 0 and itemName(source) == name then
              turtle.select(source)
              local before = turtle.getItemCount(source)
              local ok = turtle.transferTo(destination, math.min(space, before))
              local after = turtle.getItemCount(source)
              if ok and after < before then
                local amount = before - after
                moved = moved + amount
                space = turtle.getItemSpace(destination)
                if space <= 0 then break end
              end
            end
          end
        end
      end
    end
  end
  turtle.select(originalSlot)
  if moved > 0 then
    state.stats.compressions = (state.stats.compressions or 0) + 1
    state.recycle = state.recycle or {}
    state.recycle.compressed = (state.recycle.compressed or 0) + moved
    state.recycle.lastAt = common.nowSeconds()
  end
  state.stats.lastCompressionAt = common.nowSeconds()
  return moved
end

local function updateRecycleInventoryState()
  local held, byName = 0, {}
  for slot = 1, 16 do
    local name = itemName(slot)
    if name and isSealItemName(name) then
      local count = turtle.getItemCount(slot)
      held = held + count
      byName[name] = (byName[name] or 0) + count
    end
  end
  state.recycle = state.recycle or {}
  state.recycle.held, state.recycle.byName = held, byName
  state.recycle.cap = recycleRetainTarget()
  state.recycle.overflow = math.max(0, held - state.recycle.cap)
  return held
end

local function inventoryPresent(side, inspectFunction)
  if peripheral and peripheral.hasType then
    local ok, result = pcall(peripheral.hasType, side, "inventory")
    if ok and result == true then return true end
  end
  local wrapped = peripheral and peripheral.wrap(side) or nil
  if wrapped and (type(wrapped.list) == "function" or type(wrapped.size) == "function") then return true end
  if inspectFunction then
    local ok, present, data = pcall(inspectFunction)
    if ok and present and looksLikeInventoryBlock(data) then return true end
  end
  return false
end

local function sideFunctions(side)
  local restoreDir = state.pose.dir
  if side == "front" then
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "back" then
    local ok, err = turnTo(2)
    if not ok then return nil, nil, nil, restoreDir, err end
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "right" then
    local ok, err = turnTo(1)
    if not ok then return nil, nil, nil, restoreDir, err end
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "left" then
    local ok, err = turnTo(3)
    if not ok then return nil, nil, nil, restoreDir, err end
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "top" then
    return turtle.inspectUp, turtle.suckUp, turtle.dropUp, restoreDir
  elseif side == "bottom" then
    return turtle.inspectDown, turtle.suckDown, turtle.dropDown, restoreDir
  end
  return nil, nil, nil, restoreDir, "Unsupported inventory side: " .. tostring(side)
end

local function restoreSideDirection(side, restoreDir)
  if side == "front" or side == "back" or side == "right" or side == "left" then return turnTo(restoreDir) end
  return true
end

local function runInventoryPhysicalAction(kind, details, action)
  local prepared, prepareError = beginPhysicalAction(kind, details, poseCopy())
  if not prepared then return false, prepareError end
  local ok, result = pcall(action)
  if not ok then
    -- Leave pendingAction intact: an exception leaves inventory outcome
    -- ambiguous and boot recovery must stop for manual revalidation.
    return false, tostring(result)
  end
  commitPhysicalAction()
  return result == true, result
end

local function unloadAtHome()
  state.phase, state.status = "unloading", "working"
  saveState("unload_start")
  local originalSlot = turtle.getSelectedSlot()
  local outputSide = config.outputSide or "back"
  local outInspect, _, outDrop, outRestore, sideError = sideFunctions(outputSide)
  if not outInspect then turtle.select(originalSlot); return false, sideError end
  local outCheck = (outputSide == "top" and "top") or (outputSide == "bottom" and "bottom") or "front"
  if not inventoryPresent(outCheck, outInspect) then
    restoreSideDirection(outputSide, outRestore)
    turtle.select(originalSlot)
    return false, "Output inventory missing on configured side " .. outputSide .. "."
  end

  local policy, mode = discardPolicy()
  local discardStats = discardStatsTable()
  discardStats.lastError = nil
  local _, emptySlots = inventoryStats()
  local trigger = tonumber(policy.triggerEmptySlots) or 3
  local discardEnabled = mode ~= "KEEP_ALL" and emptySlots <= trigger
  local discardSide = policy.direction or "back"
  if discardSide == "up" then discardSide = "top" end
  if discardSide == "down" then discardSide = "bottom" end
  local outputTargetDir = sideTargetDirection(outRestore, outputSide)
  local discardTargetDir = sideTargetDirection(outRestore, discardSide)
  local discardInspect, _, discardDrop, discardRestore
  local discardReady, discardError = true, nil
  if discardEnabled and discardSide ~= outputSide then
    discardInspect, _, discardDrop, discardRestore, discardError = sideFunctions(discardSide)
    if not discardInspect then discardReady = false end
    local checkSide = (discardSide == "top" and "top") or (discardSide == "bottom" and "bottom") or "front"
    if discardReady and not inventoryPresent(checkSide, discardInspect) then
      discardReady, discardError = false, "Discard inventory missing on configured side " .. tostring(discardSide) .. "."
    end
  elseif discardEnabled then
    discardInspect, discardDrop, discardRestore = outInspect, outDrop, outRestore
  end
  if discardEnabled and not discardReady then
    restoreSideDirection(discardSide, discardRestore or outRestore)
    turtle.select(originalSlot)
    discardStats.lastError = discardError or "Discard inventory verification failed."
    saveState("discard_inventory_error")
    return false, discardStats.lastError
  end

  -- Consolidate locally before output.  This does not move the turtle and is
  -- deliberately independent of compactEvery service returns.
  compressSealStacks()
  local retainedCount = updateRecycleInventoryState()
  local maxStacks = math.max(1, math.floor(tonumber(policy.maxStacksPerPass) or 8))
  local discardedStacks, allDropped = 0, true
  local totalSeal = retainedCount

  -- Retain only the configured seal/torch targets plus fuel/generic reserve
  -- slots.  The previous implementation retained every seal and torch stack,
  -- so unloading often freed no slots and immediately triggered another trip.
  local keepCounts = homeRetainCounts()
  for slot = 1, 16 do
    local count, name = turtle.getItemCount(slot), itemName(slot)
    if count > 0 then
      local keepCount = math.min(count, tonumber(keepCounts[slot]) or 0)
      local removable = count - keepCount
      local candidate = discardEnabled and discardedStacks < maxStacks
        and removable > 0 and discardCandidate(slot, name, totalSeal, policy, mode)
      if candidate and isSealItemName(name) then
        removable = math.min(removable, math.max(0, totalSeal - (tonumber(policy.retainSealTarget) or 64)))
        if removable <= 0 then candidate = false end
      end
      if candidate and discardDrop and removable > 0 then
        if discardTargetDir ~= nil then turnTo(discardTargetDir) else turnTo(outRestore) end
        turtle.select(slot)
        discardStats.attempts = (discardStats.attempts or 0) + 1
        local before = turtle.getItemCount(slot)
        local prepared, prepareError = beginPhysicalAction("discard_home", {
          slot = slot, item = name, count = removable, direction = discardSide,
        }, poseCopy())
        if not prepared then
          allDropped = false
          discardStats.lastError = prepareError or "Could not journal discard action."
          break
        end
        local dropped = discardDrop(removable)
        local after = turtle.getItemCount(slot)
        local removed = before - after
        if dropped and removed > 0 then
          commitPhysicalAction()
          discardedStacks = discardedStacks + 1
          noteDiscard(name, removed)
          if isSealItemName(name) then totalSeal = totalSeal - removed end
          if removed < removable then allDropped = false end
        else
          cancelPhysicalAction()
          allDropped = false
          noteDiscardSkip(name, isUnknownModItem(name))
        end
      elseif removable > 0 then
        if outputTargetDir ~= nil then turnTo(outputTargetDir) else turnTo(outRestore) end
        turtle.select(slot)
        local before = turtle.getItemCount(slot)
        local prepared, prepareError = beginPhysicalAction("unload_home", {
          slot = slot, item = name, count = removable, direction = outputSide,
        }, poseCopy())
        if not prepared then
          allDropped = false
          discardStats.lastError = prepareError or "Could not journal output action."
          break
        end
        local dropped = outDrop(removable)
        local removed = before - turtle.getItemCount(slot)
        if dropped and removed > 0 then commitPhysicalAction(); if removed < removable then allDropped = false end
        else cancelPhysicalAction(); allDropped = false end
      end
    end
  end
  discardStats.passes = (discardStats.passes or 0) + (discardEnabled and 1 or 0)
  discardStats.enabled = mode ~= "KEEP_ALL"
  discardStats.triggered = discardEnabled
  discardStats.mode = mode
  local _, _, heldItems = inventoryStats()
  discardStats.held = heldItems
  if discardEnabled then discardStats.lastError = nil end

  local restored, restoreError = turnTo(outRestore)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  if not allDropped then
    return false, "Output/discard inventory is full or a protected stack could not be retained safely."
  end
  updateRecycleInventoryState()
  state.stats.unloads = (state.stats.unloads or 0) + 1
  saveState("unload_done")
  return true
end

local function discardAtField()
  local policy, mode = discardPolicy()
  if mode == "KEEP_ALL" then return true end
  local _, emptySlots = inventoryStats()
  local trigger = tonumber(policy.triggerEmptySlots) or 3
  if emptySlots > trigger then return true end

  local discardStats = discardStatsTable()
  discardStats.lastError = nil
  local side = policy.direction or "back"
  if side == "up" then side = "top" end
  if side == "down" then side = "bottom" end
  local originalSlot = turtle.getSelectedSlot()
  local inspectFunction, _, dropFunction, restoreDir, sideError = sideFunctions(side)
  if not inspectFunction then
    discardStats.lastError = sideError or "Discard direction is invalid."
    turtle.select(originalSlot)
    return false, discardStats.lastError
  end
  local checkSide = (side == "top" and "top") or (side == "bottom" and "bottom") or "front"
  -- A configured inventory at the field direction is an explicit safety
  -- boundary: never accidentally inject a discard stack into it.
  if inventoryPresent(checkSide, inspectFunction) then
    discardStats.skipped = (discardStats.skipped or 0) + 1
    discardStats.lastError = "Field discard skipped because the configured direction contains an inventory."
    state.stats.discardSkipped = (state.stats.discardSkipped or 0) + 1
    restoreSideDirection(side, restoreDir)
    turtle.select(originalSlot)
    saveState("field_discard_inventory")
    return true
  end

  local _, _, totalItems = inventoryStats()
  local totalSeal = updateRecycleInventoryState()
  local maxStacks = math.max(1, math.floor(tonumber(policy.maxStacksPerPass) or 8))
  local discardedStacks = 0
  for slot = 1, 16 do
    if discardedStacks >= maxStacks then break end
    local count, name = turtle.getItemCount(slot), itemName(slot)
    if count > 0 and discardCandidate(slot, name, totalSeal, policy, mode)
      and not (isSealItemName(name) and totalSeal - count < (tonumber(policy.retainSealTarget) or 64)) then
      turtle.select(slot)
      discardStats.attempts = (discardStats.attempts or 0) + 1
      local before = turtle.getItemCount(slot)
      local prepared, prepareError = beginPhysicalAction("discard_field", {
        slot = slot, item = name, count = before, direction = side,
      }, poseCopy())
      if not prepared then
        discardStats.lastError = prepareError or "Could not journal field discard action."
        break
      end
      local dropped = dropFunction() -- world discard is always stack-at-a-time
      local after = turtle.getItemCount(slot)
      if dropped and after == 0 then
        commitPhysicalAction()
        discardedStacks = discardedStacks + 1
        noteDiscard(name, before)
        if isSealItemName(name) then totalSeal = totalSeal - before end
      else
        cancelPhysicalAction()
        noteDiscardSkip(name, isUnknownModItem(name))
        discardStats.lastError = "Field discard failed; stack retained."
      end
    end
  end
  discardStats.passes = (discardStats.passes or 0) + 1
  discardStats.enabled = true
  discardStats.mode = mode
  discardStats.lastAt = common.nowSeconds()
  discardStats.lastInventoryItems = totalItems
  restoreSideDirection(side, restoreDir)
  turtle.select(originalSlot)
  saveState("field_discard")
  return discardStats.lastError == nil, discardStats.lastError
end

local function targetFuelForService()
  local target = tonumber(config.fuelTarget) or 12000
  if state.service and state.service.resumeAfter and state.checkpoint then
    local checkpointDistance = estimatedReturnDistance(state.checkpoint)
    if not checkpointDistance then
      checkpointDistance = distance({ x = 0, y = 0, z = 0 }, state.checkpoint)
    end
    target = math.max(target, checkpointDistance * 2 + profileFuelBuffer())
  end
  local limit = fuelLimit()
  if limit == "unlimited" then return "unlimited" end
  if type(limit) == "number" and limit > 0 then target = math.min(target, limit) end
  return math.max(1, math.floor(target))
end

local function refuelAtHome()
  state.phase, state.status = "refueling", "working"
  saveState()
  local current = fuelLevel()
  if current == "unlimited" then return true end
  local target = targetFuelForService()
  local fuelSide = config.fuelSide or "top"
  local inspectFunction, suckFunction, dropFunction, restoreDir, sideError = sideFunctions(fuelSide)
  if not inspectFunction then return false, sideError end
  local checkSide = (fuelSide == "top" and "top") or (fuelSide == "bottom" and "bottom") or "front"
  if not inventoryPresent(checkSide, inspectFunction) then
    restoreSideDirection(fuelSide, restoreDir)
    return false, "Fuel inventory missing on configured side " .. fuelSide .. "."
  end
  if target == "unlimited" or current >= target then
    restoreSideDirection(fuelSide, restoreDir)
    return true
  end

  local originalSlot = turtle.getSelectedSlot()
  local attempts = 0
  while fuelLevel() ~= "unlimited" and fuelLevel() < target do
    drainNetwork(3)
    if movementInterrupted("service") then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "control_request"
    end
    attempts = attempts + 1
    if attempts > 1024 then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel loading safety limit reached."
    end
    local slot = firstFuelSlot()
    if not slot then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "No empty slot available while refueling."
    end
    turtle.select(slot)
    local sucked = runInventoryPhysicalAction("refuel_suck", {
      slot = slot, count = 1, direction = fuelSide,
    }, function() return suckFunction(1) end)
    if not sucked then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel inventory is empty."
    end
    local validFuel = runInventoryPhysicalAction("refuel_probe", {
      slot = slot, count = turtle.getItemCount(slot), direction = fuelSide,
    }, function() return turtle.refuel(0) end)
    if not validFuel then
      runInventoryPhysicalAction("refuel_reject", {
        slot = slot, item = itemName(slot), direction = fuelSide,
      }, dropFunction)
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel inventory contains a non-fuel item."
    end
    local before = fuelLevel()
    local consumed = runInventoryPhysicalAction("refuel_consume", {
      slot = slot, item = itemName(slot), direction = fuelSide,
    }, function() return turtle.refuel(1) end)
    local after = fuelLevel()
    if not consumed then
      runInventoryPhysicalAction("refuel_reject", {
        slot = slot, item = itemName(slot), direction = fuelSide,
      }, dropFunction)
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Turtle refused the selected fuel item."
    end
    if turtle.getItemCount(slot) > 0 then
      runInventoryPhysicalAction("refuel_excess", {
        slot = slot, item = itemName(slot), direction = fuelSide,
      }, dropFunction)
    end
    if type(before) == "number" and type(after) == "number" and after > before then
      state.stats.refuels = (state.stats.refuels or 0) + 1
    end
  end
  local restored, restoreError = restoreSideDirection(fuelSide, restoreDir)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  saveState()
  return true
end

local function refillSlotForSeal()
  local materials, recycle = materialsConfig()
  local preferred = materials.sealSlots or recycle.sealSlots or config.sealSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) > 0 and isSealItemName(itemName(slot)) and turtle.getItemSpace(slot) > 0 then return slot end
    end
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) == 0 then return slot end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "seal") and isSealItemName(itemName(slot)) and turtle.getItemSpace(slot) > 0 then return slot end
  end
  for slot = 1, 16 do if not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) == 0 then return slot end end
  return nil
end

local function refillSealAtHome()
  if (config.lavaMode or "seal") ~= "seal" then return true end
  state.phase, state.status = "refilling_seal", "working"
  saveState()
  local target = math.max(1, tonumber(config.sealTarget) or 64)
  local materials, recycle = materialsConfig()
  target = math.max(1, tonumber(materials.retainSealTarget or recycle.maxHeld or config.retainSealTarget) or target)
  compressSealStacks()
  updateRecycleInventoryState()
  if sealMaterialCount() >= target then return true end
  local side = config.sealSide or "right"
  local inspectFunction, suckFunction, dropFunction, restoreDir, sideError = sideFunctions(side)
  if not inspectFunction then return false, sideError end
  local checkSide = (side == "top" and "top") or (side == "bottom" and "bottom") or "front"
  if not inventoryPresent(checkSide, inspectFunction) then
    restoreSideDirection(side, restoreDir)
    return false, "Lava-seal block inventory missing on configured side " .. side .. "."
  end

  local originalSlot = turtle.getSelectedSlot()
  local attempts = 0
  while sealMaterialCount() < target do
    drainNetwork(3)
    if movementInterrupted("service") then
      restoreSideDirection(side, restoreDir)
      turtle.select(originalSlot)
      return false, "control_request"
    end
    attempts = attempts + 1
    if attempts > 64 then
      restoreSideDirection(side, restoreDir)
      turtle.select(originalSlot)
