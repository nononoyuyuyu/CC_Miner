-- CC Miner V3 - autonomous quarry worker
-- Home=(0,0,0), forward=+Z, right=+X, down=-Y.

local common = dofile("/ccminer/lib/common.lua")
local protocol = dofile("/ccminer/lib/protocol.lua")
local quarry = dofile("/ccminer/lib/quarry.lua")
local geo = dofile("/ccminer/lib/geo.lua")

if not turtle then error("worker.lua must run on a turtle", 0) end

local config, configError = common.loadConfig()
if not config or config.role ~= "worker" then
  error(configError or "Worker configuration not found. Run: ccm setup worker", 0)
end

-- Accept both the V3 nested defaults and older flat V2 settings.  This is
-- intentionally in-memory so an old config remains readable by V2 tooling.
config.materials = config.materials or {}
config.lighting = config.lighting or {}
config.water = config.water or {}
config.journal = config.journal or {}
if config.lighting.mode == nil then config.lighting.mode = config.lightMode or "off" end
if config.lighting.interval == nil then config.lighting.interval = config.torchInterval or 32 end
if config.lighting.preferredSlots == nil then config.lighting.preferredSlots = config.torchSlots end
if config.lighting.torchBlocks == nil then config.lighting.torchBlocks = config.torchBlocks end
if type(config.lighting.torchBlocks) == "table" and #config.lighting.torchBlocks > 0 then
  local allowed = {}
  for _, name in ipairs(config.lighting.torchBlocks) do allowed[tostring(name)] = true end
  config.lighting.torchBlocks = allowed
end
if config.materials.sealSlots == nil then config.materials.sealSlots = config.sealSlots end
if config.materials.torchSlots == nil then config.materials.torchSlots = config.torchSlots end
if config.materials.recycleMinedBlocks == nil then config.materials.recycleMinedBlocks = true end
if config.materials.retainSealTarget == nil then config.materials.retainSealTarget = config.retainSealTarget or config.sealTarget end
if config.water.mode == nil then config.water.mode = config.waterMode or "ignore" end
if config.journal.enabled == nil then config.journal.enabled = true end

local rawState, stateError = common.loadTable(common.STATE_PATH, common.defaultState())
local state = common.merge(common.defaultState(), rawState)
-- The atomic state file is authoritative.  A malformed state must never be
-- treated as an empty job (which could cause an unsafe duplicate dig).
if stateError then
  state.status = "blocked"
  state.phase = "state_corrupt"
  state.lastError = tostring(stateError)
  common.log("ERROR", stateError)
end

local function ensureV3State()
  state.stats = state.stats or {}
  local counters = {
    torchesPlaced = 0, torchRefills = 0, torchShortages = 0,
    waterDetected = 0, waterSealed = 0, waterBlocked = 0,
    recycled = 0, sealOverflow = 0, compressions = 0,
    serviceReturns = 0, journalWrites = 0,
  }
  for key, value in pairs(counters) do
    if state.stats[key] == nil then state.stats[key] = value end
  end
  state.lighting = state.lighting or {
    mode = "off", interval = 32, lastAt = nil, lastPose = nil,
    placed = 0, shortages = 0,
  }
  state.water = state.water or {
    mode = "ignore", detected = 0, sealed = 0, blocked = 0,
    last = nil,
  }
  state.recycle = state.recycle or {
    enabled = true, held = 0, cap = 64, overflow = 0,
    compressed = 0, byName = {},
  }
  state.fluidSealRun = tonumber(state.fluidSealRun) or 0
  state.fluidSealMarker = state.fluidSealMarker or nil
  if state.stagedStop == nil then state.stagedStop = false end
  state.report = state.report or nil
  state.estimate = state.estimate or { estimated = 0, actual = 0, variance = 0 }
  state.journal = state.journal or { seq = 0, writes = 0, checkpoints = 0 }
end
ensureV3State()

local lastHeartbeat = 0
local networkReady = false
local pollNetwork

local function appendJournal(event)
  -- Journal is deliberately auxiliary: the atomic state remains the source
  -- of truth.  If a filesystem implementation cannot append, continue with
  -- the state save and expose the warning through the normal log.
  local journalConfig = config.journal or {}
  if journalConfig.enabled == false then return true end
  local path = journalConfig.path or "/ccminer/data/state.journal"
  local maxEntries = math.max(1, tonumber(journalConfig.maxEntries) or 256)
  if not fs or not fs.open then return false end
  if common.ensureDir then common.ensureDir(fs.getDir(path)) end
  state.journal = state.journal or {}
  local entries = tonumber(state.journal.entries) or 0
  if entries >= maxEntries and fs.exists(path) then
    local old = path .. ".1"
    local rotated = pcall(function()
      if fs.exists(old) then fs.delete(old) end
      fs.move(path, old)
    end)
    if rotated then entries = 0; state.journal.entries = 0 end
  end
  local handle = fs.open(path, "a")
  if not handle then return false end
  state.journal.seq = (tonumber(state.journal.seq) or 0) + 1
  state.journal.writes = (tonumber(state.journal.writes) or 0) + 1
  state.journal.entries = entries + 1
  local entry = {
    seq = state.journal.seq,
    at = common.nowSeconds(),
    event = tostring(event or "state"),
    status = state.status,
    phase = state.phase,
    pose = {
      x = tonumber(state.pose and state.pose.x) or 0,
      y = tonumber(state.pose and state.pose.y) or 0,
      z = tonumber(state.pose and state.pose.z) or 0,
      dir = (tonumber(state.pose and state.pose.dir) or 0) % 4,
    },
    cursor = state.job and state.job.cursor or nil,
  }
  local ok, serialized = pcall(textutils.serialize, entry)
  if ok then handle.writeLine(serialized) end
  handle.close()
  if not ok then return false end
  -- Keep the audit file bounded without making it authoritative.  This is a
  -- best-effort rotation; failure is intentionally non-fatal.
  if fs.getSize and fs.getSize(path) > 131072 then
    local old = path .. ".1"
    pcall(function()
      if fs.exists(old) then fs.delete(old) end
      fs.move(path, old)
      state.journal.entries = 0
    end)
  end
  if state.stats then state.stats.journalWrites = (state.stats.journalWrites or 0) + 1 end
  return true
end

local function saveJournalCheckpoint()
  local journalConfig = config.journal or {}
  if journalConfig.enabled == false then return true end
  local every = math.max(1, tonumber(journalConfig.checkpointEvery) or 32)
  state.journal = state.journal or {}
  local writes = tonumber(state.journal.writes) or 0
  if writes == 0 or writes % every ~= 0 then return true end
  local path = journalConfig.checkpointPath or "/ccminer/data/state.checkpoint.db"
  local ok, err = common.saveTable(path, state)
  if ok then state.journal.checkpoints = (tonumber(state.journal.checkpoints) or 0) + 1 end
  return ok, err
end

local function saveState(reason)
  if state.estimate and state.job then
    state.estimate.actual = tonumber(state.job.cursor) or 0
    state.estimate.variance = state.estimate.actual - (tonumber(state.estimate.estimated) or state.estimate.actual)
  end
  state.schema = common.SCHEMA
  state.version = common.VERSION
  state.updatedAt = common.nowSeconds()
  local ok, err = common.saveTable(common.STATE_PATH, state)
  if not ok then
    common.log("ERROR", "State save failed: " .. tostring(err))
    error("State save failed: " .. tostring(err), 0)
  end
  if not appendJournal(reason) then
    common.log("WARN", "State journal append failed; atomic state remains authoritative.")
  end
  saveJournalCheckpoint()
end

local function poseCopy(pose)
  pose = pose or state.pose or {}
  return {
    x = tonumber(pose.x) or 0,
    y = tonumber(pose.y) or 0,
    z = tonumber(pose.z) or 0,
    dir = (tonumber(pose.dir) or 0) % 4,
  }
end

local function samePosePosition(a, b)
  return tonumber(a and a.x) == tonumber(b and b.x)
    and tonumber(a and a.y) == tonumber(b and b.y)
    and tonumber(a and a.z) == tonumber(b and b.z)
end

local function beginPhysicalAction(kind, details, poseAfter)
  if state.pendingAction then
    return false, "An unresolved physical action is already recorded. Rehome the turtle before continuing."
  end
  state.pendingAction = {
    kind = tostring(kind or "unknown"),
    poseBefore = poseCopy(),
    poseAfter = poseAfter and poseCopy(poseAfter) or nil,
    details = details or {},
    startedAt = common.nowSeconds(),
  }
  saveState()
  return true
end

local function cancelPhysicalAction()
  state.pendingAction = nil
  saveState()
end

local function commitPhysicalAction()
  state.pendingAction = nil
  saveState()
end

local function isHome()
  return state.pose.x == 0 and state.pose.y == 0 and state.pose.z == 0
end

local function distance(a, b)
  a, b = a or state.pose, b or { x = 0, y = 0, z = 0 }
  return math.abs((a.x or 0) - (b.x or 0))
    + math.abs((a.y or 0) - (b.y or 0))
    + math.abs((a.z or 0) - (b.z or 0))
end

local function inventoryStats()
  local used, empty, items = 0, 0, 0
  for slot = 1, 16 do
    local count = turtle.getItemCount(slot)
    if count > 0 then used, items = used + 1, items + count else empty = empty + 1 end
  end
  return used, empty, items
end

local function fuelLevel()
  local ok, level = pcall(turtle.getFuelLevel)
  if not ok then return 0 end
  return level
end

local function fuelLimit()
  local ok, limit = pcall(turtle.getFuelLimit)
  if not ok then return 0 end
  return limit
end

local function itemName(slot)
  if turtle.getItemCount(slot) <= 0 then return nil end
  local ok, detail = pcall(turtle.getItemDetail, slot)
  if not ok or type(detail) ~= "table" then return nil end
  return detail.name
end

local function isSealItemName(name)
  return name and config.sealBlocks and config.sealBlocks[name] == true
end

local function materialsConfig()
  local materials = config.materials or {}
  local recycle = config.recycle or {}
  return materials, recycle
end

-- Profiles adjust operating margins and cadence only.  Job-level settings for
-- safety modes (lighting/water) remain authoritative elsewhere in the worker.
-- Keep an invalid legacy config from silently selecting a more aggressive
-- profile; balanced is the neutral, backward-compatible fallback.
local function effectiveProfile()
  local profile = state.job and state.job.profile or config.profile or "balanced"
  profile = tostring(profile)
  if profile ~= "safe" and profile ~= "balanced" and profile ~= "turbo" then
    profile = "balanced"
  end
  return profile
end

local function profileReserveEmptySlots()
  local materials = config.materials or {}
  local base = math.max(0, math.floor(tonumber(materials.reserveEmptySlots or config.reserveEmptySlots) or 3))
  local profile = effectiveProfile()
  if profile == "safe" then return math.min(8, base + 2) end
  if profile == "turbo" then return math.max(1, base - 1) end
  return base
end

local function profileFuelBuffer()
  local base = math.max(0, tonumber(config.fuelBuffer) or 256)
  if effectiveProfile() == "safe" then return math.ceil(base * 1.5) end
  -- Turbo may not reduce the configured fuel safety margin.  There is no
  -- speed-up worth weakening the return-home guarantee, so retain base.
  return base
end

local function profileCompactEvery()
  local materials = config.materials or {}
  local base = math.max(0, math.floor(tonumber(materials.compactEveryMoves or config.compactEveryMoves) or 32))
  local profile = effectiveProfile()
  if profile == "safe" then return math.min(base, 16) end
  if profile == "turbo" then return math.max(base, 64) end
  return base
end

local function profileMaxContinuousSeal()
  local base = math.max(1, math.floor(tonumber(
    config.maxContinuousSeal or config.fluidSealLimit or config.waterSealLimit
  ) or 8))
  local profile = effectiveProfile()
  -- maxContinuousSeal is a user-configured absolute ceiling.  A profile can
  -- only tighten it (safe) or use a larger documented cap when configured
  -- (turbo); it must never raise a default 32 to 64 implicitly.
  if profile == "safe" then return math.min(base, 8) end
  if profile == "turbo" then return math.min(base, 64) end
  return math.min(base, 32)
end

local function profileLightingInterval(requested)
  requested = math.max(1, math.floor(tonumber(requested) or 32))
  local profile = effectiveProfile()
  if profile == "safe" then return math.min(requested, 8) end
  if profile == "turbo" then return math.min(12, math.max(requested, 12)) end
  return requested
end

-- Shared by status reporting and the movement implementation so the
-- controller sees the same explicit mode and profile-adjusted cadence that
-- physical placement will use.
local function effectiveLightingValues()
  local lighting = config.lighting or {}
  local mode = state.job and state.job.lighting and state.job.lighting.mode or nil
  mode = mode or state.lighting.mode or lighting.mode or config.lightMode or "off"
  if mode ~= "off" and mode ~= "safe" and mode ~= "custom" then mode = "off" end
  local requested = state.job and state.job.lighting and state.job.lighting.interval or nil
  requested = tonumber(requested or state.lighting.interval or lighting.interval or config.torchInterval) or 32
  return mode, profileLightingInterval(requested)
end

local function lightingConfig()
  local lighting = config.lighting or {}
  local mode = lighting.mode or config.lightMode or "off"
  if mode ~= "off" and mode ~= "safe" and mode ~= "custom" then mode = "off" end
  local interval = tonumber(lighting.interval or config.torchInterval) or 32
  return lighting, mode, math.max(1, math.floor(interval))
end

local function torchBlocks()
  local lighting = config.lighting or {}
  local blocks = lighting.torchBlocks or config.torchBlocks or {
    ["minecraft:torch"] = true,
    ["minecraft:soul_torch"] = true,
  }
  return blocks
end

local function isTorchItemName(name)
  return name and torchBlocks()[name] == true
end

local function slotSet(value)
  local result = {}
  if type(value) ~= "table" then return result end
  -- Lists such as {13,14} store slots in values; maps such as {[13]=true}
  -- store them in keys.  Accept both forms for old and new configurations.
  for key, item in pairs(value) do
    local numberItem, numberKey = tonumber(item), tonumber(key)
    if type(item) == "boolean" then
      if item and numberKey then result[math.floor(numberKey)] = true end
    elseif numberItem then
      result[math.floor(numberItem)] = true
    elseif numberKey then
      result[math.floor(numberKey)] = true
    end
  end
  return result
end

local function materialSlotSets()
  local materials, recycle = materialsConfig()
  local sets = {
    generic = slotSet(materials.reservedSlots or recycle.reservedSlots or config.reservedSlots),
    seal = slotSet(materials.sealSlots or config.sealSlots),
    torch = slotSet(materials.torchSlots or config.torchSlots),
    fuel = slotSet(materials.fuelReserveSlots or config.fuelReserveSlots),
  }
  return sets
end

local function isReservedSlot(slot, role)
  local sets = materialSlotSets()
  local number = tonumber(slot) or 0
  if sets.generic[number] then return true end
  if role == "seal" then return sets.torch[number] or sets.fuel[number] end
  if role == "torch" then return sets.seal[number] or sets.fuel[number] end
  if role == "fuel" then return sets.seal[number] or sets.torch[number] end
  if role == "generic" or role == nil then
    return sets.seal[number] or sets.torch[number] or sets.fuel[number]
  end
  return false
end

local function slotRoleContains(slot, role)
  local sets = materialSlotSets()
  return sets[role] and sets[role][tonumber(slot) or 0] == true
end

local function isFuelItem(slot)
  if not slot or turtle.getItemCount(slot) <= 0 or type(turtle.refuel) ~= "function" then return false end
  local original = turtle.getSelectedSlot()
  turtle.select(slot)
  local ok, result = pcall(turtle.refuel, 0)
  turtle.select(original)
  return ok and result == true
end

local function sealMaterialCount()
  local count = 0
  for slot = 1, 16 do
    if isSealItemName(itemName(slot)) then count = count + turtle.getItemCount(slot) end
  end
  return count
end

local function selectSealMaterial()
  local materials = materialsConfig()
  local preferred = materials.sealSlots or (config.recycle and config.recycle.sealSlots) or config.sealSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) > 0 and isSealItemName(itemName(slot)) then
        turtle.select(slot)
        return slot
      end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "seal") and isSealItemName(itemName(slot)) and turtle.getItemCount(slot) > 0 then
      turtle.select(slot)
      return slot
    end
  end
  return nil
end

local function torchMaterialCount()
  local count = 0
  for slot = 1, 16 do
    if isTorchItemName(itemName(slot)) then count = count + turtle.getItemCount(slot) end
  end
  return count
end

local function preferredTorchSlots()
  local materials = materialsConfig()
  local lighting = config.lighting or {}
  local configured = lighting.preferredSlots or materials.torchSlots or config.torchSlots
  local result, seen = {}, {}
  if lighting.slot and tonumber(lighting.slot) then
    local slot = math.floor(tonumber(lighting.slot))
    result[#result + 1], seen[slot] = slot, true
  end
  if type(configured) == "table" then
    for _, candidate in ipairs(configured) do
      local slot = tonumber(candidate)
      if slot and not seen[math.floor(slot)] then
        slot = math.floor(slot)
        result[#result + 1], seen[slot] = slot, true
      end
    end
  end
  return result
end

local function selectTorchMaterial()
  local preferred = preferredTorchSlots()
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "torch") and turtle.getItemCount(slot) > 0 and isTorchItemName(itemName(slot)) then
        turtle.select(slot)
        return slot
      end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "torch") and turtle.getItemCount(slot) > 0 and isTorchItemName(itemName(slot)) then
      turtle.select(slot)
      return slot
    end
  end
  return nil
end

local function gpsConfig()
  config.gps = config.gps or {}
  return config.gps
end

local function gpsCalibration()
  local gpsSettings = gpsConfig()
  if geo.validCalibration(gpsSettings.calibration) then return gpsSettings.calibration end
  return nil
end

local function gpsSummary()
  local calibration = gpsCalibration()
  return {
    enabled = gpsConfig().enabled ~= false,
    required = gpsConfig().required == true,
    available = state.gps and state.gps.available == true,
    calibrated = calibration ~= nil,
    calibration = calibration and common.copy(calibration) or nil,
    lastFix = state.gps and common.copy(state.gps.lastFix) or nil,
    lastFixAt = state.gps and state.gps.lastFixAt or nil,
    lastError = state.gps and state.gps.lastError or nil,
    corrections = state.gps and state.gps.corrections or 0,
  }
end

local function jobSnapshot()
  if not state.job then return nil end
  local route = state.job.route
  local layer, row, currentChunk
  if state.job.strategy == "chunk_plan" and route then
    layer = (tonumber(route.layer) or 0) + 1
    currentChunk = route.currentKey
  else
    local cursor = tonumber(state.job.cursor) or 0
    local rowWidth = math.max(1, tonumber(state.job.length) or 1)
    local rowVolume = rowWidth * math.max(1, tonumber(state.job.width) or 1)
    layer = math.floor(cursor / rowVolume) + 1
    row = math.floor((cursor % rowVolume) / rowWidth) + 1
  end
  return {
    id = state.job.id,
    assignmentId = state.job.assignmentId,
    profile = state.job.profile,
    name = state.job.name,
    kind = state.job.kind,
    strategy = state.job.strategy,
    width = state.job.width,
    length = state.job.length,
    depth = state.job.depth,
    targetY = state.job.targetY,
    cursor = state.job.cursor or 0,
    total = state.job.total or 0,
    percent = common.percent(state.job.cursor or 0, state.job.total or 0),
    startedAt = state.job.startedAt,
    chunkMode = state.job.chunkMode,
    excludedChunks = state.job.excludedChunks and #state.job.excludedChunks or 0,
    currentLayer = layer,
    currentRow = row,
    currentChunk = currentChunk,
    completedChunks = state.job.completedChunks or 0,
    assignmentChunks = state.job.assignmentChunks and #state.job.assignmentChunks or 0,
  }
end

local function statusPayload()
  local used, empty, items = inventoryStats()
  local profile = effectiveProfile()
  local progress = nil
  if state.job then
    local snap = jobSnapshot()
    progress = {
      cursor = state.job.cursor or 0,
      total = state.job.total or 0,
      percent = common.percent(state.job.cursor or 0, state.job.total or 0),
      layer = snap and snap.currentLayer or nil,
      row = snap and snap.currentRow or nil,
      currentChunk = snap and snap.currentChunk or nil,
      completedChunks = snap and snap.completedChunks or 0,
    }
  end
  local lightMode, lightInterval = effectiveLightingValues()
  local waterMode = tostring((config.waterMode or (config.water and config.water.mode) or state.water.mode or "ignore"))
  return {
    id = os.getComputerID(),
    label = config.workerName or common.safeComputerLabel("Miner"),
    status = state.status,
    phase = state.phase,
    pose = poseCopy(),
    atHome = isHome(),
    world = state.gps and common.copy(state.gps.lastFix) or nil,
    gps = gpsSummary(),
    seal = {
      mode = config.lavaMode or "seal",
      count = sealMaterialCount(),
      target = tonumber((config.materials or {}).retainSealTarget or config.sealTarget) or 64,
      reserve = tonumber(config.sealReserve) or 8,
    },
    lighting = {
      mode = lightMode,
      interval = lightInterval,
      torchCount = torchMaterialCount(),
      placed = state.stats.torchesPlaced or 0,
      shortages = state.stats.torchShortages or 0,
    },
    profile = profile,
    effectiveProfile = profile,
    water = {
      mode = waterMode,
      detected = state.stats.waterDetected or 0,
      sealed = state.stats.waterSealed or 0,
      blocked = state.stats.waterBlocked or 0,
      last = state.water and common.copy(state.water.last) or nil,
    },
    materials = {
      torchCount = torchMaterialCount(),
      sealCount = sealMaterialCount(),
      recycled = state.stats.recycledBlocks or state.stats.recycled or 0,
      retained = state.recycle and state.recycle.held or 0,
      overflow = state.recycle and state.recycle.overflow or 0,
    },
    stagedStop = state.stagedStop == false and false or (state.stagedStop and common.copy(state.stagedStop) or nil),
    progress = progress,
    report = state.report and common.copy(state.report) or nil,
    lastReport = state.report and common.copy(state.report) or state.lastReport,
    jobReport = state.jobReport and common.copy(state.jobReport) or nil,
    estimate = state.estimate and common.copy(state.estimate) or nil,
    capabilities = {
      gps = true,
      gpsCalibration = true,
      lavaSeal = true,
      chunkExclusions = true,
      worldPartition = false,
      localPartition = false,
      touchController = true,
      lighting = true,
      waterHandling = true,
      materialRecycle = true,
      stagedStop = true,
      stateJournal = true,
      completionReport = true,
    },
    job = jobSnapshot(),
    fuel = fuelLevel(),
    fuelLimit = fuelLimit(),
    inventoryUsed = used,
    inventoryEmpty = empty,
    inventoryItems = items,
    lastError = state.lastError,
    completionReason = state.completionReason,
    recoveryRequired = state.pendingAction ~= nil,
    pendingAction = state.pendingAction and {
      kind = state.pendingAction.kind,
      startedAt = state.pendingAction.startedAt,
    } or nil,
    request = state.request,
    stats = common.copy(state.stats),
    version = common.VERSION,
    updatedAt = state.updatedAt,
  }
end

local function sendStatus(target, request)
  if not networkReady then return false end
  local message = protocol.message("status", config.networkKey, statusPayload(), target)
  if request and request.id then message.replyTo = request.id end
  if target then return protocol.send(target, message) end
  return protocol.broadcast(message)
end

local function sendAck(target, request, ok, text)
  return protocol.reply(target, config.networkKey, request, "ack", {
    ok = ok == true,
    message = tostring(text or ""),
    status = statusPayload(),
  })
end

local function markBlocked(message)
  state.status = "blocked"
  state.phase = state.pendingAction and "recovery_required" or "blocked"
  state.lastError = tostring(message or "Unknown error")
  common.log("ERROR", state.lastError)
  saveState()
  sendStatus()
end

local function commandSeen(id)
  if not id then return false end
  state.recentCommands = state.recentCommands or {}
  for _, existing in ipairs(state.recentCommands) do if existing == id then return true end end
  state.recentCommands[#state.recentCommands + 1] = id
  while #state.recentCommands > 32 do table.remove(state.recentCommands, 1) end
  return false
end

local function locateGPS()
  state.gps = state.gps or common.defaultState().gps
  if gpsConfig().enabled == false then
    state.gps.available = false
    state.gps.lastError = "GPS is disabled in configuration."
    return nil, state.gps.lastError
  end
  if not gps or type(gps.locate) ~= "function" then
    state.gps.available = false
    state.gps.lastError = "GPS API is unavailable."
    return nil, state.gps.lastError
  end
  local ok, x, y, z = pcall(gps.locate, tonumber(gpsConfig().timeout) or 2, false)
  if not ok or x == nil then
    state.gps.available = false
    state.gps.lastError = ok and "No GPS fix received." or tostring(x)
    return nil, state.gps.lastError
  end
  local fix, fixError = geo.integerFix(x, y, z, 0.35)
  if not fix then
    state.gps.available = false
    state.gps.lastError = fixError
    return nil, fixError
  end
  state.gps.available = true
  state.gps.lastFix = fix
  state.gps.lastFixAt = common.nowSeconds()
  state.gps.lastError = nil
  state.stats.gpsFixes = (state.stats.gpsFixes or 0) + 1
  return fix
end

local function verifyGPS(force)
  local calibration = gpsCalibration()
  if not calibration then
    if gpsConfig().required then return false, "GPS is required but the worker is not calibrated." end
    return true
  end
  local interval = math.max(1, tonumber(gpsConfig().verifyEveryMoves) or 16)
  if not force and ((state.stats.moves or 0) % interval ~= 0) then return true end
  local fix, fixError = locateGPS()
  if not fix then
    if gpsConfig().required then return false, "Required GPS fix failed: " .. tostring(fixError) end
    return true
  end
  local expected = geo.localToWorld(calibration, state.pose)
  if not geo.samePosition(fix, expected) then
    return false, ("GPS drift: expected world %d,%d,%d but located %d,%d,%d."):format(
      expected.x, expected.y, expected.z, fix.x, fix.y, fix.z
    )
  end
  return true
end

local function assignmentChunkKey(entry, mode)
  if type(entry) == "string" and entry ~= "" then return entry end
  if type(entry) ~= "table" then return nil end
  if entry.key and tostring(entry.key) ~= "" then return tostring(entry.key) end
  local cx, cz = tonumber(entry.cx), tonumber(entry.cz)
  if cx and cz and cx == math.floor(cx) and cz == math.floor(cz) then
    return quarry.chunkKey(entry.mode == "world" and "world" or mode, cx, cz)
  end
  return nil
end

local function validateJob(payload)
  payload = payload or {}
  local width, length, depth = tonumber(payload.width), tonumber(payload.length), tonumber(payload.depth)
  local targetY = tonumber(payload.targetY)
  local requestedChunkMode = payload.chunkMode == "world" and "world" or "local"
  if targetY ~= nil then
    if targetY ~= math.floor(targetY) then return nil, "targetY must be a whole number." end
    if requestedChunkMode ~= "world" then
      return nil, "targetY requires chunkMode=world with GPS calibration."
    end
    local calibration = gpsCalibration()
    if not calibration then return nil, "targetY requires GPS calibration." end
    local homeY = tonumber(calibration.home and calibration.home.y)
    if not homeY then return nil, "GPS calibration has no home Y coordinate." end
    local derivedDepth = homeY - targetY + 1
    if derivedDepth < 1 or derivedDepth > config.maxDepth then
      return nil, "targetY is outside the configured depth range."
    end
    if depth ~= nil and (depth ~= math.floor(depth) or depth ~= derivedDepth) then
      return nil, "depth must equal the depth derived from targetY."
    end
    depth = derivedDepth
  end
  if not width or width ~= math.floor(width) then return nil, "Width must be a whole number." end
  if not length or length ~= math.floor(length) then return nil, "Length must be a whole number." end
  if not depth or depth ~= math.floor(depth) then return nil, "Depth must be a whole number." end
  if width < 1 or width > config.maxWidth then return nil, "Width out of range (1-" .. config.maxWidth .. ")." end
  if length < 1 or length > config.maxLength then return nil, "Length out of range (1-" .. config.maxLength .. ")." end
  if depth < 1 or depth > config.maxDepth then return nil, "Depth out of range (1-" .. config.maxDepth .. ")." end
  local fullVolume = width * length * depth
  if fullVolume > config.maxVolume then return nil, "Volume exceeds limit " .. tostring(config.maxVolume) .. "." end

  local exclusions = {}
  for _, exclusion in ipairs(payload.excludedChunks or {}) do
    if type(exclusion) == "table" and tonumber(exclusion.cx) and tonumber(exclusion.cz) then
      exclusions[#exclusions + 1] = {
        mode = exclusion.mode == "world" and "world" or "local",
        cx = math.floor(exclusion.cx),
        cz = math.floor(exclusion.cz),
      }
    end
  end
  if #exclusions > 512 then return nil, "Too many excluded chunks." end

  local chunkMode = requestedChunkMode
  if chunkMode == "world" and not gpsCalibration() then
    return nil, "World-aligned chunk exclusion requires GPS calibration."
  end

  if payload.assignmentChunks ~= nil then
    return nil, "Multi-worker chunk partitioning is disabled in this release; dispatch independent jobs."
  end
  local assignmentTotal = tonumber(payload.assignmentTotal or payload.assignmentCount)
  if assignmentTotal and assignmentTotal > 1 then
    return nil, "Multi-worker assignments are disabled in this release; dispatch independent jobs."
  end
  if type(payload.assignment) == "table" and tonumber(payload.assignment.total or payload.assignment.count) and tonumber(payload.assignment.total or payload.assignment.count) > 1 then
    return nil, "Multi-worker assignments are disabled in this release; dispatch independent jobs."
  end

  local profile = payload.profile
  if profile ~= nil then
    profile = tostring(profile)
    if profile ~= "safe" and profile ~= "balanced" and profile ~= "turbo" then
      return nil, "profile must be safe, balanced, or turbo."
    end
  end

  local job = {
    kind = "quarry",
    id = tostring(payload.jobId or ("job-" .. common.nowMillis())),
    name = tostring(payload.name or "Quarry"),
    width = width,
    length = length,
    depth = depth,
    cursor = 0,
    startedAt = common.nowSeconds(),
    excludedChunks = exclusions,
    chunkMode = chunkMode,
    assignmentId = payload.assignmentId and tostring(payload.assignmentId) or nil,
    profile = profile,
    targetY = targetY,
    lighting = type(payload.lighting) == "table" and common.copy(payload.lighting) or nil,
    waterMode = payload.waterMode and tostring(payload.waterMode) or nil,
    assignmentChunks = nil,
    assignmentProvided = false,
  }

  if job.waterMode ~= nil and job.waterMode ~= "ignore" and job.waterMode ~= "stop" and job.waterMode ~= "seal" then
    return nil, "waterMode must be ignore, stop, or seal."
  end
  if job.lighting and job.lighting.mode ~= nil then
    local mode = tostring(job.lighting.mode)
    if mode ~= "off" and mode ~= "safe" and mode ~= "custom" then
      return nil, "lighting.mode must be off, safe, or custom."
    end
    job.lighting.mode = mode
    if job.lighting.interval ~= nil then
      local interval = tonumber(job.lighting.interval)
      if not interval or interval < 1 then return nil, "lighting.interval must be positive." end
      job.lighting.interval = math.floor(interval)
    end
  end

  if #exclusions > 0 then
    local plan, planError = quarry.buildChunkPlan(job, gpsCalibration())
    if not plan then return nil, planError end
    job.strategy = "chunk_plan"
    job.chunkPlan = plan
    job.total = plan.columns * depth
    job.route = { layer = 0, walkIndex = 1, phase = "travel", localCursor = 0 }
  else
    job.strategy = "serpentine"
    job.total = fullVolume
  end
  if job.total <= 0 then return nil, "The exclusion mask leaves no blocks to mine." end
  return job
end

local function startJob(payload)
  payload = payload or {}
  local requestedId = payload.jobId and tostring(payload.jobId) or nil
  if requestedId and state.job and tostring(state.job.id) == requestedId then
    return true, "Job already accepted; existing state retained."
  end
  if state.job and state.status ~= "complete" and state.status ~= "aborted" then
    return false, "An unfinished job already exists; resume, abort, or clear it first."
  end
  if state.pendingAction then return false, "Recovery is required after an interrupted physical action." end
  if not isHome() then return false, "Worker is not at home. Recall or physically recover it first." end
  if tonumber(state.pose and state.pose.dir) ~= 0 then
    return false, "Worker must face the quarry at home before starting a job. Use REHOME after physical recovery."
  end
  if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
    return false, "Worker is busy."
  end
  local job, err = validateJob(payload)
  if not job then return false, err end
  state.job = job
  state.stats.jobsStarted = (state.stats.jobsStarted or 0) + 1
  state.checkpoint = nil
  state.service = {
    resumeAfter = true,
    finalStatus = "working",
    preserveCheckpoint = false,
    reason = "job_start",
    startedAt = common.nowSeconds(),
  }
  state.request = nil
  state.stagedStop = false
  state.status = "working"
  state.phase = "starting_service"
  state.lastError = nil
  state.completionReason = nil
  state.report = nil
  state.estimate = {
    estimated = math.max(1, job.total or 1),
    actual = 0,
    variance = 0,
    startedAt = common.nowSeconds(),
  }
  state.lighting.mode = (job.lighting and job.lighting.mode) or (config.lighting and config.lighting.mode) or "off"
  state.lighting.interval = (job.lighting and job.lighting.interval) or (config.lighting and config.lighting.interval) or 32
  state.water.mode = job.waterMode or config.waterMode or (config.water and config.water.mode) or "ignore"
  state.pose = { x = 0, y = 0, z = 0, dir = state.pose.dir or 0 }
  saveState()
  common.log("INFO", ("Job started: %s %dx%dx%d strategy=%s exclusions=%d"):format(
    job.id, job.width, job.length, job.depth, job.strategy, #job.excludedChunks
  ))
  return true, "Job accepted."
end

local function calibrateGPS()
  if state.pendingAction then return false, "Resolve the pending physical action first." end
  if not isHome() or state.pose.dir ~= 0 then return false, "Place the turtle at home facing the quarry before GPS calibration." end
  if state.job then return false, "Clear the active job before GPS calibration." end
  if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" then
    return false, "Worker must be stopped before GPS calibration."
  end
  if fuelLevel() ~= "unlimited" and tonumber(fuelLevel() or 0) < 2 then return false, "At least 2 fuel is required." end
