-- CC Miner V4 - adaptive touch views.  Every view has a keyboard fallback and
-- uses bounded hitboxes, so a 20x8 monitor remains operable.

local fieldOrder = { "width", "length", "depth", "targetY" }
local fieldLabels = { width = "WIDTH", length = "LENGTH", depth = "DEPTH", targetY = "BOTTOM Y" }
local fieldLimits = { width = 128, length = 512, depth = 128, targetY = 32000 }

local function currentFieldOrder()
  if draft and draftCalibration() then return { "width", "length", "targetY" } end
  return { "width", "length", "depth" }
end

-- Group dimensions intentionally use a separate draft.  The single-worker
-- `draft` remains untouched so an operator can leave GROUPS and resume a
-- queued/legacy job without losing its inputs.
local function groupDraftWorldMode()
  return groupDraft and tostring(groupDraft.mode or "world") == "world"
end

local function groupFieldOrder()
  return groupDraftWorldMode() and { "width", "length", "targetY" } or { "width", "length", "depth" }
end

local function commitGroupDraftField()
  if not groupDraft then return end
  local field = groupDraft.selectedField or "width"
  local value = tonumber(groupDraft.buffer)
  if not value then value = groupDraft[field] or 1 end
  value = common.clamp(math.floor(value), fieldLimits[field] and -fieldLimits[field] or 1, fieldLimits[field] or 512)
  if field ~= "targetY" then value = math.max(1, value) end
  groupDraft[field], groupDraft.buffer = value, tostring(value)
end

local function chooseGroupDraftField(field)
  commitGroupDraftField()
  if not groupDraft then return end
  groupDraft.selectedField = field
  groupDraft.buffer = tostring(groupDraft[field] or 0)
end

local function groupDraftDigit(digit)
  if not groupDraft then return end
  local buffer = tostring(groupDraft.buffer or "")
  if tostring(digit) == "-" then
    if groupDraft.selectedField == "targetY" and buffer:sub(1, 1) ~= "-" then groupDraft.buffer = "-" .. (buffer == "0" and "" or buffer); groupDraft.preflight = nil end
    return
  end
  if buffer == "0" then buffer = "" end
  if #buffer < 6 then groupDraft.buffer = buffer .. tostring(digit); groupDraft.preflight = nil end
end

local function groupDraftBackspace()
  if not groupDraft then return end
  local buffer = tostring(groupDraft.buffer or "")
  groupDraft.buffer = buffer:sub(1, math.max(0, #buffer - 1))
  if groupDraft.buffer == "" or groupDraft.buffer == "-" then groupDraft.buffer = "0" end
  groupDraft.preflight = nil
end

local function adjustGroupDraft(field, delta)
  chooseGroupDraftField(field)
  if not groupDraft then return end
  local value = tonumber(groupDraft[field]) or 1
  local minimum = field == "targetY" and -fieldLimits.targetY or 1
  local maximum = fieldLimits[field] or 512
  groupDraft[field], groupDraft.buffer = common.clamp(value + delta, minimum, maximum), nil
  groupDraft.buffer = tostring(groupDraft[field])
  groupDraft.preflight = nil
end

local function commitDraftField()
  if not draft then return end
  local field = draft.selectedField or "width"
  local value = tonumber(draft.buffer)
  if not value then value = draft[field] or 1 end
  value = common.clamp(math.floor(value), fieldLimits[field] and -fieldLimits[field] or 1, fieldLimits[field] or 512)
  if field ~= "targetY" then value = math.max(1, value) end
  draft[field], draft.buffer = value, tostring(value)
end

local function chooseDraftField(field)
  commitDraftField()
  draft.selectedField = field
  draft.buffer = tostring(draft[field] or 0)
end

local function draftDigit(digit)
  if not draft then return end
  local buffer = tostring(draft.buffer or "")
  if tostring(digit) == "-" then
    if draft.selectedField == "targetY" and buffer:sub(1, 1) ~= "-" then draft.buffer = "-" .. (buffer == "0" and "" or buffer) end
    return
  end
  if buffer == "0" then buffer = "" end
  if #buffer < 6 then draft.buffer = buffer .. tostring(digit) end
end

local function draftBackspace()
  if not draft then return end
  local buffer = tostring(draft.buffer or "")
  draft.buffer = buffer:sub(1, math.max(0, #buffer - 1))
  if draft.buffer == "" or draft.buffer == "-" then draft.buffer = "0" end
end

local function adjustDraft(field, delta)
  chooseDraftField(field)
  local value = tonumber(draft[field]) or 1
  local minimum = field == "targetY" and -fieldLimits.targetY or 1
  local maximum = fieldLimits[field] or 512
  draft[field], draft.buffer = common.clamp(value + delta, minimum, maximum), nil
  draft.buffer = tostring(draft[field])
end

local function writeHeader(title, target, background)
  local width = target.getSize()
  common.writeAt(1, 1, common.center(title, width), colors and colors.black or nil, background or (colors and colors.cyan or nil))
  -- Each screen body starts from a known palette.  Without this reset, the
  -- cyan header background leaked into every following line which omitted an
  -- explicit background colour.
  common.setColors(colors and colors.black or nil, colors and colors.white or nil)
end

local function noticeLine(target, y)
  local width, height = target.getSize()
  y = y or height
  if y < 1 then return end
  local noticeColor = noticeIsError and (colors and colors.red or nil) or (colors and colors.lime or nil)
  local prefix = noticeIsError and "ERROR - open LAST ERR: " or ""
  common.writeAt(1, y, common.fit(prefix .. notice, width), noticeColor, colors and colors.black or nil)
end

local function wrapNotice(text, width)
  local lines, remaining = {}, tostring(text or "")
  width = math.max(8, width)
  while #remaining > width do
    local cut = width
    while cut > 1 and remaining:sub(cut, cut) ~= " " do cut = cut - 1 end
    if cut <= 1 then cut = width end
    lines[#lines + 1] = remaining:sub(1, cut):gsub("%s+$", "")
    remaining = remaining:sub(cut + 1):gsub("^%s+", "")
  end
  if remaining ~= "" then lines[#lines + 1] = remaining end
  return lines
end

local function renderErrorDetail(target, key)
  local width, height = target.getSize()
  writeHeader("COMMAND REJECTED - DETAILS", target, colors and colors.red or nil)
  common.writeAt(1, 2, common.fit("The worker refused the command. Read the reason below.", width), colors and colors.yellow or nil)
  local lines = wrapNotice(noticeState.detail or notice or "Unknown error", math.max(8, width - 2))
  local maxLines = math.max(1, height - 5)
  for index = 1, math.min(#lines, maxLines) do
    common.writeAt(2, 2 + index, common.fit(lines[index], math.max(1, width - 2)), colors and colors.white or nil)
  end
  if #lines > maxLines then common.writeAt(2, height - 2, common.fit("The message continues; use ccm report if needed.", math.max(1, width - 2)), colors and colors.yellow or nil) end
  buttonRow(key, height, width, { { "OK - RETURN", noticeState.dismiss, true } })
end

local function statusGlyph(state)
  return ({ ok = "OK", warn = "!!", bad = "XX" })[state] or "??"
end

local function renderDashboard(target, key)
  local width, height = target.getSize()
  writeHeader("CC MINER V4 TOUCH CONTROL", target)
  local ids = orderedIds()
  local online = 0
  for _, id in ipairs(ids) do if statusOf(workers[id]) ~= "offline" then online = online + 1 end end
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
  common.writeAt(1, 2, common.fit(("Controller #%d | Workers %d/%d | selected #%s"):format(os.getComputerID(), online, #ids, tostring(id or "-")), width), colors and colors.lightGray or nil)
  local secondRow = math.max(7, height - 1)
  local firstRow = secondRow - 3
  local cardBottom = firstRow - 2
  if cardBottom >= 3 then
    local lines = {}
    if id then
      local progress = data.progress or {}
      local materials = data.materials or {}
      local gps = data.gps or {}
      lines = {
        { ("SELECTED WORKER  #%s  %s"):format(tostring(id), workerLabel(worker, id)), colors and colors.yellow or nil },
        { ("Status: %s  |  Phase: %s  |  Profile: %s"):format(statusOf(worker), tostring(data.phase or "-"), tostring(data.effectiveProfile or data.profile or "-")), colors and colors.white or nil },
        { "Progress: " .. progressText(data), colors and colors.lime or nil },
        { ("Fuel: %s / %s"):format(tostring(data.fuel or "-"), tostring(data.fuelLimit or "-")), colors and colors.white or nil },
        { ("Inventory: %s used / %s empty / %s items"):format(tostring(data.inventoryUsed or "-"), tostring(data.inventoryEmpty or "-"), tostring(data.inventoryItems or "-")), colors and colors.white or nil },
        { ("Materials: seal %s  |  torches %s"):format(tostring(materials.sealCount or data.seal and data.seal.count or "-"), tostring(materials.torchCount or data.lighting and data.lighting.torchCount or "-")), colors and colors.lightGray or nil },
        { ("GPS: %s  |  Home: %s"):format(gps.calibrated and "calibrated" or "not used", data.atHome and "yes" or "no"), colors and colors.lightGray or nil },
      }
      if data.job then lines[#lines + 1] = { ("Job: %s  |  %sx%sx%s"):format(tostring(data.job.name or data.job.id or "active"), tostring(data.job.width or "-"), tostring(data.job.length or "-"), tostring(data.job.depth or "-")), colors and colors.cyan or nil } end
      if data.lastError then lines[#lines + 1] = { "Last error: " .. tostring(data.lastError), colors and colors.red or nil } end
    else
      lines = {
        { "NO WORKER SELECTED", colors and colors.yellow or nil },
        { "Open WORKERS, touch DISCOVER, then select one worker.", colors and colors.white or nil },
      }
    end
    for y = 3, cardBottom do
      local entry = lines[y - 2]
      common.writeAt(1, y, common.fit(entry and entry[1] or "", width), entry and entry[2] or (colors and colors.white or nil), colors and colors.gray or nil)
    end
  end
  buttonRow(key, firstRow, width, {
    { "WORKERS", dashboardAction("workers") }, { "NEW JOB", dashboardAction("new") },
    { "PROGRESS", dashboardAction("progress") }, { "MORE", dashboardAction("more") },
  }, true)
  buttonRow(key, secondRow, width, {
    { "PAUSE", dashboardAction("pause") }, { "RESUME", dashboardAction("resume") },
    { "RETURN", dashboardAction("recall") }, { "STOP", dashboardAction("stop") },
  }, true)
  local groupIds = orderedGroupIds()
  if #groupIds > 0 and height >= 12 then
    local gy = 5
    local gid, g = selectedGroupRecord()
    local gj = gid and activeGroupJob(gid) or nil
    local aggregate = gj and (gj.aggregate or updateGroupAggregate(gj)) or nil
    local line = ("Group %s %s %d workers %s%% minFuel=%s ACK=%s/%s"):format(tostring(gid), groupName(g, gid), #(groupWorkerIds(g)), tostring(aggregate and aggregate.percent or 0), tostring(aggregate and aggregate.minFuel or "-"), tostring(aggregate and aggregate.acks or 0), tostring(aggregate and aggregate.ackTotal or #groupWorkerIds(g)))
    common.writeAt(1, gy, common.fit(line, width), colors and colors.cyan or nil, colors and colors.gray or nil)
  end
  noticeLine(target, height)
end

noticeState.createGroupFromWorkers = function()
  local ids = {}
  for id, chosen in pairs(noticeState.groupSelection or {}) do
    if chosen then ids[#ids + 1] = tonumber(id) or id end
  end
  table.sort(ids, function(a, b) return tostring(a) < tostring(b) end)
  if #ids < 2 then setNotice("Select at least two workers for a group.", true); return end
  local workerBays, workerDocks, resources = {}, {}, {}
  for _, id in ipairs(ids) do
    local data = workerData(id) or {}
    local calibration = data.gps and data.gps.calibration
    local home = calibration and calibration.home
    local forward = calibration and calibration.forward
    if not (data.gps and data.gps.calibrated and type(home) == "table"
      and tonumber(home.x) and tonumber(home.y) and tonumber(home.z) and type(forward) == "table") then
      setNotice("Group creation needs GPS CAL on every selected worker. Missing on #" .. tostring(id) .. ".", true)
      return
    end
    local facing
    if tonumber(forward.x) == 0 and tonumber(forward.z) == 1 then facing = 0
    elseif tonumber(forward.x) == 1 and tonumber(forward.z) == 0 then facing = 1
    elseif tonumber(forward.x) == 0 and tonumber(forward.z) == -1 then facing = 2
    elseif tonumber(forward.x) == -1 and tonumber(forward.z) == 0 then facing = 3 end
    if facing == nil then setNotice("Worker #" .. tostring(id) .. " has an invalid GPS direction.", true); return end
    resources[tostring(id)] = {
      world = { x = home.x, y = home.y, z = home.z },
      facing = facing, maxDepth = data.dock and data.dock.maxDepth or nil,
    }
  end
  -- Validate every selected worker before writing any registry entries.  This
  -- avoids leaving half-created docks when a later worker still needs GPS CAL.
  for _, id in ipairs(ids) do
    local dockId, bayId = "worker-" .. tostring(id) .. "-dock", "worker-" .. tostring(id) .. "-bay"
    local resource = resources[tostring(id)]
    local dockOK, dockError = registerDock(dockId, resource)
    if not dockOK then setNotice("Could not register dock for #" .. tostring(id) .. ": " .. tostring(dockError), true); return end
    local bayOK, bayError = registerBay(bayId, resource)
    if not bayOK then setNotice("Could not register bay for #" .. tostring(id) .. ": " .. tostring(bayError), true); return end
    workerDocks[tostring(id)], workerBays[tostring(id)] = dockId, bayId
  end
  local number = 1
  while groupRecord("group-" .. tostring(number)) do number = number + 1 end
  local groupId = "group-" .. tostring(number)
  local ok, result = registerGroup(groupId, ids, {
    name = "Group " .. tostring(number), mode = "world",
    partition = config.group and config.group.partitionMode or "stripe",
    workerBays = workerBays, workerDocks = workerDocks,
  })
  if not ok then setNotice("Could not create group: " .. tostring(result), true); return end
  local groupIds = orderedGroupIds()
  for index, value in ipairs(groupIds) do if tostring(value) == groupId then selectedGroup = index end end
  noticeState.groupSelectMode, noticeState.groupSelection = false, {}
  mode = "groups"
  setNotice(("Created %s with %d workers. Open START to choose its mining area."):format(groupId, #ids), false)
  invalidate()
end

noticeState.renderWorkers = function(target, key)
  local width, height = target.getSize()
  local ids = orderedIds()
  writeHeader("WORKERS", target)
  local rowsPerPage = math.max(1, height - 5)
  local pages = math.max(1, math.ceil(#ids / rowsPerPage))
  noticeState.workerPage = common.clamp(tonumber(noticeState.workerPage) or 1, 1, pages)
  local first = (noticeState.workerPage - 1) * rowsPerPage + 1
  local selectionCount = common.tableCount(noticeState.groupSelection or {})
  local summary = noticeState.groupSelectMode
    and ("GROUP SELECT | Page %d/%d | chosen %d"):format(noticeState.workerPage, pages, selectionCount)
    or ("Page %d/%d | %d workers | selected #%s"):format(noticeState.workerPage, pages, #ids, tostring(selectedWorker() or "-"))
  common.writeAt(1, 2, common.fit(summary, width), noticeState.groupSelectMode and (colors and colors.yellow or nil) or (colors and colors.lightGray or nil))
  if #ids == 0 then
    common.writeAt(1, 3, common.fit("No workers found. Touch DISCOVER.", width), colors and colors.yellow or nil)
  end
  for row = 1, rowsPerPage do
    local index = first + row - 1
    local id = ids[index]
    if not id then break end
    local worker, data = workers[id], workers[id].data or {}
    local status = statusOf(worker)
    local chosen = noticeState.groupSelection[tostring(id)] == true
    local markerText = noticeState.groupSelectMode and (chosen and "X" or " ") or (index == selected and ">" or " ")
    local line = width >= 48
      and ("%s#%-4s %-14s %-12s %-16s F=%s"):format(markerText, tostring(id), common.fit(workerLabel(worker, id), 14), common.fit(status, 12), common.fit(progressText(data), 16), tostring(data.fuel or "-"))
      or ("%s#%-3s %-9s %-8s %s"):format(markerText, tostring(id), common.fit(workerLabel(worker, id), 9), common.fit(status, 8), progressText(data))
    local y = 2 + row
    local highlighted = chosen or (not noticeState.groupSelectMode and index == selected)
    common.writeAt(1, y, common.fit(line, width), highlighted and (colors and colors.black or nil) or common.statusColor(status), highlighted and (colors and (chosen and colors.yellow or colors.white) or nil) or (colors and colors.black or nil))
    addHitbox(key, 1, y, width, y, function()
      if noticeState.groupSelectMode then noticeState.groupSelection[tostring(id)] = not chosen or nil
      else selected = index end
      invalidate()
    end)
  end
  if noticeState.groupSelectMode then
    buttonRow(key, height - 1, width, {
      { "PREV", function() noticeState.workerPage = math.max(1, noticeState.workerPage - 1); invalidate() end, noticeState.workerPage > 1 },
      { "NEXT", function() noticeState.workerPage = math.min(pages, noticeState.workerPage + 1); invalidate() end, noticeState.workerPage < pages },
      { "CREATE", noticeState.createGroupFromWorkers, selectionCount >= 2 },
      { "CLEAR", function() noticeState.groupSelection = {}; invalidate() end },
      { "CANCEL", function() noticeState.groupSelectMode = false; noticeState.groupSelection = {}; invalidate() end },
    }, true)
  else
    buttonRow(key, height - 1, width, {
      { "PREV", function() noticeState.workerPage = math.max(1, noticeState.workerPage - 1); invalidate() end, noticeState.workerPage > 1 },
      { "NEXT", function() noticeState.workerPage = math.min(pages, noticeState.workerPage + 1); invalidate() end, noticeState.workerPage < pages },
      { "DISCOVER", dashboardAction("discover") },
      { "GROUP", function() noticeState.groupSelectMode = true; noticeState.groupSelection = {}; invalidate() end, #ids >= 2 },
      { "BACK", function() mode = "dashboard"; invalidate() end },
    }, true)
  end
  noticeLine(target, height)
end

noticeState.renderMore = function(target, key)
  local width, height = target.getSize()
  writeHeader("MORE COMMANDS", target)
  noticeState.morePage = common.clamp(tonumber(noticeState.morePage) or 1, 1, 2)
  common.writeAt(1, 2, common.fit(("Page %d/2 | large buttons are always enabled"):format(noticeState.morePage), width), colors and colors.lightGray or nil)
  local secondRow = math.max(7, height - 1)
  local firstRow = secondRow - 3
  if noticeState.morePage == 1 then
    buttonRow(key, firstRow, width, {
      { "INFO", dashboardAction("info") }, { "ITEMS", dashboardAction("items") },
      { "REPORT", dashboardAction("report") }, { "RECOVERY", dashboardAction("recovery") },
    }, true)
    buttonRow(key, secondRow, width, {
      { "GROUPS", dashboardAction("groups") }, { "REMOTE", dashboardAction("remote") },
      { "GPS", dashboardAction("gps") }, { "NEXT", function() noticeState.morePage = 2; invalidate() end },
    }, true)
  else
    buttonRow(key, firstRow, width, {
      { "SERVICE", dashboardAction("service") }, { "CLEAR", dashboardAction("clear") },
      { "REHOME", dashboardAction("rehome") }, { "LAST ERR", dashboardAction("last_error") },
    }, true)
    buttonRow(key, secondRow, width, {
      { "PREV", function() noticeState.morePage = 1; invalidate() end },
      { "WORKERS", dashboardAction("workers") }, { "BACK", function() mode = "dashboard"; invalidate() end },
    }, true)
  end
  noticeLine(target, height)
end

noticeState.openItems = function()
  local id, worker = selectedWorker()
  if not id or not worker then setNotice("No worker selected.", true); return end
  local data = worker.data or {}
  local current = data.discard or {}
  local selectedItems = {}
  for _, name in ipairs(current.allowlist or {}) do selectedItems[tostring(name)] = true end
  noticeState.discardDraft = {
    workerId = id,
    mode = tostring(current.mode or "KEEP_ALL"),
    selected = selectedItems,
    page = 1,
  }
  mode = "items"
  invalidate()
end

noticeState.renderItems = function(target, key)
  local width, height = target.getSize()
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
  local form = noticeState.discardDraft
  writeHeader("AUTO DISCARD ITEMS", target)
  if not id or not form or tonumber(form.workerId) ~= tonumber(id) then
    common.writeAt(1, 3, common.fit("Select a worker and reopen ITEMS.", width), colors and colors.red or nil)
    drawButton(key, 1, height - 1, width, "BACK", function() mode = "more"; invalidate() end, true)
    return
  end
  local byName = {}
  for _, item in ipairs((data.inventory and data.inventory.slots) or {}) do
    local name = tostring(item.name or "")
    if name ~= "" then
      local row = byName[name] or { name = name, count = 0, locked = false, reserve = false }
      row.count = row.count + (tonumber(item.count) or 0)
      row.locked = row.locked or item.torch == true or item.fuel == true
      row.reserve = row.reserve or item.seal == true
      byName[name] = row
    end
  end
  for name in pairs(form.selected or {}) do byName[name] = byName[name] or { name = name, count = 0 } end
  local items = {}
  for _, item in pairs(byName) do items[#items + 1] = item end
  table.sort(items, function(a, b) return a.name < b.name end)
  local modes = {
    { "KEEP", "KEEP_ALL" }, { "STONE", "DISCARD_EXCESS_STONE" }, { "CHOOSE", "CUSTOM_ALLOWLIST" },
  }
  common.writeAt(1, 2, common.fit("Touch item names, then APPLY. [LOCK] cannot be discarded.", width), colors and colors.lightGray or nil)
  local modeButtons = {}
  for _, entry in ipairs(modes) do
    local label, value = entry[1], entry[2]
    modeButtons[#modeButtons + 1] = { label, function() form.mode = value; invalidate() end, true, form.mode == value }
  end
  local expanded = height >= 14
  local modeY = expanded and 4 or 3
  buttonRow(key, modeY, width, modeButtons, expanded)
  local roomy = height >= 12
  local listStart, itemStep = expanded and 7 or roomy and 5 or 4, expanded and 3 or roomy and 2 or 1
  local summaryY, controlsY, backY
  if expanded then summaryY, controlsY, backY = height - 6, height - 3, height - 1
  elseif roomy then summaryY, controlsY, backY = height - 5, height - 3, height - 1
  else summaryY, controlsY, backY = height - 3, height - 2, height - 1 end
  local lastItemY = summaryY - (expanded and 2 or roomy and 2 or 1)
  local rows = math.max(1, math.floor((lastItemY - listStart) / itemStep) + 1)
  local pages = math.max(1, math.ceil(#items / rows))
  form.page = common.clamp(tonumber(form.page) or 1, 1, pages)
  local first = (form.page - 1) * rows + 1
  for row = 1, rows do
    local item = items[first + row - 1]
    if not item then break end
    local suffix = item.locked and " [LOCK]" or item.reserve and " [RESERVE]" or ""
    local label = ("%s x%d%s"):format(item.name, item.count, suffix)
    local enabled = not item.locked
    drawButton(key, 1, listStart + (row - 1) * itemStep, width, label, function()
      form.selected[item.name] = not form.selected[item.name] or nil
      if form.selected[item.name] then form.mode = "CUSTOM_ALLOWLIST" end
      invalidate()
    end, enabled, form.selected[item.name] == true, expanded)
  end
  common.writeAt(1, summaryY, common.fit(("Page %d/%d | selected %d"):format(form.page, pages, common.tableCount(form.selected)), width), colors and colors.lightGray or nil)
  buttonRow(key, controlsY, width, {
    { "PREV", function() form.page = math.max(1, form.page - 1); invalidate() end, form.page > 1 },
    { "NEXT", function() form.page = math.min(pages, form.page + 1); invalidate() end, form.page < pages },
    { "APPLY", function()
      local allowlist = {}
      for name, chosen in pairs(form.selected) do if chosen then allowlist[#allowlist + 1] = name end end
      table.sort(allowlist)
      sendCommand(id, "discard_config", { mode = form.mode, allowlist = allowlist })
      setNotice("Discard settings sent to worker #" .. tostring(id) .. ".", false)
    end },
  }, expanded)
  drawButton(key, 1, backY, width, "BACK", function() mode = "more"; invalidate() end, true, false, expanded)
end

local function groupAction(groupCommandName)
  return function()
    local gid = selectedGroupRecord()
    if not gid then setNotice("No group selected.", true); return end
    if groupCommandName == "start" then
      groupDraft = groupDraftDefaults(groupRecord(gid))
      groupDraft.selectedField = "width"
      groupDraft.buffer = tostring(groupDraft.width or 1)
      groupDraft.preflight = nil
      mode = "group_dimensions"
    else
      groupCommand(gid, groupCommandName)
    end
    invalidate()
  end
end

local function groupAssignmentCount(result)
  local count = 0
  for _, assignment in pairs(result and result.assignments or {}) do if type(assignment) == "table" then count = count + 1 end end
  return count
end

local function renderGroupDimensions(target, key)
  local width, height = target.getSize()
  local gid, group = selectedGroupRecord()
  writeHeader("GROUP JOB / DIMENSIONS", target, colors and colors.cyan or nil)
  if not gid or not group then
    common.writeAt(1, 3, common.fit("No group selected.", width), colors and colors.yellow or nil)
    buttonRow(key, math.max(1, height - 2), width, { { "BACK", function() mode = "groups" end } })
    noticeLine(target, height)
    return
  end
  groupDraft = groupDraft or groupDraftDefaults(group)
  local ids = groupWorkerIds(group)
  local worldMode = groupDraftWorldMode()
  common.writeAt(1, 2, common.fit(("Group %s (%s) | workers=%d | %s | partition=%s"):format(groupName(group, gid), tostring(gid), #ids, worldMode and "WORLD" or "LOCAL", tostring(groupDraft.partition or group.partition or "stripe")), width), colors and colors.lightGray or nil)
  common.writeAt(1, 3, common.fit(worldMode and "BOTTOM Y is absolute; each worker reports HOME Y/LAYERS." or "LOCAL uses DEPTH; multi-worker automatic splitting is disabled.", width), colors and colors.lightGray or nil)
  local visibleFields = groupFieldOrder()
  local fieldWidth = math.min(32, math.max(14, math.floor(width * 0.52)))
  local rows = math.min(#visibleFields, math.max(1, math.floor((height - 13) / 2)))
  for index = 1, rows do
    local field = visibleFields[index]
    local y = 4 + (index - 1) * 2
    local active = groupDraft.selectedField == field
    local shown = active and groupDraft.buffer or tostring(groupDraft[field] or 0)
    common.writeAt(1, y, common.fit(fieldLabels[field], fieldWidth - 2), active and (colors and colors.black or nil) or (colors and colors.white or nil), active and (colors and colors.yellow or nil) or (colors and colors.black or nil))
    drawButton(key, 1, y + 1, 3, "-", function() adjustGroupDraft(field, -1) end, true)
    drawButton(key, 5, y + 1, math.max(5, fieldWidth - 11), shown, function() chooseGroupDraftField(field) end, true, active)
    drawButton(key, fieldWidth - 5, y + 1, 3, "+", function() adjustGroupDraft(field, 1) end, true)
  end
  local keypadX = math.min(width - 12, fieldWidth + 2)
  local keypadWidth = math.max(12, width - keypadX + 1)
  local cellWidth = math.max(4, math.floor(keypadWidth / 3))
  local labels = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "CLR", "0", "<" }
  for index, label in ipairs(labels) do
    local row = math.floor((index - 1) / 3)
    local column = (index - 1) % 3
    local x, y = keypadX + column * cellWidth, 4 + row * 2
    if y <= height - 8 then
      local action
      if label == "CLR" then action = function() groupDraft.buffer = "0" end
      elseif label == "<" then action = groupDraftBackspace
      else local digit = label; action = function() groupDraftDigit(digit) end end
      drawButton(key, x, y, math.max(3, cellWidth - 1), label, action, true)
      addHitbox(key, x, y, x + math.max(2, cellWidth - 2), math.min(height - 8, y + 1), action)
    end
  end
  local summaryY = math.max(8, height - 10)
  local homeBits = {}
  for _, id in ipairs(ids) do
    local data = workerData(id) or {}
    local homeY = data.homeY or data.gps and data.gps.calibration and data.gps.calibration.home and data.gps.calibration.home.y or "-"
    homeBits[#homeBits + 1] = "#" .. tostring(id) .. " HOME=" .. tostring(homeY)
  end
  common.writeAt(1, summaryY, common.fit(table.concat(homeBits, " "), width), colors and colors.lightGray or nil)
  local result = groupDraft.preflight
  if result then
    local assignmentText = (result.fatal and "PREFLIGHT BLOCKED" or "PREFLIGHT OK") .. " assignments=" .. tostring(groupAssignmentCount(result)) .. "/" .. tostring(#ids) .. " chunks=" .. tostring(result.selectedChunks or 0)
    common.writeAt(1, summaryY + 1, common.fit(assignmentText, width), result.fatal and (colors and colors.red or nil) or (colors and colors.lime or nil))
    local row = summaryY + 2
    for _, id in ipairs(ids) do
      if row >= height - 5 then break end
      local assignment = result.assignments and (result.assignments[tostring(id)] or result.assignments[id]) or nil
      local chunks = assignment and #(assignment.chunkKeys or {}) or 0
      local homeY = assignment and assignment.homeY or (workerData(id) or {}).homeY or "-"
      local layers = assignment and assignment.layers or (homeY ~= "-" and result.bottomY and tonumber(homeY) and math.floor(tonumber(homeY) - tonumber(result.bottomY) + 1) or "-")
      common.writeAt(1, row, common.fit(("#%s chunks=%d HOME Y=%s LAYERS=%s"):format(tostring(id), chunks, tostring(homeY), tostring(layers)), width), colors and colors.white or nil)
      row = row + 1
    end
  else
    common.writeAt(1, summaryY + 1, common.fit("PRECHECK required before START.", width), colors and colors.yellow or nil)
  end
  buttonRow(key, math.max(1, height - 4), width, {
    { "LIGHT " .. tostring(groupDraft.lighting and groupDraft.lighting.mode or "safe"), function() local modes = { "off", "safe", "custom" }; local now = groupDraft.lighting and groupDraft.lighting.mode or "safe"; local n = 1; for i, value in ipairs(modes) do if value == now then n = i end end; groupDraft.lighting.mode = modes[n % #modes + 1]; groupDraft.preflight = nil; invalidate() end },
    { "WATER " .. tostring(groupDraft.waterMode or "seal"), function() local modes = { "ignore", "stop", "seal" }; local now = groupDraft.waterMode or "seal"; local n = 1; for i, value in ipairs(modes) do if value == now then n = i end end; groupDraft.waterMode = modes[n % #modes + 1]; groupDraft.preflight = nil; invalidate() end },
    { "PROFILE " .. tostring(groupDraft.profile or "balanced"), function() local modes = { "safe", "balanced", "turbo" }; local now = groupDraft.profile or "balanced"; local n = 1; for i, value in ipairs(modes) do if value == now then n = i end end; groupDraft.profile = modes[n % #modes + 1]; groupDraft.preflight = nil; invalidate() end },
    { "PART " .. tostring(groupDraft.partition or group.partition or "stripe"), function() groupDraft.partition = (tostring(groupDraft.partition or group.partition or "stripe") == "stripe") and "round_robin" or "stripe"; groupDraft.preflight = nil; invalidate() end },
  })
  local canStart = result and not result.fatal
  buttonRow(key, math.max(1, height - 2), width, {
    { "PRECHECK", function() commitGroupDraftField(); groupDraft.preflight = computeGroupPreflight(gid, groupDraft); invalidate() end },
    { "START", function() commitGroupDraftField(); local checked = groupDraft.preflight or computeGroupPreflight(gid, groupDraft); groupDraft.preflight = checked; if checked and not checked.fatal then startGroup(gid, groupDraft) end; invalidate() end, canStart },
    { "BACK", function() mode = "groups"; invalidate() end },
  })
  noticeLine(target, height)
end

local function renderGroups(target, key)
  local width, height = target.getSize()
  local verticalStep = height >= 12 and 2 or 1
  writeHeader("WORKER GROUPS", target)
  local ids = orderedGroupIds()
  common.writeAt(1, 2, common.fit(("Groups %d | selected=%d"):format(#ids, selectedGroup), width), colors and colors.lightGray or nil)
  local maxRows = math.max(1, height - (verticalStep == 2 and 11 or 9))
  if #ids == 0 then
    common.writeAt(2, 4, common.fit("No groups. Open WORKERS, touch GROUP, then select at least two workers.", width), colors and colors.yellow or nil)
    common.writeAt(2, 5, common.fit("All selected workers need GPS CAL. CREATE registers their individual dock and bay automatically.", width), colors and colors.lightGray or nil)
  else
    local first = selectedGroup > maxRows and selectedGroup - maxRows + 1 or 1
    for row = 1, maxRows do
      local index = first + row - 1
      local gid = ids[index]
      if not gid then break end
      local group = groupRecord(gid)
      local job = activeGroupJob(gid)
      local aggregate = job and (job.aggregate or updateGroupAggregate(job)) or { percent = 0, online = 0, total = #groupWorkerIds(group), minFuel = nil, warnings = {}, acks = 0, ackTotal = #groupWorkerIds(group) }
      local warning = aggregate.warnings and aggregate.warnings[1] or "-"
      local line = ("%s%-12s %-10s W=%d/%d P=%3d%% F=%s ACK=%d/%d %s"):format(index == selectedGroup and ">" or " ", common.fit(groupName(group, gid), 12), tostring(job and job.status or "idle"), aggregate.online or 0, aggregate.total or 0, aggregate.percent or 0, tostring(aggregate.minFuel or "-"), aggregate.acks or 0, aggregate.ackTotal or 0, common.fit(warning, math.max(1, width - 70)))
      local y = 3 + row
      common.writeAt(1, y, common.fit(line, width), index == selectedGroup and (colors and colors.black or nil) or colors and colors.white or nil, index == selectedGroup and (colors and colors.white or nil) or nil)
      addHitbox(key, 1, y, width, y, function() selectedGroup = index; invalidate() end)
    end
  end
  local bottom = math.max(1, height - verticalStep * 2 - 1)
  buttonRow(key, bottom, width, { { "START", groupAction("start") }, { "PAUSE", groupAction("pause") }, { "RESUME", groupAction("resume") }, { "RETURN", groupAction("return") } }, verticalStep == 2)
  buttonRow(key, bottom + verticalStep, width, { { "SERVICE", groupAction("service") }, { "ABORT", groupAction("abort") }, { "CLEAR", groupAction("clear") }, { "DRILLDOWN", function() mode = "group_info"; invalidate() end } }, verticalStep == 2)
  buttonRow(key, bottom + verticalStep * 2, width, { { "BACK", function() mode = "dashboard" end }, { "REFRESH", function() local gid = selectedGroupRecord(); local job = gid and activeGroupJob(gid); if job then updateGroupAggregate(job) end; invalidate() end } }, verticalStep == 2)
  noticeLine(target, height)
end

local function renderGroupInfo(target, key)
  local width, height = target.getSize()
  local gid, group = selectedGroupRecord()
  local job = gid and activeGroupJob(gid) or nil
  writeHeader("GROUP DRILLDOWN", target, colors and colors.cyan or nil)
  if not gid or not group then
    common.writeAt(1, 3, common.fit("No group selected.", width), colors and colors.yellow or nil)
  else
    local aggregate = job and (job.aggregate or updateGroupAggregate(job)) or { percent = 0, minFuel = nil, warnings = {}, acks = 0, ackTotal = #groupWorkerIds(group) }
    common.writeAt(1, 2, common.fit(("%s (%s) mode=%s partition=%s"):format(groupName(group, gid), tostring(gid), tostring(group.mode or "world"), tostring(group.partition or "stripe")), width), colors and colors.lightGray or nil)
    common.writeAt(1, 3, common.fit(("GROUP %s%% | BOTTOM Y=%s | minFuel=%s | ACK %d/%d | warnings=%d"):format(tostring(aggregate.percent or 0), tostring(job and job.bottomY or "-"), tostring(aggregate.minFuel or "-"), aggregate.acks or 0, aggregate.ackTotal or 0, #(aggregate.warnings or {})), width), colors and colors.cyan or nil)
    local row = 5
    for _, workerId in ipairs(groupWorkerIds(group)) do
      if row >= height - 5 then break end
      local worker = workers[workerId]
      local data = worker and worker.data or {}
      local assignment = job and job.assignments and (job.assignments[tostring(workerId)] or job.assignments[workerId]) or nil
      local status = assignment and assignment.status or statusOf(worker)
      local homeY = assignment and assignment.homeY or data.homeY or data.gps and data.gps.calibration and data.gps.calibration.home and data.gps.calibration.home.y or "-"
      local layers = assignment and assignment.layers or data.job and data.job.depth or "-"
      local progress = worker and progressText(data) or "-"
      local line = ("#%-4s %-12s %-12s %s HOME Y=%s LAYERS=%s"):format(tostring(workerId), common.fit(workerLabel(worker, workerId), 12), common.fit(status, 12), common.fit(progress, 14), tostring(homeY), tostring(layers))
      common.writeAt(1, row, common.fit(line, width), status == "blocked" and colors and colors.red or colors and colors.white or nil)
      row = row + 1
      if assignment and (status == "blocked" or status == "offline" or status == "failed") then
        common.writeAt(3, row, common.fit("REMAIN " .. tostring(#(assignment.chunkKeys or {})) .. " chunks; use REASSIGN", math.max(1, width - 3)), colors and colors.yellow or nil)
        addHitbox(key, 1, row, width, row, function() if job then reassignGroupAssignment(job.groupJobId, workerId) end end)
        row = row + 1
      end
    end
    local reason = job and (job.returnReason or job.completionReason) or nil
    local report = job and (job.report or job.metrics) or nil
    if reason then common.writeAt(1, math.max(4, height - 5), common.fit("RETURN: " .. tostring(reason), width), colors and colors.yellow or nil) end
    if report then
      local discard = report.discard or report.discardCount or "-"
      if type(discard) == "table" then discard = tostring(discard.count or discard.total or common.tableCount(discard)) end
      common.writeAt(1, math.max(4, height - 4), common.fit(("METRICS blocks=%s fuel=%s discard=%s"):format(tostring(report.blocks or report.totalBlocks or "-"), tostring(report.fuel or "-"), tostring(discard)), width), colors and colors.lightGray or nil)
    end
    if aggregate.warnings and #aggregate.warnings > 0 then common.writeAt(1, math.max(4, height - 3), common.fit("WARN: " .. table.concat(aggregate.warnings, "; "), width), colors and colors.orange or nil) end
  end
  buttonRow(key, math.max(1, height - 1), width, { { "BACK", function() mode = "groups" end }, { "REFRESH", function() local id = selectedGroupRecord(); local job = id and activeGroupJob(id); if job then updateGroupAggregate(job) end; invalidate() end } })
  noticeLine(target, height)
end

local function renderDimensions(target, key)
  local width, height = target.getSize()
  local id, worker = draftWorker()
  local worldMode = draftCalibration() ~= nil
  local visibleFields = currentFieldOrder()
  writeHeader("NEW JOB - SETTINGS", target)
  common.writeAt(1, 2, common.fit(("Worker #%s %s | %s mode"):format(tostring(id or "-"), worker and workerLabel(worker, id) or "offline", worldMode and "WORLD" or "LOCAL"), width), colors and colors.lightGray or nil)
  common.writeAt(1, 3, common.fit(worldMode and "Fields + keypad. BOTTOM Y derives LAYERS from each worker HOME Y." or "Fields + keypad. GRID tiles are chunks; local jobs omit BOTTOM Y.", width), colors and colors.lightGray or nil)
  local fieldWidth = math.min(32, math.max(14, math.floor(width * 0.52)))
  local rows = math.min(#visibleFields, math.max(1, math.floor((height - 8) / 2)))
  for index = 1, rows do
    local field = visibleFields[index]
    local y = 4 + (index - 1) * 2
    local active = draft.selectedField == field
    local shown = active and draft.buffer or tostring(draft[field])
    common.writeAt(1, y, common.fit(fieldLabels[field], fieldWidth - 2), active and (colors and colors.black or nil) or (colors and colors.white or nil), active and (colors and colors.yellow or nil) or (colors and colors.black or nil))
    drawButton(key, 1, y + 1, 3, "-", function() adjustDraft(field, -1) end, true)
    drawButton(key, 5, y + 1, math.max(5, fieldWidth - 11), shown, function() chooseDraftField(field) end, true, active)
    drawButton(key, fieldWidth - 5, y + 1, 3, "+", function() adjustDraft(field, 1) end, true)
  end
  local keypadX = math.min(width - 12, fieldWidth + 2)
  local keypadWidth = math.max(12, width - keypadX + 1)
  local cellWidth = math.max(4, math.floor(keypadWidth / 3))
  local labels = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "CLR", "0", "<" }
  for index, label in ipairs(labels) do
    local row = math.floor((index - 1) / 3)
    local column = (index - 1) % 3
    local x, y = keypadX + column * cellWidth, 4 + row * 2
    if y <= height - 3 then
      local action
      if label == "CLR" then action = function() draft.buffer = "0" end
      elseif label == "<" then action = draftBackspace
      else local digit = label; action = function() draftDigit(digit) end end
      drawButton(key, x, y, math.max(3, cellWidth - 1), label, action, true)
      addHitbox(key, x, y, x + math.max(2, cellWidth - 2), math.min(height - 3, y + 1), action)
    end
  end
  local summaryY = math.max(4, height - 5)
  local shownDepth = draft.depth
  if worldMode then local derived = effectiveJobDepth("world", draftCalibration()); shownDepth = derived or shownDepth end
  local volume = (tonumber(draft.width) or 1) * (tonumber(draft.length) or 1) * (tonumber(shownDepth) or 1)
  local profileInfo = profileParameters(draft.profile, draft.lighting)
  local intervalText = profileInfo and ("torch=" .. tostring(profileInfo.effectiveInterval) .. "(" .. tostring(profileInfo.requestedInterval) .. ")") or "profile invalid"
  local homeText = "HOME Y=-"
  if worldMode then
    local calibration = draftCalibration()
    homeText = "HOME Y=" .. tostring(calibration and calibration.home and calibration.home.y or "-") .. " LAYERS=" .. tostring(shownDepth)
  end
  common.writeAt(1, summaryY, common.fit(("%dx%dx%d=%s blocks | %s | %s profile=%s %s"):format(draft.width, draft.length, shownDepth, common.humanNumber(volume), worldMode and ("BOTTOM Y=" .. tostring(draft.targetY)) or "LOCAL DEPTH=" .. tostring(shownDepth), homeText, tostring(draft.profile), intervalText), width), colors and colors.lightGray or nil)
  local optionY = math.max(4, summaryY + 1)
  buttonRow(key, optionY, width, {
    { "LIGHT " .. tostring(draft.lighting and draft.lighting.mode or "safe"), function() local modes = { "off", "safe", "custom" }; local now = draft.lighting and draft.lighting.mode or "safe"; local n = 1; for i, value in ipairs(modes) do if value == now then n = i end end; draft.lighting.mode = modes[n % #modes + 1]; invalidate() end },
    { "WATER " .. tostring(draft.waterMode or "seal"), function() local modes = { "ignore", "stop", "seal" }; local now = draft.waterMode or "seal"; local n = 1; for i, value in ipairs(modes) do if value == now then n = i end end; draft.waterMode = modes[n % #modes + 1]; invalidate() end },
    { "PROFILE " .. tostring(draft.profile or "balanced"), function() local modes = { "safe", "balanced", "turbo" }; local now = draft.profile or "balanced"; local n = 1; for i, value in ipairs(modes) do if value == now then n = i end end; draft.profile = modes[n % #modes + 1]; invalidate() end },
    { "AUTO: QUEUE", function() draft.autoAssign = false; setNotice("Single footprint is sent to the selected worker; queue dispatch handles parallel jobs.", false) end },
  })
  buttonRow(key, math.max(1, height - 2), width, {
    { "GRID", function() commitDraftField(); mode = "job_grid"; draft.gridPageX, draft.gridPageZ = 1, 1; invalidate() end },
    { "PREFLIGHT", function() commitDraftField(); local result = computePreflight(); if result then mode = "preflight" end; invalidate() end },
    { "QUEUE", function() commitDraftField(); queueDraft() end, config.queueEnabled ~= false },
    { "CANCEL", function() mode, draft = "dashboard", nil; invalidate() end },
  })
  noticeLine(target, height)
end

local function gridCatalog()
  local catalog, err, chunkMode, calibration, rootKey = buildDraftCatalog()
  if not catalog then return nil, err end
  return catalog, nil, chunkMode, calibration, rootKey
end

local function chunkGrid(catalog)
  local byCoordinate, xSeen, zSeen, xValues, zValues = {}, {}, {}, {}, {}
  for _, chunk in ipairs(catalog or {}) do
    local cx, cz = tonumber(chunk.cx), tonumber(chunk.cz)
    if cx and cz then
      byCoordinate[tostring(cx) .. ":" .. tostring(cz)] = chunk
      if not xSeen[cx] then xSeen[cx] = true; xValues[#xValues + 1] = cx end
      if not zSeen[cz] then zSeen[cz] = true; zValues[#zValues + 1] = cz end
    end
  end
  table.sort(xValues); table.sort(zValues)
  local xIndex, zIndex = {}, {}
  for index, value in ipairs(xValues) do xIndex[value] = index end
  for index, value in ipairs(zValues) do zIndex[value] = index end
  return byCoordinate, xValues, zValues, xIndex, zIndex
end

local function toggleChunk(chunk, catalog, rootKey)
  if not draft then return end
  if not chunk or chunk.key == rootKey then setNotice("Entrance chunk is locked.", true); return end
  draft.excluded = draft.excluded or {}
  if draft.rectMode and draft.rectStart then
    local sx, sz = draft.rectStart.cx, draft.rectStart.cz
    local minX, maxX = math.min(sx, chunk.cx), math.max(sx, chunk.cx)
    local minZ, maxZ = math.min(sz, chunk.cz), math.max(sz, chunk.cz)
    for _, candidate in ipairs(catalog or {}) do
      if candidate.key ~= rootKey then
        local inside = candidate.cx >= minX and candidate.cx <= maxX and candidate.cz >= minZ and candidate.cz <= maxZ
        draft.excluded[candidate.key] = not inside
      end
    end
    draft.rectStart = nil; draft.rectMode = false
    setNotice("RECT mining selection applied to whole chunks.", false)
  elseif draft.rectMode then
    draft.rectStart = { cx = tonumber(chunk.cx), cz = tonumber(chunk.cz), key = chunk.key }
    setNotice("RECT first point stored; touch a second chunk.", false)
  else
    draft.excluded[chunk.key] = not draft.excluded[chunk.key]
  end
  invalidate()
end

local function allGrid(value)
  local catalog, err, _, _, rootKey = gridCatalog()
  if not catalog then setNotice(err, true); return end
  normalizeChunkMask(catalog, rootKey)
  draft.excluded = draft.excluded or {}
  for _, chunk in ipairs(catalog) do if chunk.key ~= rootKey then draft.excluded[chunk.key] = not (value == true) end end
  draft.partialMask = false
  setNotice(value == true and "ALL: all chunks selected for mining." or "CLEAR: all non-entry chunks deselected.", false)
  invalidate()
end

local function invertGrid()
  local catalog, err, _, _, rootKey = gridCatalog()
  if not catalog then setNotice(err, true); return end
  normalizeChunkMask(catalog, rootKey)
  draft.excluded = draft.excluded or {}
  for _, chunk in ipairs(catalog) do if chunk.key ~= rootKey then draft.excluded[chunk.key] = not draft.excluded[chunk.key] end end
  setNotice("INVERT: chunk mining selection inverted; entrance remains selected.", false)
  invalidate()
end

local function renderGrid(target, key)
  local width, height = target.getSize()
  local verticalStep = height >= 12 and 2 or 1
  local catalog, err, chunkMode, _, rootKey = gridCatalog()
  writeHeader("NEW JOB - TOUCH GRID", target)
  if not catalog then common.writeAt(1, 3, common.fit(tostring(err), width), colors and colors.red or nil); drawButton(key, 1, height - 1, width, "BACK", function() mode = "job_dimensions" end, true); return end
  local partialMask = normalizeChunkMask(catalog, rootKey)
  local byCoordinate, xValues, zValues, xIndex, zIndex = chunkGrid(catalog)
  local cellWidth = width >= 48 and 2 or 1
  local cols = common.clamp(math.floor((width - 3) / cellWidth), 1, math.max(1, #xValues))
  local rows = common.clamp(height - (verticalStep == 2 and 11 or 8), 1, math.max(1, #zValues))
  draft.gridPageX = common.clamp(draft.gridPageX or 1, 1, math.max(1, #xValues - cols + 1))
  draft.gridPageZ = common.clamp(draft.gridPageZ or 1, 1, math.max(1, #zValues - rows + 1))
  local pageX, pageZ = draft.gridPageX, draft.gridPageZ
  common.writeAt(1, 2, common.fit(("%s chunks cx=%s..%s cz=%s..%s | %s"):format(chunkMode, tostring(xValues[pageX] or "-"), tostring(xValues[math.min(#xValues, pageX + cols - 1)] or "-"), tostring(zValues[pageZ] or "-"), tostring(zValues[math.min(#zValues, pageZ + rows - 1)] or "-"), draft.rectMode and (draft.rectStart and "RECT: second point" or "RECT: first point") or "tap toggles mining"), width), colors and colors.lightGray or nil)
  for row = 0, rows - 1 do
    local cz = zValues[pageZ + row]
    for col = 0, cols - 1 do
      local cx = xValues[pageX + col]
      local chunk = cx and cz and byCoordinate[tostring(cx) .. ":" .. tostring(cz)] or nil
      if chunk then
      local locked = chunk.key == rootKey
      local excluded = draft.excluded and draft.excluded[chunk.key] == true
      local glyph = locked and "E" or excluded and "X" or "."
      local fg = locked and (colors and colors.black or nil) or excluded and (colors and colors.white or nil) or (colors and colors.lime or nil)
      local bg = locked and (colors and colors.yellow or nil) or excluded and (colors and colors.red or nil) or (colors and colors.green or nil)
      local px, py = 2 + col * cellWidth, 4 + row
      common.writeAt(px, py, common.center(glyph, cellWidth), fg, bg)
      addHitbox(key, px, py, px + cellWidth - 1, py, function() toggleChunk(chunk, catalog, rootKey) end)
      end
    end
  end
  local _, excluded = draftCells(catalog, rootKey)
  local buttonTop = math.max(1, height - verticalStep * 2 - 1)
  local gridSummaryY = math.max(3, buttonTop - (verticalStep == 1 and 2 or 2))
  common.writeAt(1, gridSummaryY, common.fit(("Mining chunks: %d/%d | E locked | page %d,%d%s"):format(#catalog - excluded, #catalog, pageX, pageZ, partialMask and " | legacy partial mask" or ""), width), partialMask and (colors and colors.red or nil) or (colors and colors.lightGray or nil))
  buttonRow(key, buttonTop, width, {
    { "ALL", function() allGrid(true) end }, { "CLEAR", function() allGrid(false) end }, { "INVERT", invertGrid }, { "RECT", function() draft.rectMode = not draft.rectMode; draft.rectStart = nil; invalidate() end },
  }, verticalStep == 2)
  buttonRow(key, buttonTop + verticalStep, width, {
    { "<X", function() draft.gridPageX = math.max(1, draft.gridPageX - cols) end, pageX > 1 }, { "X>", function() draft.gridPageX = math.min(math.max(1, #xValues - cols + 1), draft.gridPageX + cols) end, pageX + cols <= #xValues },
    { "<Z", function() draft.gridPageZ = math.max(1, draft.gridPageZ - rows) end, pageZ > 1 }, { "Z>", function() draft.gridPageZ = math.min(math.max(1, #zValues - rows + 1), draft.gridPageZ + rows) end, pageZ + rows <= #zValues },
  }, verticalStep == 2)
  buttonRow(key, buttonTop + verticalStep * 2, width, {
    { "BACK", function() mode = "job_dimensions" end },
    { "PREFLIGHT", function() local result = computePreflight(); if result then mode = "preflight" end end },
    { "START", function() local result = computePreflight(); if result then mode = "preflight" end end },
  }, verticalStep == 2)
  noticeLine(target, height)
end

local function renderChunks(target, key)
  -- Compatibility alias for bookmarks and keyboard users from V2.  V4's grid
  -- is the primary selector; chunk rows remain useful on tiny monitors.
  renderGrid(target, key)
end

local function renderPreflight(target, key)
  local width, height = target.getSize()
  local result = draft and draft.preflight or computePreflight()
  writeHeader("START PREFLIGHT", target, colors and colors.orange or nil)
  if not result then
    common.writeAt(1, 3, common.fit("Preflight unavailable.", width), colors and colors.red or nil)
  else
    common.writeAt(1, 2, common.fit(("cells=%s blocks=%s fuel~%s chunks=%d/%d exclusions=%d"):format(common.humanNumber(result.cells or 0), common.humanNumber(result.blocks or 0), tostring(result.fuel), result.selectedChunks or 0, result.totalChunks or result.chunks or 0, result.exclusions or 0), width), colors and colors.lightGray or nil)
    common.writeAt(1, 3, common.fit(("profile=%s torchInterval=%s requested=%s fuelMargin=%.1fx"):format(tostring(result.profile or "invalid"), tostring(result.effectiveInterval or "-"), tostring(result.requestedInterval or "-"), tonumber(result.fuelMultiplier) or 1), width), colors and colors.lightGray or nil)
    local max = math.max(1, height - 7)
    for index, check in ipairs(result.checks or {}) do
      if index > max then break end
      local line = ("[%s] %-13s %s"):format(statusGlyph(check.state), check.name, tostring(check.detail or ""))
      local fg = check.state == "bad" and (colors and colors.red or nil) or check.state == "warn" and (colors and colors.yellow or nil) or (colors and colors.lime or nil)
      common.writeAt(1, 3 + index, common.fit(line, width), fg)
    end
  end
  local canStart = result and not result.fatal
  buttonRow(key, math.max(1, height - 2), width, {
    { "START", function() if canStart then startDraft() end end, canStart },
    { "QUEUE", function() queueDraft() end, canStart and config.queueEnabled ~= false },
    { "BACK", function() mode = "job_grid" end, true },
    { "CANCEL", function() mode, draft = "dashboard", nil end, true },
  })
  noticeLine(target, height)
end

local function progressChunkState(data, chunk, index, excludedSet)
  local job = data and data.job
  if not job then return "unknown" end
  local progress = data.progress or {}
  local map = progress.map or (data.report and data.report.map)
  local explicit = type(map) == "table" and (map[chunk.key] or map[tostring(chunk.cx) .. ":" .. tostring(chunk.cz)] or map[tostring(chunk.cx) .. "," .. tostring(chunk.cz)])
  if explicit then
    local state = tostring(explicit)
    if state == "completed" then state = "complete" elseif state == "waiting" or state == "service_requested" then state = "service" end
    return state
  end
  if excludedSet[chunk.key] then return "excluded" end
  if data.status == "blocked" then return "blocked" end
  if data.status == "waiting_fuel" or data.status == "waiting_output" or data.status == "waiting_seal" or data.phase == "service_requested" then return "service" end
  local current = progress.currentChunk or job.currentChunk
  if current and tostring(current) == tostring(chunk.key) then return data.status == "blocked" and "blocked" or "working" end
  local completed = tonumber(progress.completedChunks or job.completedChunks)
  if completed and index <= completed then return "complete" end
  if not completed then
    local cursor = tonumber(progress.cursor or job.cursor)
    local depth = math.max(1, tonumber(job.depth) or 1)
    if cursor then
      local startBlock = (index - 1) * math.max(1, tonumber(chunk.cells) or 1) * depth
      local endBlock = startBlock + math.max(1, tonumber(chunk.cells) or 1) * depth
      if cursor >= endBlock then return "complete" elseif cursor > startBlock then return "working" end
    end
  end
  if progress.cursor == nil and job.cursor == nil then return "unknown" end
  return "queued"
end

local progressColors = { unknown = "gray", queued = "blue", working = "yellow", complete = "green", excluded = "red", blocked = "red", service = "orange" }
local function renderProgress(target, key)
  local width, height = target.getSize()
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
  writeHeader("WORK PROGRESS MAP", target)
  common.writeAt(1, 2, common.fit(("#%s %s %s"):format(tostring(id or "-"), worker and workerLabel(worker, id) or "-", progressText(data)), width), colors and colors.lightGray or nil)
  local job = data.job
  if not job then
    common.writeAt(1, 4, common.fit("No active job (old worker may only expose status).", width), colors and colors.yellow or nil)
  else
    local chunkMode = job.chunkMode == "world" and "world" or "local"
    local calibration = data.gps and data.gps.calibration
    local catalog, catalogError = quarry.buildCatalog(job.width, job.length, chunkMode, calibration)
    if not catalog then
      common.writeAt(1, 4, common.fit("Chunk map unavailable: " .. tostring(catalogError), width), colors and colors.yellow or nil)
      buttonRow(key, math.max(1, height - 2), width, { { "BACK", function() mode = "dashboard" end } })
      noticeLine(target, height)
      return
    end
    local excludedSet = {}
    for _, exclusion in ipairs(type(job.excludedChunks) == "table" and job.excludedChunks or {}) do
      if type(exclusion) == "table" and tonumber(exclusion.cx) and tonumber(exclusion.cz) then
        local exclusionKey = quarry.chunkKey(chunkMode, math.floor(exclusion.cx), math.floor(exclusion.cz))
        excludedSet[exclusionKey] = true
      elseif type(exclusion) == "string" then excludedSet[exclusion] = true end
    end
    local byCoordinate, xValues, zValues = chunkGrid(catalog)
    local cellWidth = width >= 48 and 2 or 1
    local cols = common.clamp(math.floor((width - 3) / cellWidth), 1, math.max(1, #xValues))
    local rows = common.clamp(height - 8, 1, math.max(1, #zValues))
    for row = 0, rows - 1 do
      local cz = zValues[row + 1]
      for col = 0, cols - 1 do
        local cx = xValues[col + 1]
        local chunk = cx and cz and byCoordinate[tostring(cx) .. ":" .. tostring(cz)] or nil
        if chunk then
        local state = progressChunkState(data, chunk, row * cols + col + 1, excludedSet)
        local bg = colors and colors[progressColors[state] or "gray"] or nil
        local glyph = ({ unknown = "?", queued = "Q", working = "W", complete = "+", excluded = "X", blocked = "B", service = "S" })[state] or "?"
        local px, py = 2 + col * cellWidth, 4 + row
        common.writeAt(px, py, common.center(glyph, cellWidth), colors and colors.white or nil, bg)
        end
      end
    end
    common.writeAt(1, math.max(3, height - 5), common.fit("? unknown Q queued W working + complete X excluded B blocked S service (one tile=one chunk)", width), colors and colors.lightGray or nil)
  end
  buttonRow(key, math.max(1, height - 2), width, {
    { "STOP", function() mode = "stop_menu" end }, { "REFRESH", function() invalidate() end }, { "BACK", function() mode = "dashboard" end },
  })
  noticeLine(target, height)
end

local function renderStopMenu(target, key)
  local width, height = target.getSize()
  local verticalStep = height >= 10 and 2 or 1
  writeHeader("STAGED STOP", target, colors and colors.orange or nil)
  common.writeAt(1, 2, common.fit("Select a boundary; payload is command=stop, mode=...", width), colors and colors.lightGray or nil)
  local id = selectedWorker()
  local function action(stopMode, message)
    return function() setNotice(message, false); stageStop(id, stopMode); mode = "dashboard" end
  end
  buttonRow(key, 4, width, { { "PAUSE NOW", action("pause_now", "Pause requested now.") }, { "FINISH ROW", action("finish_row", "Finish current row then stop.") } }, verticalStep == 2)
  buttonRow(key, 4 + verticalStep, width, { { "FINISH LAYER", action("finish_layer", "Finish current layer then stop.") }, { "RETURN HOME", action("return_home", "Return-home stop requested.") } }, verticalStep == 2)
  buttonRow(key, math.max(4 + verticalStep * 2, height - 2), width, { { "ABORT", action("abort", "Abort requested.") }, { "BACK", function() mode = "dashboard" end } }, verticalStep == 2)
  noticeLine(target, height)
end

local function renderRecovery(target, key)
  local width, height = target.getSize()
  local verticalStep = height >= 9 and 2 or 1
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
  writeHeader("RECOVERY WIZARD", target, colors and colors.red or nil)
  local explanation = data.lastError or (data.pendingAction and ("Pending action: " .. tostring(data.pendingAction.kind)) or "Worker needs recovery.")
  common.writeAt(1, 2, common.fit("State: " .. tostring(data.status or "unknown") .. " / " .. tostring(data.phase or "-"), width), colors and colors.yellow or nil)
  common.writeAt(1, 3, common.fit(explanation, width), colors and colors.white or nil)
  buttonRow(key, 5, width, { { "GPS FIX", function() recoveryAction("gps_fix") end }, { "RETRY", function() recoveryAction("retry") end }, { "RESUME", function() recoveryAction("resume") end } }, verticalStep == 2)
  buttonRow(key, 5 + verticalStep, width, { { "RETURN", function() recoveryAction("return") end }, { "REHOME RESET", function() recoveryAction("rehome") end }, { "BACK", function() mode = "dashboard" end } }, verticalStep == 2)
  noticeLine(target, height)
end

local function renderInfo(target, key)
  local width, height = target.getSize()
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
  writeHeader("WORKER DETAILS", target)
  if not id or not worker then common.writeAt(1, 3, common.fit("No worker selected.", width), colors and colors.red or nil)
  else
    local lines = {
      ("ID: %s  Name: %s"):format(tostring(id), workerLabel(worker, id)),
      ("Status: %s / %s"):format(statusOf(worker), tostring(data.phase or "-")),
      data.pose and ("Local pose: x=%s y=%s z=%s dir=%s"):format(data.pose.x, data.pose.y, data.pose.z, data.pose.dir) or "Local pose: -",
      data.world and ("GPS world: %s, %s, %s"):format(data.world.x, data.world.y, data.world.z) or "GPS world: no fix",
      ("GPS: %s / %s"):format(data.gps and data.gps.calibrated and "calibrated" or "uncalibrated", data.gps and data.gps.available and "available" or "unavailable"),
      ("Fuel: %s / %s"):format(tostring(data.fuel or "-"), tostring(data.fuelLimit or "-")),
      ("Inventory: %s used, %s empty, %s items"):format(tostring(data.inventoryUsed or "-"), tostring(data.inventoryEmpty or "-"), tostring(data.inventoryItems or "-")),
      ("Materials: seal=%s water=%s"):format(tostring(data.materials and data.materials.seal or data.seal and data.seal.count or "-"), tostring(data.materials and data.materials.water or "-")),
    }
      if data.job then lines[#lines + 1] = ("Job: %s (%dx%dx%d) [%s]"):format(tostring(data.job.name), data.job.width, data.job.length, data.job.depth, tostring(data.job.strategy or "-")); lines[#lines + 1] = "Progress: " .. progressText(data) end
      if data.lastError then lines[#lines + 1] = "Error: " .. tostring(data.lastError) end
      if data.completionReason then lines[#lines + 1] = "Completion: " .. tostring(data.completionReason) end
      if data.report or data.stats then
        local report = data.report or data.stats
        local discard = report.discard or report.discardCount or "-"
        if type(discard) == "table" then discard = tostring(discard.count or discard.total or common.tableCount(discard)) end
        lines[#lines + 1] = ("Metrics: blocks=%s fuel=%s discard=%s"):format(tostring(report.blocks or report.totalBlocks or "-"), tostring(report.fuel or "-"), tostring(discard))
      end
    for index, line in ipairs(lines) do if index + 2 >= height - 1 then break end; common.writeAt(1, index + 2, common.fit(line, width), colors and colors.white or nil) end
  end
  drawButton(key, 1, math.max(1, height - 1), width, "BACK", function() mode = "dashboard" end, true)
end

local function renderReport(target, key)
  local width, height = target.getSize()
  writeHeader("COMPLETION REPORT / HISTORY", target)
  local maxRows = math.max(1, height - 5)
  local count = #db.history
  if count == 0 then common.writeAt(1, 3, common.fit("No completed jobs.", width), colors and colors.lightGray or nil) end
  for row = 1, maxRows do
    local index = count - row + 1
    local item = db.history[index]
    if not item then break end
    local line = ("%s %s #%s %s %s"):format(tostring(item.finishedAt or "-"), tostring(item.status or "-"), tostring(item.workerId or "-"), tostring(item.name or item.jobId or "-"), item.reason and tostring(item.reason) or "")
    common.writeAt(1, 2 + row, common.fit(line, width), item.status == "aborted" and (colors and colors.red or nil) or (colors and colors.lime or nil))
  end
  drawButton(key, 1, math.max(1, height - 1), width, "BACK", function() mode = "dashboard" end, true)
end

local function renderConfirm(target, key)
  local width, height = target.getSize()
  writeHeader("CONFIRM COMMAND", target, colors and colors.orange or nil)
  local message = confirmState and confirmState.message or "Continue?"
  local lineWidth = math.max(10, width - 4)
  local words, lines, current = {}, {}, ""
  for word in tostring(message):gmatch("%S+") do words[#words + 1] = word end
  for _, word in ipairs(words) do
    if #current == 0 then current = word elseif #current + 1 + #word <= lineWidth then current = current .. " " .. word else lines[#lines + 1] = current; current = word end
  end
  if current ~= "" then lines[#lines + 1] = current end
  for index, line in ipairs(lines) do common.writeAt(2, math.max(3, math.floor((height - #lines) / 2) + index), common.fit(line, lineWidth), colors and colors.white or nil) end
  buttonRow(key, math.max(1, height - 2), width, {
    { "YES", function()
      if confirmState and confirmState.twoStep and not confirmState.armed then
        confirmState.armed = true; confirmState.message = "FINAL confirmation: press YES again to send REHOME RESET."; invalidate(); return
      end
      local id = selectedWorker()
      if confirmState and id then
        if confirmState.command == "stop" then stageStop(id, (confirmState.payload or {}).mode or "abort") else sendCommand(id, confirmState.command, confirmState.payload) end
      end
      confirmState, mode = nil, "dashboard"
    end },
    { "NO", function() confirmState, mode = nil, "dashboard"; setNotice("Cancelled.", false) end },
  })
end

local function screenSignature(target, key)
  local width, height = target.getSize()
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
  local gid, group = selectedGroupRecord()
  local groupJob = gid and activeGroupJob(gid) or nil
  return table.concat({ tostring(mode), tostring(key), tostring(width), tostring(height), tostring(id or ""), tostring(data.updatedAt or data.status or ""), tostring(noticeState.workerPage or ""), tostring(noticeState.morePage or ""), tostring(gid or ""), tostring(group and group.updatedAt or ""), tostring(groupJob and groupJob.updatedAt or ""), tostring(groupDraft and groupDraft.updatedAt or ""), tostring(groupDraft and groupDraft.preflight and groupDraft.preflight.computedAt or ""), tostring(draft and draft.gridPageX or ""), tostring(draft and draft.gridPageZ or ""), tostring(dirty) }, "|")
end

local function renderOne(target, key)
  local singleDraftMode = mode == "job_dimensions" or mode == "job_grid"
    or mode == "job_chunks" or mode == "preflight"
  local groupDraftMode = mode == "group_dimensions" or mode == "group_job"
  if (singleDraftMode and type(draft) ~= "table")
    or (groupDraftMode and type(groupDraft) ~= "table") then
    mode = "dashboard"
    setNotice("The unfinished job form was reset safely. Open NEW JOB again.", true)
  end
  resetHitboxes(key)
  local signature = screenSignature(target, key)
  if renderCache[key] == signature and not dirty then return end
  common.withTerm(target, function()
    common.clear(colors and colors.black or nil, colors and colors.white or nil)
    if mode == "dashboard" then renderDashboard(target, key)
    elseif mode == "workers" then noticeState.renderWorkers(target, key)
    elseif mode == "more" then noticeState.renderMore(target, key)
    elseif mode == "items" then noticeState.renderItems(target, key)
    elseif mode == "groups" then renderGroups(target, key)
    elseif mode == "group_info" then renderGroupInfo(target, key)
    elseif mode == "group_dimensions" or mode == "group_job" then renderGroupDimensions(target, key)
    elseif mode == "job_dimensions" then renderDimensions(target, key)
    elseif mode == "job_grid" or mode == "job_chunks" then renderGrid(target, key)
    elseif mode == "preflight" then renderPreflight(target, key)
    elseif mode == "progress" then renderProgress(target, key)
    elseif mode == "stop_menu" then renderStopMenu(target, key)
    elseif mode == "recovery" then renderRecovery(target, key)
    elseif mode == "info" then renderInfo(target, key)
    elseif mode == "report" then renderReport(target, key)
    elseif mode == "confirm" then renderConfirm(target, key)
    elseif mode == "error_detail" then renderErrorDetail(target, key)
    else mode = "dashboard"; renderDashboard(target, key) end
  end)
  renderCache[key] = signature
end

local function render()
  if not dirty then return end
  renderOne(term.current(), "term")
  for _, entry in ipairs(monitors) do renderOne(entry.device, entry.name) end
  dirty = false
end

local function handlePointer(key, x, y)
  local boxes = hitboxes[key] or {}
  for index = #boxes, 1, -1 do
    local box = boxes[index]
    if x >= box.x1 and x <= box.x2 and y >= box.y1 and y <= box.y2 then box.action(); invalidate(); return true end
  end
  return false
end
