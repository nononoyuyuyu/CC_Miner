  local prepared, prepareError = beginPhysicalAction("torch_wall", {
    side = relativeDir, material = itemName(slot), pose = poseCopy(),
  }, poseCopy())
  if not prepared then return restoreContext(prepareError) end
  local placed, placeError = turtle.place()
  if placed then
    state.stats.torchesPlaced = (state.stats.torchesPlaced or 0) + 1
    state.lighting.placed = (state.lighting.placed or 0) + 1
    state.lighting.torchesPlaced = (state.lighting.torchesPlaced or 0) + 1
    commitPhysicalAction()
  else
    cancelPhysicalAction()
  end
  turtle.select(originalSlot)
  local restored, restoreError = turnTo(originalDir)
  if not restored then return false, restoreError end
  if not placed then return false, placeError or "torch_wall_failed" end
  state.lighting.lastAt = common.nowSeconds()
  state.lighting.lastPose = poseCopy()
  return true
end

local function tryPlaceTorchFloor()
  local originalSlot = turtle.getSelectedSlot()
  local slot = selectTorchMaterial()
  if not slot then turtle.select(originalSlot); return false, "torch_material" end
  -- placeDown is used only when the adjacent block is empty; this avoids
  -- replacing a floor block and makes the fallback deterministic.
  local hasBlock = turtle.inspectDown()
  if hasBlock then turtle.select(originalSlot); return false, "occupied" end
  local prepared, prepareError = beginPhysicalAction("torch_floor", {
    side = "bottom", material = itemName(slot), pose = poseCopy(),
  }, poseCopy())
  if not prepared then turtle.select(originalSlot); return false, prepareError end
  local placed, placeError = turtle.placeDown()
  if placed then
    state.stats.torchesPlaced = (state.stats.torchesPlaced or 0) + 1
    state.lighting.placed = (state.lighting.placed or 0) + 1
    state.lighting.torchesPlaced = (state.lighting.torchesPlaced or 0) + 1
    commitPhysicalAction()
  else
    cancelPhysicalAction()
  end
  turtle.select(originalSlot)
  if not placed then return false, placeError or "torch_floor_failed" end
  state.lighting.lastAt = common.nowSeconds()
  state.lighting.lastPose = poseCopy()
  return true
end

local function maybePlaceTorch(context)
  if context ~= "mining" then return true end
  if isHome() then return true end
  local mode, interval = effectiveLighting()
  if mode == "off" then return true end
  local moves = tonumber(state.stats.moves) or 0
  if moves <= 0 or moves % interval ~= 0 then return true end
  if torchMaterialCount() <= 0 then
    state.stats.torchShortages = (state.stats.torchShortages or 0) + 1
    state.lighting.shortages = (state.lighting.shortages or 0) + 1
    return false, "torch_material"
  end
  -- Deterministic wall order: right, left, front, then floor.  Safe mode
  -- omits the floor fallback; custom mode permits it when walls are absent.
  local failureReason = nil
  for _, relativeDir in ipairs({ 1, 3, 0 }) do
    local placed, reason = tryPlaceTorchWall(relativeDir)
    if placed then return true end
    failureReason = reason or failureReason
    if reason ~= "occupied" and reason ~= "torch_wall_failed" then
      if reason == "torch_material" or reason == "inventory_full" then return false, reason end
    end
  end
  local lighting = config.lighting or {}
  if mode == "custom" and lighting.temporaryFloor == true then
    local placed, reason = tryPlaceTorchFloor()
    if placed then return true end
    if reason == "torch_material" then return false, reason end
    -- Floor placement is an optional custom fallback; inability to place it
    -- must not turn a navigable route into a hard failure.
    return true
  end
  if failureReason == "occupied" or failureReason == "torch_wall_failed" then
    return false, "torch_surface_unavailable"
  end
  return false, failureReason or "torch_surface_unavailable"
end

local function moveOne(direction, context)
  local action = movement[direction]
  if not action then return false, "Unknown movement: " .. tostring(direction) end
  local retries = tonumber(config.moveRetries) or 20
  local retryDelay = tonumber(config.moveRetryDelay) or 0.4
  local lastReason = "Movement failed."

  for _ = 1, retries do
    drainNetwork(3)
    if movementInterrupted(context) then return false, "control_request" end

    local lit, lightError = maybePlaceTorch(context)
    if not lit then return false, lightError end

    local level = fuelLevel()
    if level ~= "unlimited" and tonumber(level or 0) <= 0 then return false, "out_of_fuel" end

    local hasBlock, data = action.inspect()
    local preserveSealMarker = false
    if hasBlock then
      local protected, name = isProtected(data)
      if protected then return false, "protected:" .. name, data end
      if isInventoryBlock(action.side, data) then return false, "protected_inventory:" .. name, data end
      if isWater(data) then
        state.stats.waterDetected = (state.stats.waterDetected or 0) + 1
        state.water.detected = (state.water.detected or 0) + 1
        state.water.last = { kind = "water", name = name, direction = direction, pose = poseCopy() }
        local mode = waterMode()
        if mode == "ignore" then
          -- Water is intentionally left to the turtle's normal movement/dig
          -- retry path.  This preserves legacy behaviour for worlds where
          -- water can be traversed without placing a seal.
          state.water.lastRun = 0
          state.fluidSealRun = 0
          state.water.continuousSeals = 0
          state.stats.waterIgnored = (state.stats.waterIgnored or 0) + 1
          state.water.ignored = (state.water.ignored or 0) + 1
        else
          local sealed, sealError = sealFluid(action, direction, data, "water")
          if not sealed then return false, sealError, data end
        end
      elseif isLava(data) then
        state.water.lastRun = 0
        local sealed, sealError = sealLava(action, direction, data)
        if not sealed then return false, sealError, data end
      else
        local marker = state.fluidSealMarker
        preserveSealMarker = marker and (tonumber(state.fluidSealRun) or 0) > 0
          and marker.direction == direction
          and marker.material == name
          and samePosePosition(marker.pose, state.pose)
        state.water.lastRun = 0
        if not preserveSealMarker then
          state.fluidSealRun = 0
          state.water.continuousSeals = 0
          state.fluidSealMarker = nil
        end
        local _, emptySlots = inventoryStats()
        if emptySlots <= 0 then return false, "inventory_full" end
        local prepared, prepareError = beginPhysicalAction("dig_" .. direction, { block = name }, poseCopy())
        if not prepared then return false, prepareError end
]] },
  { target = [[worker_parts/03.part]], content = [=[        local dug, digReason = action.dig()
        if dug then
          state.stats.blocksDug = (state.stats.blocksDug or 0) + 1
          if not preserveSealMarker then noteMinedMaterial(name) end
          commitPhysicalAction()
          sleep(0.1)
        else
          cancelPhysicalAction()
          lastReason = digReason or ("Cannot dig " .. name)
          sleep(retryDelay)
        end
      end
    end

    local after = geo.poseAfterMove(state.pose, direction)
    local prepared, prepareError = beginPhysicalAction("move_" .. direction, nil, after)
    if not prepared then return false, prepareError end
    local moved, moveReason = action.move()
    if moved then
      updatePoseAfterMove(direction)
      -- A successful move normally ends a fluid-seal run.  When the moved
      -- block was the seal marker we just carved, preserve the run so a
      -- contiguous fluid column reaches maxContinuousSeal across cells.
      if preserveSealMarker then
        state.fluidSealMarker = nil
      else
        state.fluidSealRun = 0
        state.water.continuousSeals = 0
        state.fluidSealMarker = nil
      end
      local gpsOK, gpsError = verifyGPS(false)
      if not gpsOK then return false, gpsError end
      commitPhysicalAction()
      heartbeat(false)
      return true
    end
    cancelPhysicalAction()
    lastReason = moveReason or lastReason
    local blockedNow = action.inspect()
    if not blockedNow then
      if config.attackEntities and action.attack then pcall(action.attack) end
      sleep(retryDelay)
    else
      sleep(0.1)
    end
  end
  return false, lastReason
end

local function moveX(targetX, context)
  while state.pose.x ~= targetX do
    local targetDir = state.pose.x < targetX and 1 or 3
    local ok, err = turnTo(targetDir)
    if not ok then return false, err end
    ok, err = moveOne("forward", context)
    if not ok then return false, err end
  end
  return true
end

local function moveZ(targetZ, context)
  while state.pose.z ~= targetZ do
    local targetDir = state.pose.z < targetZ and 0 or 2
    local ok, err = turnTo(targetDir)
    if not ok then return false, err end
    ok, err = moveOne("forward", context)
    if not ok then return false, err end
  end
  return true
end

local function moveY(targetY, context)
  while state.pose.y < targetY do
    local ok, err = moveOne("up", context)
    if not ok then return false, err end
  end
  while state.pose.y > targetY do
    local ok, err = moveOne("down", context)
    if not ok then return false, err end
  end
  return true
end

local function navigateTo(target, route, context)
  target = target or { x = 0, y = 0, z = 0 }
  local ok, err
  if route == "home" then
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
  elseif route == "inside" then
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
  else
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
  end
  return true
end

local function chunkAnchor(plan, key, y)
  local chunk = plan and plan.chunks and plan.chunks[key]
  if not chunk then return nil, "Unknown chunk " .. tostring(key) end
  return { x = chunk.anchor.x, y = y, z = chunk.anchor.z }
end

local function moveBetweenChunkAnchors(plan, fromKey, toKey, y, context)
  local from = plan.chunks[fromKey]
  local target, err = chunkAnchor(plan, toKey, y)
  if not from or not target then return false, err or "Missing chunk anchor." end
  local adjacent = false
  for _, key in ipairs(from.neighbors or {}) do if key == toKey then adjacent = true; break end end
  if not adjacent then return false, "Chunk route is not adjacent: " .. tostring(fromKey) .. " -> " .. tostring(toKey) end
  return navigateTo(target, "inside", context)
end

local function navigateChunkPlanHome(context)
  local plan = state.job and state.job.chunkPlan
  if not plan then return navigateTo({ x = 0, y = 0, z = 0 }, "home", context) end
  if isHome() then return true end
  local currentKey = quarry.findChunk(plan, state.pose.x, state.pose.z)
  if not currentKey then return false, "Current position is outside every allowed chunk." end
  local currentAnchor = chunkAnchor(plan, currentKey, state.pose.y)
  local ok, err = navigateTo(currentAnchor, "inside", context)
  if not ok then return false, err end
  local path, pathError = quarry.pathToRoot(plan, currentKey)
  if not path then return false, pathError end
  for index = 2, #path do
    ok, err = moveBetweenChunkAnchors(plan, path[index - 1], path[index], state.pose.y, context)
    if not ok then return false, err end
  end
  ok, err = moveY(0, context); if not ok then return false, err end
  local rootAnchor = chunkAnchor(plan, plan.rootKey, 0)
