    if movementInterrupted("service") then
      restoreSideDirection(side, restoreDir)
      turtle.select(originalSlot)
      return false, "control_request"
    end
    attempts = attempts + 1
    if attempts > 64 then
      restoreSideDirection(side, restoreDir)
      turtle.select(originalSlot)
]=] },
  { target = [[worker_parts/04.part]], content = [[      return false, "Seal-block loading safety limit reached."
    end
    local slot = refillSlotForSeal()
    if not slot then
      restoreSideDirection(side, restoreDir)
