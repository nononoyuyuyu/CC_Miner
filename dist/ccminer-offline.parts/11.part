  state.water.mode = job.waterMode or config.waterMode or (config.water and config.water.mode) or "ignore"
  state.pose = { x = 0, y = 0, z = 0, dir = state.pose.dir or 0 }
  saveState()
  common.log("INFO", ("Job started: %s %dx%dx%d strategy=%s exclusions=%d"):format(
    job.id, job.width, job.length, job.depth, job.strategy, #job.excludedChunks
  ))
  return true, "Job accepted."
end

local function calibrateGPS()
  if state.pendingAction then return false, "Resolve the pending physical action first." end
  if not isHome() or state.pose.dir ~= 0 then return false, "Place the turtle at home facing the quarry before GPS calibration." end
  if state.job then return false, "Clear the active job before GPS calibration." end
  if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" then
    return false, "Worker must be stopped before GPS calibration."
  end
  if fuelLevel() ~= "unlimited" and tonumber(fuelLevel() or 0) < 2 then return false, "At least 2 fuel is required." end
]] },
  { target = [[worker_parts/02.part]], content = [[  local blocked = turtle.inspect()
  if blocked then return false, "The block directly in front of the dock must be empty for calibration." end

  state.status, state.phase, state.lastError = "calibrating", "gps_calibration", nil
  saveState()
  local homeFix, homeError = locateGPS()
  if not homeFix then
    state.status, state.phase = "blocked", "gps_error"
    state.lastError = homeError
    saveState()
    return false, homeError
  end

  local prepared, prepareError = beginPhysicalAction("gps_calibration", { home = homeFix })
  if not prepared then return false, prepareError end
  local moved, moveError = turtle.forward()
  if not moved then
    cancelPhysicalAction()
    state.status, state.phase, state.lastError = "blocked", "gps_error", moveError or "Calibration move failed."
    saveState()
    return false, state.lastError
  end
  sleep(0.15)
  local forwardFix, forwardError = locateGPS()
  local returned, returnError = turtle.back()
  if not returned then
    state.status, state.phase = "blocked", "recovery_required"
    state.lastError = "GPS calibration moved forward but could not return: " .. tostring(returnError)
    saveState()
    return false, state.lastError
  end
  if not forwardFix then
    cancelPhysicalAction()
    state.status, state.phase, state.lastError = "blocked", "gps_error", forwardError
    saveState()
    return false, forwardError
  end

  local calibration, calibrationError = geo.calibrationFromFixes(homeFix, forwardFix)
  if not calibration then
    cancelPhysicalAction()
    state.status, state.phase, state.lastError = "blocked", "gps_error", calibrationError
    saveState()
    return false, calibrationError
  end
  config.gps = config.gps or {}
  config.gps.enabled = true
  config.gps.calibration = calibration
  local saved, saveError = common.saveConfig(config)
  if not saved then
    cancelPhysicalAction()
    state.status, state.phase = "blocked", "gps_error"
    state.lastError = "Could not save GPS calibration: " .. tostring(saveError)
    saveState()
    return false, state.lastError
  end
  state.gps.available = true
  state.gps.lastFix = homeFix
  state.gps.lastFixAt = common.nowSeconds()
  state.gps.lastError = nil
  state.status, state.phase, state.lastError = "idle", "home", nil
  commitPhysicalAction()
  common.log("INFO", ("GPS calibrated at %d,%d,%d forward=%d,%d"):format(
    homeFix.x, homeFix.y, homeFix.z, calibration.forward.x, calibration.forward.z
  ))
  return true, "GPS calibrated."
end

local function applyControlCommand(command, payload)
  payload = payload or {}
  if command == "pause_now" or command == "finish_row" or command == "finish_layer" or command == "return_home" then
    payload.mode = command
    command = "stop"
  end
  if state.pendingAction and command ~= "rehome" and command ~= "ping" and command ~= "status" and command ~= "gps_fix" then
    return false, "Recovery required: return the turtle to its dock and use REHOME, or reboot with working GPS recovery."
  end
  if command == "start" then
    return startJob(payload)
  elseif command == "stop" then
    if not state.job then return false, "No active job." end
    local mode = tostring(payload.mode or "pause_now")
    local allowed = {
      pause_now = true, finish_row = true, finish_layer = true,
      return_home = true, abort = true,
    }
    if not allowed[mode] then return false, "Unknown staged stop mode: " .. mode end
    state.stagedStop = {
      mode = mode,
      requestedAt = common.nowSeconds(),
      requestedBy = payload.requestedBy and tostring(payload.requestedBy) or nil,
      source = "stop",
    }
    if mode == "pause_now" then
      state.request = "pause_now"
      if state.status ~= "working" then state.status = "working" end
    elseif mode == "return_home" or mode == "abort" then
      state.request = mode
      if mode == "abort" then state.completionReason = "aborted" end
      if state.status ~= "working" then state.status = "working" end
    elseif state.status ~= "working" then
      state.status = "working"
    end
    saveState("stop_" .. mode)
    return true, "Staged stop accepted: " .. mode
  elseif command == "pause" then
    if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
      state.stagedStop = { mode = "pause_now", requestedAt = common.nowSeconds(), source = "pause" }
      state.request = "pause_now"
      if state.status ~= "working" then state.status = "working" end
      saveState("pause")
      return true, "Pause accepted; stopping at the next safe boundary."
    end
    return false, "Worker is not running."
  elseif command == "resume" then
    if state.status == "paused" or state.status == "blocked" then
      if state.status == "blocked" then
        local criticalPhase = {
          state_corrupt = true,
          gps_drift = true,
          recovery_required = true,
          gps_error = true,
        }
        if criticalPhase[tostring(state.phase or "")] then
          return false, "Cannot resume from " .. tostring(state.phase) .. "; resolve GPS/state recovery or use REHOME first."
        end
      end
      state.lastError = nil
      state.stagedStop = false
      if state.service then
        state.status, state.phase = "working", "service_requested"
      elseif isHome() and state.checkpoint and state.job then
        state.service = { resumeAfter = true, finalStatus = "working", preserveCheckpoint = false, reason = "resume" }
        state.status, state.phase = "working", "resume_service"
      else
        state.status, state.phase = "working", "mining"
      end
      state.request = nil
      saveState()
      return true, "Resume accepted."
    elseif state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
      state.status = "working"
      saveState()
      return true, "Service retry accepted."
    end
    return false, "Worker is not paused or blocked."
  elseif command == "recall" then
    if not state.job then return false, "No active job." end
    state.request = "recall"
    state.stagedStop = { mode = "return_home", requestedAt = common.nowSeconds(), source = "recall" }
    if state.status ~= "working" then state.status = "working" end
    saveState()
    return true, "Recall accepted. Worker will return and pause."
  elseif command == "service" then
    if not state.job then return false, "No active job." end
    state.request = "service"
    if state.status ~= "working" then state.status = "working" end
    saveState()
    return true, "Service return accepted."
  elseif command == "abort" then
    if not state.job then return false, "No job to abort." end
    state.request = "abort"
    state.completionReason = "aborted"
    state.stagedStop = { mode = "abort", requestedAt = common.nowSeconds(), source = "abort" }
    if state.status ~= "working" then state.status = "working" end
    saveState()
    return true, "Abort accepted. Worker will return home."
  elseif command == "clear" then
    if state.pendingAction then return false, "Cannot clear while physical position is uncertain." end
    if not isHome() then return false, "Worker must be at home." end
    if state.job and state.status ~= "complete" and state.status ~= "aborted" then
      return false, "Cannot clear an unfinished job; ABORT it first."
    end
    if not state.job and state.status ~= "idle" then
      return false, "No clearable job record exists in the current state."
    end
    if state.service or state.request then
      return false, "Cannot clear while service or a control request is pending."
    end
    if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
      return false, "Worker is busy."
    end
    state.job, state.checkpoint, state.service, state.request = nil, nil, nil, nil
    state.stagedStop = false
    state.status, state.phase, state.lastError, state.completionReason = "idle", "home", nil, nil
    saveState()
    return true, "Job record cleared."
  elseif command == "calibrate_gps" then
    return calibrateGPS()
  elseif command == "gps_fix" then
    local fix, err = locateGPS()
    saveState()
    if not fix then return false, err end
    local verified, verifyError = verifyGPS(true)
    if not verified then return false, verifyError end
    return true, ("GPS fix: %d,%d,%d"):format(fix.x, fix.y, fix.z)
  elseif command == "rehome" then
    if payload.confirm ~= "RESET" then return false, "Rehome requires confirm=RESET." end
    if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
      return false, "Stop the worker before rehoming."
    end
    local calibration = gpsCalibration()
    if calibration then
      local fix, fixError = locateGPS()
      if not fix then
        return false, "GPS fix is required to verify the calibrated dock before REHOME: " .. tostring(fixError)
      end
      local expected = geo.localToWorld(calibration, { x = 0, y = 0, z = 0 })
      if not geo.samePosition(fix, expected) then
        return false, ("GPS says the turtle is at %d,%d,%d, not the calibrated dock %d,%d,%d."):format(
          fix.x, fix.y, fix.z, expected.x, expected.y, expected.z
        )
      end
    end
    state.pose = { x = 0, y = 0, z = 0, dir = 0 }
    state.job, state.checkpoint, state.service, state.request, state.pendingAction = nil, nil, nil, nil, nil
    state.status, state.phase, state.lastError, state.completionReason = "idle", "home", nil, nil
    saveState()
    return true, "Local position reset to home."
  elseif command == "ping" or command == "status" then
    return true, "Status sent."
  end
  return false, "Unknown command: " .. tostring(command)
end

local function handleMessage(sender, message)
  local valid = protocol.validate(message, config.networkKey, os.getComputerID(), sender)
  if not valid then return end
  if tonumber(config.controllerId or 0) > 0 and tonumber(sender) ~= tonumber(config.controllerId) then return end
  if message.kind == "discover" then sendStatus(sender, message); return end
  if message.kind ~= "command" then return end
  if tonumber(message.target) ~= tonumber(os.getComputerID()) then return end
  if commandSeen(message.id) then
    sendAck(sender, message, true, "Duplicate command ignored; previous result retained.")
    return
  end
  local payload = message.payload
  local command = tostring(payload.command or "")
  local ok, text = applyControlCommand(command, payload)
  sendAck(sender, message, ok, text)
