  ok, err = moveY(checkpoint.y, context); if not ok then return false, err end
  local path, pathError = quarry.pathFromRoot(plan, targetKey)
  if not path then return false, pathError end
  for index = 2, #path do
    ok, err = moveBetweenChunkAnchors(plan, path[index - 1], path[index], checkpoint.y, context)
    if not ok then return false, err end
  end
  return navigateTo(checkpoint, "inside", context)
end

local function estimatedReturnDistance(pose)
  pose = pose or state.pose
  if tonumber(pose.x) == 0 and tonumber(pose.y) == 0 and tonumber(pose.z) == 0 then return 0 end
  if not state.job or state.job.strategy ~= "chunk_plan" or not state.job.chunkPlan then
    return distance(pose, { x = 0, y = 0, z = 0 })
  end

  local plan = state.job.chunkPlan
  local currentKey = quarry.findChunk(plan, pose.x, pose.z)
  if not currentKey then return nil, "Current position is outside every allowed chunk." end
  local path, pathError = quarry.pathToRoot(plan, currentKey)
  if not path then return nil, pathError end

  local current = plan.chunks[currentKey]
  local total = math.abs(pose.x - current.anchor.x) + math.abs(pose.z - current.anchor.z)
  for index = 2, #path do
    local from, target = plan.chunks[path[index - 1]], plan.chunks[path[index]]
    if not from or not target then return nil, "Chunk return path references a missing chunk." end
    total = total + math.abs(from.anchor.x - target.anchor.x) + math.abs(from.anchor.z - target.anchor.z)
  end
  local root = plan.chunks[plan.rootKey]
  if not root then return nil, "Chunk return path has no entrance chunk." end
  total = total + math.abs(tonumber(pose.y) or 0)
  total = total + math.abs(root.anchor.x) + math.abs(root.anchor.z)
  return total
end

local function firstEmptySlot()
  for slot = 1, 16 do if not isReservedSlot(slot) and turtle.getItemCount(slot) == 0 then return slot end end
  return nil
end

local function firstFuelSlot()
  local materials = materialsConfig()
  local preferred = materials.fuelReserveSlots or config.fuelReserveSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "fuel") and turtle.getItemCount(slot) == 0 then return slot end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "fuel") and turtle.getItemCount(slot) == 0 then return slot end
  end
  return nil
end

local function looksLikeInventoryBlock(data)
  local name = string.lower(blockName(data))
  if name == "minecraft:chest" or name == "minecraft:trapped_chest" or name == "minecraft:barrel" then return true end
  return name:match("^minecraft:[%w_]+shulker_box$") ~= nil
end

local function recycleRetainTarget()
  local materials, recycle = materialsConfig()
  local target = materials.retainSealTarget
    or recycle.maxHeld
    or recycle.retainSealTarget
    or config.retainSealTarget
    or config.sealTarget
    or 64
  return math.max(0, math.floor(tonumber(target) or 64))
end

local function compressSealStacks()
  local moved = 0
  for destination = 1, 16 do
    if not isReservedSlot(destination, "seal") and turtle.getItemCount(destination) > 0 and isSealItemName(itemName(destination)) then
      local name = itemName(destination)
      local space = turtle.getItemSpace(destination)
      if space > 0 then
        for source = 1, 16 do
          if source ~= destination and not isReservedSlot(source, "seal")
            and turtle.getItemCount(source) > 0 and itemName(source) == name then
            turtle.select(source)
            local before = turtle.getItemCount(source)
            local ok = turtle.transferTo(destination, math.min(space, before))
            local after = turtle.getItemCount(source)
            if ok and after < before then
              local amount = before - after
              moved = moved + amount
              space = turtle.getItemSpace(destination)
              if space <= 0 then break end
            end
          end
        end
      end
    end
  end
  if moved > 0 then
    state.stats.compressions = (state.stats.compressions or 0) + 1
    state.recycle.compressed = (state.recycle.compressed or 0) + moved
  end
  return moved
end

local function updateRecycleInventoryState()
  local held, byName = 0, {}
  for slot = 1, 16 do
    local name = itemName(slot)
    if name and isSealItemName(name) then
      local count = turtle.getItemCount(slot)
      held = held + count
      byName[name] = (byName[name] or 0) + count
    end
  end
  state.recycle = state.recycle or {}
  state.recycle.held, state.recycle.byName = held, byName
  state.recycle.cap = recycleRetainTarget()
  state.recycle.overflow = math.max(0, held - state.recycle.cap)
  return held
end

local function inventoryPresent(side, inspectFunction)
  if peripheral and peripheral.hasType then
    local ok, result = pcall(peripheral.hasType, side, "inventory")
    if ok and result == true then return true end
  end
  local wrapped = peripheral and peripheral.wrap(side) or nil
  if wrapped and (type(wrapped.list) == "function" or type(wrapped.size) == "function") then return true end
  if inspectFunction then
    local ok, present, data = pcall(inspectFunction)
    if ok and present and looksLikeInventoryBlock(data) then return true end
  end
  return false
end

local function sideFunctions(side)
  local restoreDir = state.pose.dir
  if side == "front" then
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "back" then
    local ok, err = turnTo(2)
    if not ok then return nil, nil, nil, restoreDir, err end
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "right" then
    local ok, err = turnTo(1)
    if not ok then return nil, nil, nil, restoreDir, err end
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "left" then
    local ok, err = turnTo(3)
    if not ok then return nil, nil, nil, restoreDir, err end
    return turtle.inspect, turtle.suck, turtle.drop, restoreDir
  elseif side == "top" then
    return turtle.inspectUp, turtle.suckUp, turtle.dropUp, restoreDir
  elseif side == "bottom" then
    return turtle.inspectDown, turtle.suckDown, turtle.dropDown, restoreDir
  end
  return nil, nil, nil, restoreDir, "Unsupported inventory side: " .. tostring(side)
end

local function restoreSideDirection(side, restoreDir)
  if side == "front" or side == "back" or side == "right" or side == "left" then return turnTo(restoreDir) end
  return true
end

local function unloadAtHome()
  state.phase, state.status = "unloading", "working"
  saveState()
  local originalSlot = turtle.getSelectedSlot()
  local outputSide = config.outputSide or "back"
  local inspectFunction, _, dropFunction, restoreDir, sideError = sideFunctions(outputSide)
  if not inspectFunction then turtle.select(originalSlot); return false, sideError end
  local checkSide = (outputSide == "top" and "top") or (outputSide == "bottom" and "bottom") or "front"
  if not inventoryPresent(checkSide, inspectFunction) then
    restoreSideDirection(outputSide, restoreDir)
    turtle.select(originalSlot)
    return false, "Output inventory missing on configured side " .. outputSide .. "."
  end

  -- Reuse permitted seal blocks first.  Consolidation happens before the
  -- ordinary unload pass so stack space is deterministic and reserved slots
  -- are never used as transient output slots.
  compressSealStacks()
  local retainedTarget = recycleRetainTarget()
  local retainedCount = updateRecycleInventoryState()
  local overflow = math.max(0, retainedCount - retainedTarget)
  local allDropped = true
  for slot = 1, 16 do
    local name = itemName(slot)
    local keepReserved = isSealItemName(name) or isTorchItemName(name)
      or (slotRoleContains(slot, "fuel") and isFuelItem(slot))
    if turtle.getItemCount(slot) > 0 and not keepReserved then
      turtle.select(slot)
      dropFunction()
      if turtle.getItemCount(slot) > 0 then allDropped = false end
    end
  end
  if overflow > 0 then
    for slot = 1, 16 do
      if overflow <= 0 then break end
      if turtle.getItemCount(slot) > 0 and isSealItemName(itemName(slot))
        and (not isReservedSlot(slot, "seal") or not slotRoleContains(slot, "seal")) then
        turtle.select(slot)
        local before = turtle.getItemCount(slot)
        local dropped = dropFunction(math.min(before, overflow))
        local after = turtle.getItemCount(slot)
        local amount = before - after
        if dropped and amount > 0 then
          overflow = overflow - amount
          state.stats.sealOverflow = (state.stats.sealOverflow or 0) + amount
          state.recycle.overflow = (state.recycle.overflow or 0) + amount
        elseif after > 0 then
          allDropped = false
        end
      end
    end
  end
  local restored, restoreError = restoreSideDirection(outputSide, restoreDir)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  if not allDropped or overflow > 0 then return false, "Output inventory is full or retained seal slots are reserved." end
  updateRecycleInventoryState()
  state.stats.unloads = (state.stats.unloads or 0) + 1
  saveState()
  return true
end

local function targetFuelForService()
  local target = tonumber(config.fuelTarget) or 12000
  if state.service and state.service.resumeAfter and state.checkpoint then
    local checkpointDistance = estimatedReturnDistance(state.checkpoint)
    if not checkpointDistance then
      checkpointDistance = distance({ x = 0, y = 0, z = 0 }, state.checkpoint)
    end
    target = math.max(target, checkpointDistance * 2 + profileFuelBuffer())
  end
  local limit = fuelLimit()
  if limit == "unlimited" then return "unlimited" end
  if type(limit) == "number" and limit > 0 then target = math.min(target, limit) end
  return math.max(1, math.floor(target))
end

local function refuelAtHome()
  state.phase, state.status = "refueling", "working"
  saveState()
  local current = fuelLevel()
  if current == "unlimited" then return true end
  local target = targetFuelForService()
  local fuelSide = config.fuelSide or "top"
  local inspectFunction, suckFunction, dropFunction, restoreDir, sideError = sideFunctions(fuelSide)
  if not inspectFunction then return false, sideError end
  local checkSide = (fuelSide == "top" and "top") or (fuelSide == "bottom" and "bottom") or "front"
  if not inventoryPresent(checkSide, inspectFunction) then
    restoreSideDirection(fuelSide, restoreDir)
    return false, "Fuel inventory missing on configured side " .. fuelSide .. "."
  end
  if target == "unlimited" or current >= target then
    restoreSideDirection(fuelSide, restoreDir)
    return true
  end

  local originalSlot = turtle.getSelectedSlot()
  local attempts = 0
  while fuelLevel() ~= "unlimited" and fuelLevel() < target do
    drainNetwork(3)
    if movementInterrupted("service") then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "control_request"
    end
    attempts = attempts + 1
    if attempts > 1024 then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel loading safety limit reached."
    end
    local slot = firstFuelSlot()
    if not slot then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "No empty slot available while refueling."
    end
    turtle.select(slot)
    local sucked = suckFunction(1)
    if not sucked then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel inventory is empty."
    end
    if not turtle.refuel(0) then
      dropFunction()
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel inventory contains a non-fuel item."
    end
    local before = fuelLevel()
    local consumed = turtle.refuel(1)
    local after = fuelLevel()
