  if #ids == 0 then
    common.writeAt(2, headerY + 2, common.fit("No workers found. Touch DISCOVER.", width - 2), colors and colors.lightGray or nil)
  else
    local first = 1
    if selected > maxRows then first = selected - maxRows + 1 end
    for row = 1, maxRows do
      local index = first + row - 1
      local id = ids[index]
      if not id then break end
      local worker = workers[id]
      local data = worker.data or {}
      local status = statusOf(worker)
      local marker = index == selected and ">" or " "
      local line
      if width >= 48 then
        line = ("%s %-5s %-14s %-12s %-17s %-5s %-4s"):format(
          marker, tostring(id), common.fit(workerLabel(worker, id), 14), common.fit(status, 12),
          common.fit(progressText(data), 17), tostring(data.fuel or "-"), tostring(data.seal and data.seal.count or "-")
        )
      else
        line = ("%s%-5s %-10s %-8s %s"):format(
          marker, tostring(id), common.fit(workerLabel(worker, id), 10), common.fit(status, 8), progressText(data)
        )
      end
      local foreground = index == selected and (colors and colors.black or nil) or common.statusColor(status)
      local background = index == selected and (colors and colors.white or nil) or (colors and colors.black or nil)
      local y = headerY + row
      common.writeAt(1, y, common.fit(line, width), foreground, background)
      addHitbox(key, 1, y, width, y, function() selected = index end)
    end
  end

  buttonRow(key, height - 4, width, {
    { "DISCOVER", dashboardAction("discover") }, { "NEW JOB", dashboardAction("new") },
    { "GPS CAL", dashboardAction("gps") }, { "INFO", dashboardAction("info") },
  })
  buttonRow(key, height - 3, width, {
    { "PAUSE", dashboardAction("pause") }, { "RESUME", dashboardAction("resume") },
    { "RECALL", dashboardAction("recall") }, { "SERVICE", dashboardAction("service") },
  })
  buttonRow(key, height - 2, width, {
    { "ABORT", dashboardAction("abort") }, { "CLEAR", dashboardAction("clear") },
    { "REHOME", dashboardAction("rehome") }, { "QUIT", dashboardAction("quit") },
  })
  local noticeColor = noticeIsError and (colors and colors.red or nil) or (colors and colors.lime or nil)
  common.writeAt(1, height, common.fit(notice, width), noticeColor)
end

local fieldOrder = { "width", "length", "depth" }
local fieldLabels = { width = "WIDTH (right)", length = "LENGTH (forward)", depth = "DEPTH (down)" }
local fieldLimits = { width = 128, length = 512, depth = 128 }

local function commitDraftField()
  if not draft then return end
  local field = draft.selectedField or "width"
  local value = tonumber(draft.buffer)
  if not value then value = draft[field] or 1 end
  value = common.clamp(math.floor(value), 1, fieldLimits[field])
  draft[field], draft.buffer = value, tostring(value)
end

local function chooseDraftField(field)
  commitDraftField()
  draft.selectedField = field
  draft.buffer = tostring(draft[field])
end

local function draftDigit(digit)
  if not draft then return end
  local buffer = tostring(draft.buffer or "")
  if buffer == "0" then buffer = "" end
  if #buffer < 4 then draft.buffer = buffer .. tostring(digit) end
end

local function draftBackspace()
  if not draft then return end
  local buffer = tostring(draft.buffer or "")
  draft.buffer = buffer:sub(1, math.max(0, #buffer - 1))
  if draft.buffer == "" then draft.buffer = "0" end
end

local function adjustDraft(field, delta)
  chooseDraftField(field)
  local value = common.clamp((draft[field] or 1) + delta, 1, fieldLimits[field])
  draft[field], draft.buffer = value, tostring(value)
end

local function draftWorker()
  if not draft then return nil, nil end
  return draft.workerId, workers[draft.workerId]
end

local function draftCalibration()
  local _, worker = draftWorker()
  local gpsData = worker and worker.data and worker.data.gps
  if gpsData and gpsData.calibrated and type(gpsData.calibration) == "table" then return gpsData.calibration end
  return nil
end

local function buildDraftCatalog()
  commitDraftField()
  local calibration = draftCalibration()
  local chunkMode = calibration and "world" or "local"
  local catalog, err = quarry.buildCatalog(draft.width, draft.length, chunkMode, calibration)
  if not catalog then return nil, err end
  local rootKey = nil
  for _, chunk in ipairs(catalog) do
    if 0 >= chunk.minX and 0 <= chunk.maxX and 1 >= chunk.minZ and 1 <= chunk.maxZ then rootKey = chunk.key end
  end
  return catalog, nil, chunkMode, calibration, rootKey
end

local function startDraft(useExclusions)
  if not draft then return end
  commitDraftField()
  local catalog, catalogError, chunkMode, calibration, rootKey = buildDraftCatalog()
  if not catalog then setNotice(catalogError, true); return end
  local excludedChunks = {}
  if useExclusions then
    for _, chunk in ipairs(catalog) do
      if draft.excluded[chunk.key] and chunk.key ~= rootKey then
        excludedChunks[#excludedChunks + 1] = { mode = chunkMode, cx = chunk.cx, cz = chunk.cz }
      end
    end
  end
  if #excludedChunks > 0 then
    local plan, planError = quarry.buildChunkPlan({
      width = draft.width, length = draft.length, depth = draft.depth,
      chunkMode = chunkMode, excludedChunks = excludedChunks,
    }, calibration)
    if not plan then setNotice(planError, true); return end
  end
  local sent = sendCommand(draft.workerId, "start", {
    width = draft.width,
    length = draft.length,
    depth = draft.depth,
    chunkMode = chunkMode,
    excludedChunks = excludedChunks,
    name = ("Quarry %dx%dx%d%s"):format(
      draft.width, draft.length, draft.depth, #excludedChunks > 0 and (" -" .. #excludedChunks .. " chunks") or ""
    ),
    jobId = ("q-%d-%d"):format(draft.workerId, common.nowMillis()),
  })
  if sent then mode, draft = "dashboard", nil end
end

local function renderDimensions(target, key)
  local width, height = target.getSize()
  local id, worker = draftWorker()
  common.writeAt(1, 1, common.center("NEW QUARRY - DIMENSIONS", width), colors and colors.black or nil, colors and colors.cyan or nil)
]] },
  { target = [[controller_parts/02.part]], content = [[  common.writeAt(2, 2, common.fit(("Worker #%s %s"):format(tostring(id or "-"), worker and workerLabel(worker, id) or "offline"), width - 2), colors and colors.lightGray or nil)
  common.writeAt(2, 3, common.fit("Touch a field, then use keypad or +/-.", width - 2), colors and colors.lightGray or nil)

  local fieldWidth = math.min(27, math.max(18, math.floor(width * 0.52)))
  for index, field in ipairs(fieldOrder) do
    local y = 4 + (index - 1) * 2
    local active = draft.selectedField == field
    local shown = active and draft.buffer or tostring(draft[field])
    common.writeAt(2, y, common.fit(fieldLabels[field], fieldWidth - 2), active and (colors and colors.black or nil) or (colors and colors.white or nil), active and (colors and colors.yellow or nil) or (colors and colors.black or nil))
    drawButton(key, 2, y + 1, 4, "-", function() adjustDraft(field, -1) end, true)
    drawButton(key, 7, y + 1, math.max(7, fieldWidth - 12), shown, function() chooseDraftField(field) end, true, active)
    drawButton(key, fieldWidth - 4, y + 1, 4, "+", function() adjustDraft(field, 1) end, true)
  end

  local keypadX = fieldWidth + 2
  local keypadWidth = math.max(15, width - keypadX)
  local cellWidth = math.max(4, math.floor(keypadWidth / 3))
  local labels = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "CLR", "0", "<" }
  for index, label in ipairs(labels) do
    local row = math.floor((index - 1) / 3)
    local column = (index - 1) % 3
    local x, y = keypadX + column * cellWidth, 4 + row * 2
    local action
    if label == "CLR" then action = function() draft.buffer = "0" end
    elseif label == "<" then action = draftBackspace
    else local digit = label; action = function() draftDigit(digit) end end
    drawButton(key, x, y, cellWidth - 1, label, action, true)
    if y + 1 <= height - 4 then
      common.writeAt(x, y + 1, string.rep(" ", cellWidth - 1), colors and colors.white or nil, colors and colors.black or nil)
      addHitbox(key, x, y, x + cellWidth - 2, y + 1, action)
    end
  end

  local volume = (tonumber(draft.width) or 1) * (tonumber(draft.length) or 1) * (tonumber(draft.depth) or 1)
  common.writeAt(2, height - 3, common.fit("Full volume: " .. common.humanNumber(volume) .. " blocks", width - 2), colors and colors.lightGray or nil)
  buttonRow(key, height - 2, width, {
    { "CHUNK MASK", function() commitDraftField(); mode = "job_chunks"; draft.chunkPage = 1 end },
    { "START ALL", function() startDraft(false) end },
    { "CANCEL", function() mode, draft = "dashboard", nil end },
  })
  local noticeColor = noticeIsError and (colors and colors.red or nil) or (colors and colors.lime or nil)
  common.writeAt(1, height, common.fit(notice, width), noticeColor)
end

local function renderChunks(target, key)
  local width, height = target.getSize()
  local catalog, catalogError, chunkMode, _, rootKey = buildDraftCatalog()
  common.writeAt(1, 1, common.center("NEW QUARRY - CHUNK MASK", width), colors and colors.black or nil, colors and colors.cyan or nil)
  if not catalog then
    common.writeAt(2, 3, common.fit(tostring(catalogError), width - 2), colors and colors.red or nil)
    drawButton(key, 1, height - 1, width, "BACK", function() mode = "job_dimensions" end, true)
    return
  end
  common.writeAt(2, 2, common.fit(("Mode: %s chunks | touch rows to exclude | entrance is locked"):format(chunkMode), width - 2), colors and colors.lightGray or nil)
  local rowsPerPage = math.max(1, height - 7)
  local pages = math.max(1, math.ceil(#catalog / rowsPerPage))
  draft.chunkPage = common.clamp(draft.chunkPage or 1, 1, pages)
  local first = (draft.chunkPage - 1) * rowsPerPage + 1
  for row = 1, rowsPerPage do
    local chunk = catalog[first + row - 1]
    if not chunk then break end
    local locked = chunk.key == rootKey
    local excluded = draft.excluded[chunk.key] == true and not locked
    local marker = locked and "[ENTRY]" or excluded and "[EXCLUDE]" or "[ MINE ]"
    local label = ("%-9s %s chunk %d,%d  local x=%d..%d z=%d..%d (%d cells)"):format(
      marker, chunkMode, chunk.cx, chunk.cz, chunk.minX, chunk.maxX, chunk.minZ, chunk.maxZ, chunk.cells
    )
    local y = 3 + row
    local foreground = locked and (colors and colors.yellow or nil) or excluded and (colors and colors.white or nil) or (colors and colors.lime or nil)
    local background = excluded and (colors and colors.red or nil) or (colors and colors.black or nil)
    common.writeAt(1, y, common.fit(label, width), foreground, background)
    if not locked then
      local chunkKeyValue = chunk.key
      addHitbox(key, 1, y, width, y, function()
        draft.excluded[chunkKeyValue] = not draft.excluded[chunkKeyValue]
      end)
    end
  end
  local excludedCount = 0
  for chunkKeyValue, excluded in pairs(draft.excluded) do if excluded and chunkKeyValue ~= rootKey then excludedCount = excludedCount + 1 end end
  common.writeAt(2, height - 3, common.fit(("Page %d/%d | excluded %d/%d"):format(draft.chunkPage, pages, excludedCount, #catalog), width - 2), colors and colors.lightGray or nil)
  buttonRow(key, height - 2, width, {
    { "< PAGE", function() draft.chunkPage = math.max(1, draft.chunkPage - 1) end, draft.chunkPage > 1 },
    { "PAGE >", function() draft.chunkPage = math.min(pages, draft.chunkPage + 1) end, draft.chunkPage < pages },
    { "CLEAR MASK", function() draft.excluded = {} end },
    { "BACK", function() mode = "job_dimensions" end },
    { "START", function() startDraft(true) end },
  })
  local noticeColor = noticeIsError and (colors and colors.red or nil) or (colors and colors.lime or nil)
  common.writeAt(1, height, common.fit(notice, width), noticeColor)
end

local function renderInfo(target, key)
  local width, height = target.getSize()
  local id, worker = selectedWorker()
  local data = worker and worker.data or {}
