    if not consumed then
      dropFunction()
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Turtle refused the selected fuel item."
    end
    if turtle.getItemCount(slot) > 0 then dropFunction() end
    if type(before) == "number" and type(after) == "number" and after > before then
      state.stats.refuels = (state.stats.refuels or 0) + 1
    end
  end
  local restored, restoreError = restoreSideDirection(fuelSide, restoreDir)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  saveState()
  return true
end

local function refillSlotForSeal()
  local materials, recycle = materialsConfig()
  local preferred = materials.sealSlots or recycle.sealSlots or config.sealSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) > 0 and isSealItemName(itemName(slot)) and turtle.getItemSpace(slot) > 0 then return slot end
    end
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) == 0 then return slot end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "seal") and isSealItemName(itemName(slot)) and turtle.getItemSpace(slot) > 0 then return slot end
  end
  for slot = 1, 16 do if not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) == 0 then return slot end end
  return nil
end

