  if type(quarry.shortestServiceRoute) == "function" then
    local dockKey = plan.dockKey or plan.entranceKey or plan.rootKey
    local dock = plan.chunks and plan.chunks[dockKey]
    if dock then
      local dockPose = { x = dock.anchor.x, y = pose.y, z = dock.anchor.z }
      local ok, route = pcall(quarry.shortestServiceRoute, plan, pose, dockPose, { allowFallback = true })
      if ok and type(route) == "table" and tonumber(route.distance) then
        return tonumber(route.distance) + math.abs(dock.anchor.x) + math.abs(dock.anchor.z) + math.abs(tonumber(pose.y) or 0)
      end
    end
  end
  local dockKey = plan.dockKey or plan.entranceKey or plan.rootKey
  local path, pathError = quarry.pathToRoot(plan, currentKey)
  if not path or path[#path] ~= dockKey then path = dfsChunkPath(plan, currentKey, dockKey); pathError = pathError or "dfs_unavailable" end
  if not path then return nil, pathError end

  local current = plan.chunks[currentKey]
  local total = math.abs(pose.x - current.anchor.x) + math.abs(pose.z - current.anchor.z)
  for index = 2, #path do
    local from, target = plan.chunks[path[index - 1]], plan.chunks[path[index]]
    if not from or not target then return nil, "Chunk return path references a missing chunk." end
    total = total + math.abs(from.anchor.x - target.anchor.x) + math.abs(from.anchor.z - target.anchor.z)
  end
  local root = plan.chunks[dockKey]
  if not root then return nil, "Chunk return path has no entrance chunk." end
  total = total + math.abs(tonumber(pose.y) or 0)
  total = total + math.abs(root.anchor.x) + math.abs(root.anchor.z)
  return total
end

local function firstEmptySlot()
  for slot = 1, 16 do if not isReservedSlot(slot) and turtle.getItemCount(slot) == 0 then return slot end end
  return nil
end

local function firstFuelSlot()
  local materials = materialsConfig()
  local preferred = materials.fuelReserveSlots or config.fuelReserveSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "fuel") and turtle.getItemCount(slot) == 0 then return slot end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "fuel") and turtle.getItemCount(slot) == 0 then return slot end
  end
  return nil
end

local function looksLikeInventoryBlock(data)
  local name = string.lower(blockName(data))
  if name == "minecraft:chest" or name == "minecraft:trapped_chest" or name == "minecraft:barrel" then return true end
  return name:match("^minecraft:[%w_]+shulker_box$") ~= nil
end

local function discardPolicy()
  local policy = config.discard or {}
  local mode = tostring(policy.mode or policy.policy or "KEEP_ALL"):upper()
  if mode ~= "KEEP_ALL" and mode ~= "DISCARD_EXCESS_STONE" and mode ~= "CUSTOM_ALLOWLIST" then mode = "KEEP_ALL" end
  return policy, mode
end

local function isOreOrRawMaterial(name)
  name = string.lower(tostring(name or ""))
  -- Keep all ores/raw materials regardless of the selected allowlist.  The
  -- broad suffix/prefix checks intentionally err on the side of retention
  -- for modded names (an unknown resource is safer in the output chest).
  return name:find("_ore", 1, true) ~= nil
    or name:find("ore_", 1, true) ~= nil
    or name:find("raw_", 1, true) ~= nil
    or name:find("_raw", 1, true) ~= nil
    or name:find("rawore", 1, true) ~= nil
end

local function isUnknownModItem(name)
  local namespace = tostring(name or ""):match("^([^:]+):")
  if not namespace or namespace == "" then return true end
  if namespace == "minecraft" or namespace == "computercraft" or namespace == "cc_tweaked" then return false end
  local policy = config.discard or {}
  local known = policy.knownNamespaces or policy.knownMods
  if type(known) == "table" and (known[namespace] == true or known[namespace] == 1) then return false end
  return true
end

local function discardProtectedItem(slot, name)
  if not name or name == "unknown" then return true end
  if isTorchItemName(name) or isFuelItem(slot) then return true end
  if isOreOrRawMaterial(name) or isUnknownModItem(name) then return true end
  return false
end

local function explicitAllowlisted(name, policy)
  local allowlist = policy and (policy.allowlist or policy.allowList or policy.allowedItems)
  if type(allowlist) ~= "table" then return false end
  if allowlist[name] == true or allowlist[name] == 1 then return true end
  for _, item in ipairs(allowlist) do if tostring(item) == tostring(name) then return true end end
  return false
end

local function discardCandidate(slot, name, totalSeal, policy, mode)
  if mode == "KEEP_ALL" then return false end
  if mode == "CUSTOM_ALLOWLIST" then
    -- Torches, fuel, ores and raw materials remain hard protected.  Seal
    -- blocks may be selected, but the caller still enforces retainSealTarget.
    -- Unknown mod items are discardable only when their exact name is explicitly allowlisted.
    if isTorchItemName(name) or isFuelItem(slot) or isOreOrRawMaterial(name) then return false end
    if not explicitAllowlisted(name, policy) then return false end
    if isSealItemName(name) then
      local keep = math.max(0, tonumber(policy.retainSealTarget) or 64)
      return totalSeal > keep
    end
    return true
  end
  if discardProtectedItem(slot, name) then return false end
  if mode == "DISCARD_EXCESS_STONE" then
    local stone = policy.stoneAllowlist or {
      ["minecraft:stone"] = true, ["minecraft:cobblestone"] = true,
      ["minecraft:cobbled_deepslate"] = true,
    }
    if not (stone[name] == true or name == "minecraft:stone" or name == "minecraft:cobblestone" or name == "minecraft:cobbled_deepslate") then
      return false
    end
    -- Seal stock is retained by item count.  We drop whole stacks only when
    -- doing so leaves the configured 64 (or explicit) reserve intact.
    if isSealItemName(name) then
      local keep = math.max(1, tonumber(config.discard and config.discard.retainSealTarget) or 64)
      return totalSeal > keep
    end
    return true
  end
  return false
end

local function discardStatsTable()
  state.discardStats = state.discardStats or {}
  state.discard = state.discard or state.discardStats
  local stats = state.discardStats
  state.discard = common.merge(stats, state.discard)
  stats.mode = (config.discard and config.discard.mode) or stats.mode or "KEEP_ALL"
  stats.triggerEmptySlots = tonumber(config.discard and config.discard.triggerEmptySlots) or 3
  stats.maxStacksPerPass = tonumber(config.discard and config.discard.maxStacksPerPass) or 8
  stats.byName = stats.byName or {}
  return stats
end

local function noteDiscard(name, count)
  local stats = discardStatsTable()
  count = math.max(0, tonumber(count) or 0)
  stats.items = (stats.items or 0) + count
  stats.discarded = (stats.discarded or 0) + count
  stats.stacks = (stats.stacks or 0) + 1
  stats.byName[name] = (stats.byName[name] or 0) + count
  stats.lastAt = common.nowSeconds()
  state.stats.discardedBlocks = (state.stats.discardedBlocks or 0) + count
  state.stats.discardPasses = (state.stats.discardPasses or 0) + 1
end

local function noteDiscardSkip(name, unknown)
  local stats = discardStatsTable()
  stats.skipped = (stats.skipped or 0) + 1
  if unknown then stats.unknown = (stats.unknown or 0) + 1; state.stats.discardUnknown = (state.stats.discardUnknown or 0) + 1 end
  state.stats.discardSkipped = (state.stats.discardSkipped or 0) + 1
  stats.lastAt = common.nowSeconds()
end

local function sideTargetDirection(baseDir, side)
  side = tostring(side or "front"):lower()
  if side == "up" then side = "top" end
  if side == "down" then side = "bottom" end
  local relative = { front = 0, right = 1, back = 2, left = 3 }
  if relative[side] == nil then return nil end
  return ((tonumber(baseDir) or 0) + relative[side]) % 4
end

local function recycleRetainTarget()
  local materials, recycle = materialsConfig()
  local target = materials.retainSealTarget
    or recycle.maxHeld
    or recycle.retainSealTarget
    or config.retainSealTarget
    or config.sealTarget
    or 64
  return math.max(0, math.floor(tonumber(target) or 64))
end

local function homeRetainCounts()
  local policy = config.discard or {}
  local lighting = config.lighting or {}
  local materials = materialsConfig()
  local sealRemaining = math.max(0, math.floor(tonumber(policy.retainSealTarget
    or materials.retainSealTarget or config.sealTarget) or 64))
  local torchRemaining = effectiveLighting() == "off" and 0
    or math.max(0, math.floor(tonumber(lighting.target or lighting.torchTarget
      or materials.torchTarget or config.torchTarget) or 32))
  local keep = {}
  local function reserveRole(role, predicate, remaining)
    local order, seen = {}, {}
    local sets = materialSlotSets()
    for slot = 1, 16 do
      if sets[role] and sets[role][slot] then order[#order + 1], seen[slot] = slot, true end
    end
    for slot = 1, 16 do if not seen[slot] then order[#order + 1] = slot end end
    for _, slot in ipairs(order) do
      local count, name = turtle.getItemCount(slot), itemName(slot)
      if count > 0 and predicate(slot, name) and remaining > 0 then
        local amount = math.min(count, remaining)
        keep[slot], remaining = (keep[slot] or 0) + amount, remaining - amount
      end
    end
  end
  reserveRole("seal", function(_, name) return isSealItemName(name) end, sealRemaining)
  reserveRole("torch", function(_, name) return isTorchItemName(name) end, torchRemaining)
  for slot = 1, 16 do
    if slotRoleContains(slot, "fuel") and isFuelItem(slot) then keep[slot] = turtle.getItemCount(slot)
    elseif slotRoleContains(slot, "generic") then keep[slot] = turtle.getItemCount(slot) end
  end
  return keep
end

local function compressSealStacks()
  local originalSlot = turtle.getSelectedSlot()
  local moved = 0
  local function compactRole(role, predicate)
    local sets = materialSlotSets()
    local order, seen = {}, {}
    for slot = 1, 16 do
      if sets[role] and sets[role][slot] and not isReservedSlot(slot, role) then
        order[#order + 1], seen[slot] = slot, true
      end
    end
    for slot = 1, 16 do
      if not seen[slot] and not isReservedSlot(slot, role) then order[#order + 1] = slot end
    end
    for _, destination in ipairs(order) do
      -- Empty designated slots are filled first.  Older code only merged into
      -- occupied slots, so the documented material slots often stayed empty.
      if turtle.getItemCount(destination) == 0 and sets[role] and sets[role][destination] then
        for source = 1, 16 do
          if source ~= destination and not isReservedSlot(source, role)
            and turtle.getItemCount(source) > 0 and predicate(itemName(source)) then
            turtle.select(source)
            local before = turtle.getItemCount(source)
            if turtle.transferTo(destination) then moved = moved + before - turtle.getItemCount(source) end
            break
          end
        end
      end
      local name = itemName(destination)
      if name and predicate(name) then
        local space = turtle.getItemSpace(destination)
        for source = 1, 16 do
          if space <= 0 then break end
          if source ~= destination and not isReservedSlot(source, role)
            and turtle.getItemCount(source) > 0 and itemName(source) == name then
            turtle.select(source)
            local before = turtle.getItemCount(source)
            if turtle.transferTo(destination, math.min(space, before)) then
              moved = moved + before - turtle.getItemCount(source)
              space = turtle.getItemSpace(destination)
            end
          end
        end
      end
    end
  end
  compactRole("seal", isSealItemName)
  compactRole("torch", isTorchItemName)
  turtle.select(originalSlot)
  return moved
end

local function compressInventoryAtField()
  -- compactEvery is a local inventory operation.  It must never create a
