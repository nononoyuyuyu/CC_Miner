    local preferred = preferredTorchSlots()
    if type(preferred) == "table" then
      for _, candidate in ipairs(preferred) do
        local candidateSlot = tonumber(candidate)
        if candidateSlot and not isReservedSlot(candidateSlot, "torch") and turtle.getItemCount(candidateSlot) == 0 then
          slot = candidateSlot
          break
        end
      end
    end
    if not slot then
      for candidate = 1, 16 do
        if not isReservedSlot(candidate, "torch") and turtle.getItemCount(candidate) == 0 then slot = candidate; break end
      end
    end
    if not slot then
      restoreSideDirection(side, restoreDir)
