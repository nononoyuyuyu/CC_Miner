    local count, name = turtle.getItemCount(slot), itemName(slot)
    if count > 0 and discardCandidate(slot, name, totalSeal, policy, mode)
      and not (isSealItemName(name) and totalSeal - count < (tonumber(policy.retainSealTarget) or 64)) then
      turtle.select(slot)
      discardStats.attempts = (discardStats.attempts or 0) + 1
      local before = turtle.getItemCount(slot)
      local prepared, prepareError = beginPhysicalAction("discard_field", {
        slot = slot, item = name, count = before, direction = side,
      }, poseCopy())
      if not prepared then
        discardStats.lastError = prepareError or "Could not journal field discard action."
        break
      end
      local dropped = dropFunction() -- world discard is always stack-at-a-time
      local after = turtle.getItemCount(slot)
      if dropped and after == 0 then
        commitPhysicalAction()
        discardedStacks = discardedStacks + 1
        noteDiscard(name, before)
        if isSealItemName(name) then totalSeal = totalSeal - before end
      else
        cancelPhysicalAction()
        noteDiscardSkip(name, isUnknownModItem(name))
        discardStats.lastError = "Field discard failed; stack retained."
      end
    end
  end
  discardStats.passes = (discardStats.passes or 0) + 1
  discardStats.enabled = true
  discardStats.mode = mode
  discardStats.lastAt = common.nowSeconds()
  discardStats.lastInventoryItems = totalItems
  restoreSideDirection(side, restoreDir)
  turtle.select(originalSlot)
  saveState("field_discard")
  return discardStats.lastError == nil, discardStats.lastError
end

local function targetFuelForService()
  local target = tonumber(config.fuelTarget) or 12000
  if state.service and state.service.resumeAfter and state.checkpoint then
    local checkpointDistance = estimatedReturnDistance(state.checkpoint)
    if not checkpointDistance then
      checkpointDistance = distance({ x = 0, y = 0, z = 0 }, state.checkpoint)
    end
    target = math.max(target, checkpointDistance * 2 + profileFuelBuffer())
  end
  local limit = fuelLimit()
  if limit == "unlimited" then return "unlimited" end
  if type(limit) == "number" and limit > 0 then target = math.min(target, limit) end
  return math.max(1, math.floor(target))
end

local function refuelAtHome()
  state.phase, state.status = "refueling", "working"
  saveState()
  local current = fuelLevel()
  if current == "unlimited" then return true end
  local target = targetFuelForService()
  local fuelSide = config.fuelSide or "top"
  local inspectFunction, suckFunction, dropFunction, restoreDir, sideError = sideFunctions(fuelSide)
  if not inspectFunction then return false, sideError end
  local checkSide = (fuelSide == "top" and "top") or (fuelSide == "bottom" and "bottom") or "front"
  if not inventoryPresent(checkSide, inspectFunction) then
    restoreSideDirection(fuelSide, restoreDir)
    return false, "Fuel inventory missing on configured side " .. fuelSide .. "."
  end
  if target == "unlimited" or current >= target then
    restoreSideDirection(fuelSide, restoreDir)
    return true
  end

  local originalSlot = turtle.getSelectedSlot()
  local attempts = 0
  while fuelLevel() ~= "unlimited" and fuelLevel() < target do
    drainNetwork(3)
    if movementInterrupted("service") then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "control_request"
    end
    attempts = attempts + 1
    if attempts > 1024 then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel loading safety limit reached."
    end
    local slot = firstFuelSlot()
    if not slot then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "No empty slot available while refueling."
    end
    turtle.select(slot)
    local sucked = runInventoryPhysicalAction("refuel_suck", {
      slot = slot, count = 1, direction = fuelSide,
    }, function() return suckFunction(1) end)
    if not sucked then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel inventory is empty."
    end
    local validFuel = runInventoryPhysicalAction("refuel_probe", {
      slot = slot, count = turtle.getItemCount(slot), direction = fuelSide,
    }, function() return turtle.refuel(0) end)
    if not validFuel then
      runInventoryPhysicalAction("refuel_reject", {
        slot = slot, item = itemName(slot), direction = fuelSide,
      }, dropFunction)
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Fuel inventory contains a non-fuel item."
    end
    local before = fuelLevel()
    local consumed = runInventoryPhysicalAction("refuel_consume", {
      slot = slot, item = itemName(slot), direction = fuelSide,
    }, function() return turtle.refuel(1) end)
    local after = fuelLevel()
    if not consumed then
      runInventoryPhysicalAction("refuel_reject", {
        slot = slot, item = itemName(slot), direction = fuelSide,
      }, dropFunction)
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "Turtle refused the selected fuel item."
    end
    if turtle.getItemCount(slot) > 0 then
      runInventoryPhysicalAction("refuel_excess", {
        slot = slot, item = itemName(slot), direction = fuelSide,
      }, dropFunction)
    end
    if type(before) == "number" and type(after) == "number" and after > before then
      state.stats.refuels = (state.stats.refuels or 0) + 1
    end
  end
  local restored, restoreError = restoreSideDirection(fuelSide, restoreDir)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  saveState()
  return true
end

local function refillSlotForSeal()
  local materials, recycle = materialsConfig()
  local preferred = materials.sealSlots or recycle.sealSlots or config.sealSlots
  if type(preferred) == "table" then
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) > 0 and isSealItemName(itemName(slot)) and turtle.getItemSpace(slot) > 0 then return slot end
    end
    for _, candidate in ipairs(preferred) do
      local slot = tonumber(candidate)
      if slot and not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) == 0 then return slot end
    end
  end
  for slot = 1, 16 do
    if not isReservedSlot(slot, "seal") and isSealItemName(itemName(slot)) and turtle.getItemSpace(slot) > 0 then return slot end
  end
  for slot = 1, 16 do if not isReservedSlot(slot, "seal") and turtle.getItemCount(slot) == 0 then return slot end end
  return nil
end

