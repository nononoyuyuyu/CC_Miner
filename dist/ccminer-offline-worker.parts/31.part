  state.lighting.interval = (job.lighting and job.lighting.interval) or (config.lighting and config.lighting.interval) or 32
  state.water.mode = job.waterMode or config.waterMode or (config.water and config.water.mode) or "ignore"
  state.pose = { x = 0, y = 0, z = 0, dir = state.pose.dir or 0 }
  saveState()
  common.log("INFO", ("Job started: %s %dx%dx%d strategy=%s exclusions=%d"):format(
    job.id, job.width, job.length, job.depth, job.strategy, #job.excludedChunks
  ))
  return true, "Job accepted."
end

local function calibrateGPS()
  if state.pendingAction then return false, "Resolve the pending physical action first." end
  if not isHome() or state.pose.dir ~= 0 then return false, "Place the turtle at home facing the quarry before GPS calibration." end
  if state.job then return false, "Clear the active job before GPS calibration." end
  if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" then
    return false, "Worker must be stopped before GPS calibration."
  end
  if fuelLevel() ~= "unlimited" and tonumber(fuelLevel() or 0) < 2 then return false, "At least 2 fuel is required." end
]] },
  { source = [[src/ccminer/worker_parts/02.part]], target = [[worker_parts/02.part]], digest = [[411ecbd29950440ec96808a7a93ffd0668a38b498f5f29679c855491231148ee]], content = [[  local blocked = turtle.inspect()
  if blocked then return false, "The block directly in front of the dock must be empty for calibration." end

  state.status, state.phase, state.lastError = "calibrating", "gps_calibration", nil
  saveState()
  local homeFix, homeError = locateGPS()
  if not homeFix then
    state.status, state.phase = "blocked", "gps_error"
    state.lastError = homeError
    saveState()
    return false, homeError
  end

  local prepared, prepareError = beginPhysicalAction("gps_calibration", { home = homeFix })
  if not prepared then return false, prepareError end
  local moved, moveError = turtle.forward()
  if not moved then
    cancelPhysicalAction()
    state.status, state.phase, state.lastError = "blocked", "gps_error", moveError or "Calibration move failed."
    saveState()
    return false, state.lastError
  end
  sleep(0.15)
  local forwardFix, forwardError = locateGPS()
  local returned, returnError = turtle.back()
  if not returned then
    state.status, state.phase = "blocked", "recovery_required"
    state.lastError = "GPS calibration moved forward but could not return: " .. tostring(returnError)
    saveState()
    return false, state.lastError
  end
  if not forwardFix then
    cancelPhysicalAction()
    state.status, state.phase, state.lastError = "blocked", "gps_error", forwardError
    saveState()
    return false, forwardError
  end

  local calibration, calibrationError = geo.calibrationFromFixes(homeFix, forwardFix)
  if not calibration then
    cancelPhysicalAction()
    state.status, state.phase, state.lastError = "blocked", "gps_error", calibrationError
    saveState()
    return false, calibrationError
  end
  config.gps = config.gps or {}
  config.gps.enabled = true
  config.gps.calibration = calibration
  local saved, saveError = common.saveConfig(config)
  if not saved then
    cancelPhysicalAction()
    state.status, state.phase = "blocked", "gps_error"
    state.lastError = "Could not save GPS calibration: " .. tostring(saveError)
    saveState()
    return false, state.lastError
  end
  state.gps.available = true
  state.gps.lastFix = homeFix
  state.gps.lastFixAt = common.nowSeconds()
  state.gps.lastError = nil
  state.status, state.phase, state.lastError = "idle", "home", nil
  commitPhysicalAction()
  common.log("INFO", ("GPS calibrated at %d,%d,%d forward=%d,%d"):format(
    homeFix.x, homeFix.y, homeFix.z, calibration.forward.x, calibration.forward.z
  ))
  return true, "GPS calibrated."
end

-- -------------------------------------------------------------------------
-- Remote console
-- -------------------------------------------------------------------------
-- The console is intentionally implemented in the worker rather than by
-- writing a temporary command file.  Session material and command input stay
-- in memory; only bounded audit counters are exposed through status.

local function remoteToken(prefix, sender)
  remoteTokenCounter = (tonumber(remoteTokenCounter) or 0) + 1
  return ("remote-%s-%d-%d-%d"):format(
    tostring(prefix or "token"), tonumber(sender) or 0, common.nowMillis(), remoteTokenCounter
  )
end

local function remoteIsTerminated(value)
  local text = tostring(value or "")
  return text == "Terminated" or text:find("Terminated", 1, true) ~= nil
end

local function remoteAuditHead(command)
  -- Keep only the command prefix.  Arguments (which may contain a path or a
  -- secret supplied to an explicitly enabled shell) are never retained.
  command = common.trim(command or "")
  local first, second = command:match("^(%S+)%s+(%S+)")
  local head = first and second and string.lower(first) == "ccm"
    and (first .. " " .. second) or (command:match("^(%S+)") or "")
  return head:sub(1, 64)
end

local function remoteAuditRecord(command, ok)
  local limit = math.max(1, math.floor(tonumber(config.remoteConsole.auditLimit) or 50))
  remoteAudit[#remoteAudit + 1] = {
    command = remoteAuditHead(command),
    ok = ok == true,
    at = common.nowSeconds(),
  }
  while #remoteAudit > limit do table.remove(remoteAudit, 1) end
end

local function remoteSessionExpired()
  if remoteSession and common.nowSeconds() >= tonumber(remoteSession.expiresAt or 0) then
    remoteSession = nil
    return true
  end
  return false
end

local function remoteConsoleReady()
  local allowed = {
    idle = true, complete = true, aborted = true, paused = true,
  }
  if not allowed[tostring(state.status or "")] then
    return false, "Remote console requires an idle, complete, aborted, or paused worker."
  end
  if not isHome() then return false, "Remote console requires the worker to be at home." end
  if state.pendingAction then return false, "Remote console is unavailable while recovery is pending." end
  if state.request ~= nil or state.service ~= nil then
    return false, "Remote console is unavailable while a worker request is pending."
  end
  return true
end

local function remotePayloadSession(payload)
  local nested = type(payload.session) == "table" and payload.session or {}
  local sessionId = payload.sessionId or nested.sessionId or nested.id
  local nonce = payload.nonce or nested.nonce
  local sequence = payload.seq or payload.sequence or payload.requestSeq
    or nested.seq or nested.sequence or nested.requestSeq
  return sessionId, nonce, sequence
end

local function remoteConsumeSession(sender, payload)
  remoteSessionExpired()
  if not remoteSession then return false, "Remote console session is not open." end
  if tonumber(sender) ~= tonumber(remoteSession.sender) then
    return false, "Remote console session is bound to another sender."
  end
  local sessionId, nonce, sequence = remotePayloadSession(payload)
  if tostring(sessionId or "") ~= tostring(remoteSession.sessionId) then
    return false, "Remote console sessionId is invalid."
  end
  if tostring(nonce or "") ~= tostring(remoteSession.nonce) then
    return false, "Remote console nonce is invalid."
  end
  local seq = tonumber(sequence)
  if not seq or seq ~= math.floor(seq) or seq < 1 then
    return false, "Remote console sequence is required."
  end
  local expected = (tonumber(remoteSession.lastSeq) or 0) + 1
  if seq ~= expected then
    return false, ("Remote console sequence replay/out of order (expected %d)."):format(expected)
  end
  -- Consume the sequence before running the command.  A failed/denied command
  -- is still a used request and cannot be replayed with the same sequence.
  remoteSession.lastSeq = seq
  return true, nil, seq
end

local function remoteCommandHead(command)
  local first, second = tostring(command or ""):match("^%s*(%S+)%s*(%S*)")
  return string.lower(first or ""), string.lower(second or "")
end

local function remoteHasForbiddenSyntax(command)
  command = tostring(command or "")
  -- Shell metacharacters, substitutions, and backslash escapes are denied in
  -- safe mode even when a matching configured entry exists.
  if command:find("[\r\n;|&><`\\]", 1) then return true end
  if command:find("%$%(", 1) or command:find("%${", 1) then return true end
  local first, second = remoteCommandHead(command)
  local base = first:match("([^/]+)$") or first
  local destructive = {
    reboot = true, shutdown = true, update = true, delete = true,
    edit = true, copy = true, move = true, mv = true, rm = true,
    mkdir = true, rmdir = true, wget = true, pastebin = true,
    lua = true, shell = true, exit = true, install = true,
    touch = true, write = true, append = true, format = true,
    mount = true, unmount = true, attach = true, detach = true,
    monitor = true, craft = true, tunnel = true, excavate = true,
    dig = true, drop = true, place = true,
  }
  if destructive[base] then return true end
  if base == "ccm" and second ~= "status" and second ~= "report" and second ~= "doctor" then return true end
  -- `label set` mutates the computer label; only the read-only getter is
  -- permitted in safe mode, even when an operator supplied an exact entry.
  if base == "label" and second ~= "get" then return true end
  return false
end

local function remoteConfiguredCommand(command)
  local allowlist = config.remoteConsole.allowlist
  if type(allowlist) ~= "table" then return false end
  for _, entry in ipairs(allowlist) do
    -- Configured entries are deliberately exact (after trimming the request,
    -- not the configured value); no wildcard or prefix semantics are allowed.
    if type(entry) == "string" and command == entry then return true end
  end
  return false
end

local function remoteSafeCommand(command)
  command = common.trim(command or "")
  if command == "" or remoteHasForbiddenSyntax(command) then return false end
  if remoteConfiguredCommand(command) then return true end
  -- Built-ins are exact command strings too.  This intentionally does not
  -- grant a command head with arbitrary arguments (for example `ls /`): an
  -- operator must opt into that complete string in remoteConsole.allowlist.
  local builtin = {
    ["ccm status"] = true, ["ccm report"] = true, ["ccm doctor"] = true,
    ["id"] = true, ["label get"] = true, ["ls"] = true, ["dir"] = true,
    ["df"] = true, ["free"] = true, ["version"] = true,
  }
  return builtin[command] == true
end

local function remoteMemoryTerminal(limit)
  local chunks, size, overflow = {}, 0, false
  local cursorX, cursorY = 1, 1
  local textColor, backgroundColor = 1, 32768
  local palettes = {}
  local function append(value)
    value = tostring(value or "")
    if value == "" then return end
    local remaining = math.max(0, limit - size)
    if #value > remaining then
      if remaining > 0 then chunks[#chunks + 1] = value:sub(1, remaining); size = size + remaining end
      overflow = true
    else
      chunks[#chunks + 1] = value
      size = size + #value
    end
  end
  local terminal = {
    write = function(value) append(value); cursorX = cursorX + #tostring(value or "") end,
    blit = function(value) append(value); cursorX = cursorX + #tostring(value or "") end,
    clear = function() chunks, size, overflow = {}, 0, false; cursorX, cursorY = 1, 1 end,
    clearLine = function() cursorX = 1 end,
    getCursorPos = function() return cursorX, cursorY end,
    setCursorPos = function(x, y)
      x, y = math.max(1, math.floor(tonumber(x) or 1)), math.max(1, math.floor(tonumber(y) or 1))
      if y > cursorY then append(string.rep("\n", y - cursorY)) end
      cursorX, cursorY = x, y
    end,
    setCursorBlink = function() end,
    getCursorBlink = function() return false end,
    isColor = function() return false end,
    getSize = function() return 51, 19 end,
