    turtle.select(slot)
    local need = math.min(target - torchMaterialCount(), turtle.getItemSpace(slot))
    if need <= 0 then need = 1 end
    local sucked = runInventoryPhysicalAction("refill_torch_suck", {
      slot = slot, count = need, direction = side,
    }, function() return suckFunction(need) end)
    if not sucked then
      restoreSideDirection(side, restoreDir)
      turtle.select(originalSlot)
      return false, "Torch inventory is empty."
    end
    if not isTorchItemName(itemName(slot)) then
      runInventoryPhysicalAction("refill_torch_reject", {
        slot = slot, item = itemName(slot), direction = side,
      }, dropFunction)
      restoreSideDirection(side, restoreDir)
      turtle.select(originalSlot)
      return false, "Torch inventory contains an unsupported item."
    end
    state.stats.torchRefills = (state.stats.torchRefills or 0) + 1
  end
  local restored, restoreError = restoreSideDirection(side, restoreDir)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  saveState("refill_torch_done")
  return true
end

local function beginService(resumeAfter, finalStatus, reason, preserveCheckpoint)
  if not state.service then
    if not isHome() and not state.checkpoint then installCheckpointToken(checkpointToken()) end
    state.serviceReturn = {}
    state.service = {
      resumeAfter = resumeAfter == true,
      finalStatus = finalStatus or (resumeAfter and "working" or "paused"),
      preserveCheckpoint = preserveCheckpoint == true,
      reason = reason or "service",
      startedAt = common.nowSeconds(),
      returnDistance = 0,
      returnStartedAt = nil,
      returnEndedAt = nil,
    }
  else
    if resumeAfter == false then state.service.resumeAfter = false end
    if finalStatus then state.service.finalStatus = finalStatus end
    if preserveCheckpoint ~= nil then state.service.preserveCheckpoint = preserveCheckpoint == true end
    if reason then state.service.reason = reason end
  end
  if state.checkpoint and not state.resumeToken then state.resumeToken = common.copy(state.checkpoint) end
  if state.job and state.job.groupJobId then
    state.assignmentResumeToken = assignmentResumeSnapshot(state.resumeToken or state.checkpoint or checkpointToken())
  end
  if resumeAfter and not isHome() and not state.checkpoint then installCheckpointToken(checkpointToken()) end
  state.returnReason = reason or state.returnReason
  state.lastReturnReason = reason or state.lastReturnReason
  state.status, state.phase, state.request = "working", "service_requested", nil
  saveState()
end

local function finishService()
  local service = state.service or {}
  local finalStatus = service.finalStatus or (service.resumeAfter and "working" or "paused")
  local preserveCheckpoint = service.preserveCheckpoint == true
  state.lastReturnReason = service.reason or state.returnReason or state.lastReturnReason
  state.service, state.request, state.lastError = nil, nil, nil
  state.stagedStop = false
  state.stats.services = (state.stats.services or 0) + 1
  if finalStatus == "complete" then
    state.stats.jobsCompleted = (state.stats.jobsCompleted or 0) + 1
    state.checkpoint = nil
    -- Completion is terminal: do not leave a stale work-point token that
    -- could be overlaid by a later pending snapshot or mistaken for a
    -- resumable assignment.
    state.resumeToken = nil
    state.assignmentResumeToken = nil
    state.status, state.phase = "complete", "home"
    state.estimate = state.estimate or {}
    state.estimate.actual = state.job and state.job.cursor or 0
    state.estimate.variance = (state.estimate.actual or 0) - (tonumber(state.estimate.estimated) or (state.estimate.actual or 0))
    state.report = {
      jobId = state.job and state.job.id or nil,
      assignmentId = state.job and state.job.assignmentId or nil,
      groupJobId = state.job and state.job.groupJobId or nil,
      group = state.group and common.copy(state.group) or nil,
      reason = state.completionReason,
      returnReason = state.lastReturnReason or state.returnReason,
      ["return"] = state.serviceReturn and common.copy(state.serviceReturn) or nil,
      completedAt = common.nowSeconds(),
      elapsed = state.job and math.max(0, common.nowSeconds() - (state.job.startedAt or common.nowSeconds())) or 0,
      progress = state.job and { cursor = state.job.cursor or 0, total = state.job.total or 0 } or nil,
      stats = common.copy(state.stats),
      estimated = state.estimate and state.estimate.estimated or nil,
      actual = state.job and state.job.cursor or nil,
      materials = {
        torchCount = torchMaterialCount(), sealCount = sealMaterialCount(),
      },
      discard = common.copy(state.discardStats or state.discard or {}),
      throughput = throughputSnapshot(),
      assignmentResumeToken = nil,
    }
    state.stats.jobReports = (state.stats.jobReports or 0) + 1
    state.job.report = common.copy(state.report)
    state.lastReport = common.copy(state.report)
    state.jobReport = common.copy(state.report)
  elseif finalStatus == "aborted" then
    state.stats.jobsAborted = (state.stats.jobsAborted or 0) + 1
    state.checkpoint = nil
    state.status, state.phase = "aborted", "home"
    state.estimate = state.estimate or {}
    state.estimate.actual = state.job and state.job.cursor or 0
    state.estimate.variance = (state.estimate.actual or 0) - (tonumber(state.estimate.estimated) or (state.estimate.actual or 0))
    state.report = {
      jobId = state.job and state.job.id or nil,
      assignmentId = state.job and state.job.assignmentId or nil,
      groupJobId = state.job and state.job.groupJobId or nil,
      group = state.group and common.copy(state.group) or nil,
      reason = state.completionReason or service.reason or "aborted",
      returnReason = state.lastReturnReason or state.returnReason,
      ["return"] = state.serviceReturn and common.copy(state.serviceReturn) or nil,
      aborted = true,
      completedAt = common.nowSeconds(),
      elapsed = state.job and math.max(0, common.nowSeconds() - (state.job.startedAt or common.nowSeconds())) or 0,
      progress = state.job and { cursor = state.job.cursor or 0, total = state.job.total or 0 } or nil,
      stats = common.copy(state.stats),
      estimated = state.estimate and state.estimate.estimated or nil,
      actual = state.job and state.job.cursor or nil,
      materials = { torchCount = torchMaterialCount(), sealCount = sealMaterialCount() },
      discard = common.copy(state.discardStats or state.discard or {}),
      throughput = throughputSnapshot(),
      assignmentResumeToken = state.assignmentResumeToken and common.copy(state.assignmentResumeToken)
        or assignmentResumeSnapshot(state.resumeToken or state.checkpoint),
    }
    state.stats.jobReports = (state.stats.jobReports or 0) + 1
    if state.job then state.job.report = common.copy(state.report) end
    state.lastReport = common.copy(state.report)
    state.jobReport = common.copy(state.report)
  elseif finalStatus == "paused" then
    if not preserveCheckpoint then state.checkpoint = nil end
    state.status, state.phase = "paused", "home_paused"
  else
    state.checkpoint = nil
    state.status, state.phase = "working", "mining"
  end
  saveState("service_finished", true)
  heartbeat(true)
end

local function continueService()
  if not state.service then return true end
  state.status = "working"
  state.service.returnStartedAt = state.service.returnStartedAt or common.nowSeconds()
  state.service.returnDistance = state.service.returnDistance or 0
  state.serviceReturn = state.serviceReturn or {}
  state.serviceReturn.startedAt = state.serviceReturn.startedAt or common.nowSeconds()
  state.returnReason = state.service.reason or state.returnReason or "service"
  if not isHome() then
    state.phase = "returning"
    local returnDistance = estimatedReturnDistance(state.pose)
    if returnDistance then state.service.returnDistance = returnDistance end
    saveState("service_return_start", true)
    local preReturnGPS, preReturnError = verifyGPS(true)
    if not preReturnGPS then markBlocked("GPS verification before return failed: " .. tostring(preReturnError)); return false end
    local ok, err
    if state.job and state.job.strategy == "chunk_plan" then
      ok, err = navigateChunkPlanHome("service")
    else
      ok, err = navigateTo({ x = 0, y = 0, z = 0 }, "home", "service")
    end
    if not ok then
      if err == "control_request" then return false end
      markBlocked("Return to home failed: " .. tostring(err))
      return false
    end
  end

  local ok, err = turnTo(0)
  if not ok then markBlocked("Cannot face quarry at home: " .. tostring(err)); return false end
  if movementInterrupted("service") then return false end
  local dockGPS, dockGPSError = verifyGPS(true)
  if not dockGPS then markBlocked("GPS verification at dock failed: " .. tostring(dockGPSError)); return false end

  ok, err = unloadAtHome()
  if not ok then
    if err == "control_request" then return false end
    state.status, state.phase, state.lastError = "waiting_output", "waiting_output", err
    saveState(); heartbeat(true); return false
  end
  if movementInterrupted("service") then return false end

  ok, err = refuelAtHome()
  if not ok then
    if err == "control_request" then return false end
    state.status, state.phase, state.lastError = "waiting_fuel", "waiting_fuel", err
    saveState(); heartbeat(true); return false
  end
  if movementInterrupted("service") then return false end

  ok, err = refillSealAtHome()
  if not ok then
    if err == "control_request" then return false end
    state.status, state.phase, state.lastError = "waiting_seal", "waiting_seal", err
    saveState(); heartbeat(true); return false
  end
  if movementInterrupted("service") then return false end

  ok, err = refillTorchAtHome()
  if not ok then
    if err == "control_request" then return false end
    state.status, state.phase, state.lastError = "waiting_torch", "waiting_torch", err
    saveState("waiting_torch"); heartbeat(true); return false
  end
  if movementInterrupted("service") then return false end

  if state.service.resumeAfter and (state.resumeToken or state.checkpoint) then
    local token = state.resumeToken or state.checkpoint
    local checkpoint = poseCopy(token)
    checkpoint.dir = tonumber(token.dir) or checkpoint.dir
    state.phase, state.status, state.lastError = "going_back", "working", nil
    saveState("service_resume_start", true)
    local preResumeGPS, preResumeError = verifyGPS(true)
    if not preResumeGPS then markBlocked("GPS verification before resume failed: " .. tostring(preResumeError)); return false end
    if state.job and state.job.strategy == "chunk_plan" then
      ok, err = navigateChunkPlanWork(checkpoint, "service")
    else
      ok, err = navigateTo(checkpoint, "work", "service")
    end
    if not ok then
      if err == "control_request" then return false end
      markBlocked("Return to work point failed: " .. tostring(err))
      return false
    end
    ok, err = turnTo(checkpoint.dir)
    if not ok then markBlocked("Cannot restore work direction: " .. tostring(err)); return false end
    if movementInterrupted("service") then return false end
    local arrivedGPS, arrivedGPSError = verifyGPS(true)
    if not arrivedGPS then markBlocked("GPS verification after resume failed: " .. tostring(arrivedGPSError)); return false end
    if state.job and state.job.route then
      for _, key in ipairs({ "layer", "walkIndex", "localCursor", "phase", "currentKey" }) do
        if token[key] ~= nil then state.job.route[key] = token[key] end
      end
    end
    state.checkpoint = nil
    state.resumeToken = nil
  end
  state.service.returnEndedAt = common.nowSeconds()
  state.service.returnSeconds = math.max(0, state.service.returnEndedAt - (state.service.returnStartedAt or state.service.returnEndedAt))
