    return false, "Output inventory missing on configured side " .. outputSide .. "."
  end

  local policy, mode = discardPolicy()
  local discardStats = discardStatsTable()
  discardStats.lastError = nil
  local _, emptySlots = inventoryStats()
  local trigger = tonumber(policy.triggerEmptySlots) or 3
  local discardEnabled = mode ~= "KEEP_ALL" and emptySlots <= trigger
  local discardSide = policy.direction or "back"
  if discardSide == "up" then discardSide = "top" end
  if discardSide == "down" then discardSide = "bottom" end
  local outputTargetDir = sideTargetDirection(outRestore, outputSide)
  local discardTargetDir = sideTargetDirection(outRestore, discardSide)
  local discardInspect, _, discardDrop, discardRestore
  local discardReady, discardError = true, nil
  if discardEnabled and discardSide ~= outputSide then
    discardInspect, _, discardDrop, discardRestore, discardError = sideFunctions(discardSide)
    if not discardInspect then discardReady = false end
    local checkSide = (discardSide == "top" and "top") or (discardSide == "bottom" and "bottom") or "front"
    if discardReady and not inventoryPresent(checkSide, discardInspect) then
      discardReady, discardError = false, "Discard inventory missing on configured side " .. tostring(discardSide) .. "."
    end
  elseif discardEnabled then
    discardInspect, discardDrop, discardRestore = outInspect, outDrop, outRestore
  end
  if discardEnabled and not discardReady then
    restoreSideDirection(discardSide, discardRestore or outRestore)
    turtle.select(originalSlot)
    discardStats.lastError = discardError or "Discard inventory verification failed."
    saveState("discard_inventory_error")
    return false, discardStats.lastError
  end

  -- Consolidate locally before output.  This does not move the turtle and is
  -- deliberately independent of compactEvery service returns.
  compressSealStacks()
  local retainedCount = updateRecycleInventoryState()
  local maxStacks = math.max(1, math.floor(tonumber(policy.maxStacksPerPass) or 8))
  local discardedStacks, allDropped = 0, true
  local totalSeal = retainedCount

  -- Drop each slot as a whole stack.  Protected/valuable/unknown items are
  -- always routed to output, never the discard inventory.
  for slot = 1, 16 do
    local count, name = turtle.getItemCount(slot), itemName(slot)
    if count > 0 then
      local protected = discardProtectedItem(slot, name)
      local keepReserved = isSealItemName(name) or isTorchItemName(name)
        or (slotRoleContains(slot, "fuel") and isFuelItem(slot))
      local candidate = discardEnabled and discardedStacks < maxStacks
        and discardCandidate(slot, name, totalSeal, policy, mode)
      if candidate and isSealItemName(name) and totalSeal - count < (tonumber(policy.retainSealTarget) or 64) then
        candidate = false -- whole-stack semantics: never split below reserve
      end
      if candidate and discardDrop then
        if discardTargetDir ~= nil then turnTo(discardTargetDir) else turnTo(outRestore) end
        turtle.select(slot)
        discardStats.attempts = (discardStats.attempts or 0) + 1
        local before = turtle.getItemCount(slot)
        local prepared, prepareError = beginPhysicalAction("discard_home", {
          slot = slot, item = name, count = before, direction = discardSide,
        }, poseCopy())
        if not prepared then
          allDropped = false
          discardStats.lastError = prepareError or "Could not journal discard action."
          break
        end
        local dropped = discardDrop() -- no count argument: one complete stack
        local after = turtle.getItemCount(slot)
        if dropped and after == 0 then
          commitPhysicalAction()
          discardedStacks = discardedStacks + 1
          noteDiscard(name, before)
          if isSealItemName(name) then totalSeal = totalSeal - before end
        else
          cancelPhysicalAction()
          allDropped = false
          noteDiscardSkip(name, isUnknownModItem(name))
        end
      elseif keepReserved then
        -- Keep seal/torch/fuel material on the turtle.  It is never sent to
        -- either output or discard, even when the output chest is available.
      elseif not protected then
        if outputTargetDir ~= nil then turnTo(outputTargetDir) else turnTo(outRestore) end
        turtle.select(slot)
        local before = turtle.getItemCount(slot)
        local prepared, prepareError = beginPhysicalAction("unload_home", {
          slot = slot, item = name, count = before, direction = outputSide,
        }, poseCopy())
        if not prepared then
          allDropped = false
          discardStats.lastError = prepareError or "Could not journal output action."
          break
        end
        local dropped = outDrop() -- output receives all non-discard items
        if dropped and turtle.getItemCount(slot) == 0 then commitPhysicalAction()
        else cancelPhysicalAction(); allDropped = false end
      else
        -- Reserved seal/torch/fuel remain on the turtle.  Unknown and ore
        -- stacks are retained in the output path when they are not reserved.
          if not keepReserved then
            if outputTargetDir ~= nil then turnTo(outputTargetDir) else turnTo(outRestore) end
            turtle.select(slot)
          local before = turtle.getItemCount(slot)
          local prepared, prepareError = beginPhysicalAction("unload_home", {
            slot = slot, item = name, count = before, direction = outputSide,
          }, poseCopy())
          if not prepared then
            allDropped = false
            discardStats.lastError = prepareError or "Could not journal output action."
            break
          end
          local dropped = outDrop()
          if dropped and turtle.getItemCount(slot) == 0 then commitPhysicalAction()
          else cancelPhysicalAction(); allDropped = false end
        end
      end
    end
  end
  discardStats.passes = (discardStats.passes or 0) + (discardEnabled and 1 or 0)
  discardStats.enabled = mode ~= "KEEP_ALL"
  discardStats.triggered = discardEnabled
  discardStats.mode = mode
  local _, _, heldItems = inventoryStats()
  discardStats.held = heldItems
  if discardEnabled then discardStats.lastError = nil end

  local restored, restoreError = turnTo(outRestore)
  turtle.select(originalSlot)
  if not restored then return false, restoreError end
  if not allDropped then
    return false, "Output/discard inventory is full or a protected stack could not be retained safely."
  end
  updateRecycleInventoryState()
  state.stats.unloads = (state.stats.unloads or 0) + 1
  saveState("unload_done")
  return true
end

local function discardAtField()
  local policy, mode = discardPolicy()
  if mode == "KEEP_ALL" then return true end
  local _, emptySlots = inventoryStats()
  local trigger = tonumber(policy.triggerEmptySlots) or 3
  if emptySlots > trigger then return true end

  local discardStats = discardStatsTable()
  discardStats.lastError = nil
  local side = policy.direction or "back"
  if side == "up" then side = "top" end
  if side == "down" then side = "bottom" end
  local originalSlot = turtle.getSelectedSlot()
  local inspectFunction, _, dropFunction, restoreDir, sideError = sideFunctions(side)
  if not inspectFunction then
    discardStats.lastError = sideError or "Discard direction is invalid."
    turtle.select(originalSlot)
    return false, discardStats.lastError
  end
  local checkSide = (side == "top" and "top") or (side == "bottom" and "bottom") or "front"
  -- A configured inventory at the field direction is an explicit safety
  -- boundary: never accidentally inject a discard stack into it.
  if inventoryPresent(checkSide, inspectFunction) then
    discardStats.skipped = (discardStats.skipped or 0) + 1
    discardStats.lastError = "Field discard skipped because the configured direction contains an inventory."
    state.stats.discardSkipped = (state.stats.discardSkipped or 0) + 1
    restoreSideDirection(side, restoreDir)
    turtle.select(originalSlot)
    saveState("field_discard_inventory")
    return true
  end

  local _, _, totalItems = inventoryStats()
  local totalSeal = updateRecycleInventoryState()
  local maxStacks = math.max(1, math.floor(tonumber(policy.maxStacksPerPass) or 8))
  local discardedStacks = 0
  for slot = 1, 16 do
    if discardedStacks >= maxStacks then break end
    local count, name = turtle.getItemCount(slot), itemName(slot)
    if count > 0 and discardCandidate(slot, name, totalSeal, policy, mode)
      and not (isSealItemName(name) and totalSeal - count < (tonumber(policy.retainSealTarget) or 64)) then
      turtle.select(slot)
      discardStats.attempts = (discardStats.attempts or 0) + 1
      local before = turtle.getItemCount(slot)
      local prepared, prepareError = beginPhysicalAction("discard_field", {
        slot = slot, item = name, count = before, direction = side,
      }, poseCopy())
      if not prepared then
        discardStats.lastError = prepareError or "Could not journal field discard action."
        break
      end
      local dropped = dropFunction() -- world discard is always stack-at-a-time
      local after = turtle.getItemCount(slot)
      if dropped and after == 0 then
        commitPhysicalAction()
        discardedStacks = discardedStacks + 1
        noteDiscard(name, before)
        if isSealItemName(name) then totalSeal = totalSeal - before end
      else
        cancelPhysicalAction()
        noteDiscardSkip(name, isUnknownModItem(name))
        discardStats.lastError = "Field discard failed; stack retained."
      end
    end
  end
  discardStats.passes = (discardStats.passes or 0) + 1
  discardStats.enabled = true
  discardStats.mode = mode
  discardStats.lastAt = common.nowSeconds()
  discardStats.lastInventoryItems = totalItems
  restoreSideDirection(side, restoreDir)
  turtle.select(originalSlot)
  saveState("field_discard")
  return discardStats.lastError == nil, discardStats.lastError
end

local function targetFuelForService()
  local target = tonumber(config.fuelTarget) or 12000
  if state.service and state.service.resumeAfter and state.checkpoint then
    local checkpointDistance = estimatedReturnDistance(state.checkpoint)
    if not checkpointDistance then
      checkpointDistance = distance({ x = 0, y = 0, z = 0 }, state.checkpoint)
    end
    target = math.max(target, checkpointDistance * 2 + profileFuelBuffer())
  end
  local limit = fuelLimit()
  if limit == "unlimited" then return "unlimited" end
  if type(limit) == "number" and limit > 0 then target = math.min(target, limit) end
  return math.max(1, math.floor(target))
end

local function refuelAtHome()
  state.phase, state.status = "refueling", "working"
  saveState()
  local current = fuelLevel()
  if current == "unlimited" then return true end
  local target = targetFuelForService()
  local fuelSide = config.fuelSide or "top"
  local inspectFunction, suckFunction, dropFunction, restoreDir, sideError = sideFunctions(fuelSide)
  if not inspectFunction then return false, sideError end
  local checkSide = (fuelSide == "top" and "top") or (fuelSide == "bottom" and "bottom") or "front"
  if not inventoryPresent(checkSide, inspectFunction) then
    restoreSideDirection(fuelSide, restoreDir)
    return false, "Fuel inventory missing on configured side " .. fuelSide .. "."
  end
  if target == "unlimited" or current >= target then
    restoreSideDirection(fuelSide, restoreDir)
    return true
  end

  local originalSlot = turtle.getSelectedSlot()
  local attempts = 0
  while fuelLevel() ~= "unlimited" and fuelLevel() < target do
    drainNetwork(3)
    if movementInterrupted("service") then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
      return false, "control_request"
    end
    attempts = attempts + 1
    if attempts > 1024 then
      restoreSideDirection(fuelSide, restoreDir)
      turtle.select(originalSlot)
