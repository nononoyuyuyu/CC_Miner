
local function heartbeat(force)
  local now = common.nowSeconds()
  if force or now - lastHeartbeat >= (config.heartbeatSeconds or 2) then
    sendStatus()
    lastHeartbeat = now
  end
end

local function turnRight()
  local after = poseCopy()
  after.dir = (after.dir + 1) % 4
  local prepared, prepareError = beginPhysicalAction("turn_right", nil, after)
  if not prepared then return false, prepareError end
  local ok, err = turtle.turnRight()
  if not ok then cancelPhysicalAction(); return false, err or "Turn right failed." end
  state.pose.dir = after.dir
  state.stats.turns = (state.stats.turns or 0) + 1
  commitPhysicalAction()
  heartbeat(false)
  drainNetwork(2)
  return true
end

local function turnLeft()
  local after = poseCopy()
  after.dir = (after.dir + 3) % 4
  local prepared, prepareError = beginPhysicalAction("turn_left", nil, after)
  if not prepared then return false, prepareError end
  local ok, err = turtle.turnLeft()
  if not ok then cancelPhysicalAction(); return false, err or "Turn left failed." end
  state.pose.dir = after.dir
  state.stats.turns = (state.stats.turns or 0) + 1
  commitPhysicalAction()
  heartbeat(false)
  drainNetwork(2)
  return true
end

local function turnTo(targetDir)
  targetDir = targetDir % 4
  local diff = (targetDir - state.pose.dir) % 4
  if diff == 1 then return turnRight() end
  if diff == 2 then
    local ok, err = turnRight()
    if not ok then return false, err end
    return turnRight()
  end
  if diff == 3 then return turnLeft() end
  return true
end

local movement = {
  forward = {
    move = turtle.forward, inspect = turtle.inspect, dig = turtle.dig,
    place = turtle.place, attack = turtle.attack, side = "front",
  },
  up = {
    move = turtle.up, inspect = turtle.inspectUp, dig = turtle.digUp,
    place = turtle.placeUp, attack = turtle.attackUp, side = "top",
  },
  down = {
    move = turtle.down, inspect = turtle.inspectDown, dig = turtle.digDown,
    place = turtle.placeDown, attack = turtle.attackDown, side = "bottom",
  },
}

local function blockName(data)
  return type(data) == "table" and tostring(data.name or "unknown") or "unknown"
end

local function isProtected(data)
  local name = blockName(data)
  return config.protectedBlocks and config.protectedBlocks[name] == true, name
end

local function isLava(data)
  return string.lower(blockName(data)):find("lava", 1, true) ~= nil
end

local function isWater(data)
  local name = string.lower(blockName(data))
  return name:find("water", 1, true) ~= nil
end

local function waterMode()
  local mode = state.job and state.job.waterMode
  if not mode then mode = config.waterMode or (config.water and config.water.mode) or state.water.mode end
  mode = tostring(mode or "ignore")
  if mode ~= "ignore" and mode ~= "stop" and mode ~= "seal" then mode = "ignore" end
  return mode
end

local function maxContinuousSeal()
  return profileMaxContinuousSeal()
end

local function isInventoryBlock(side, data)
  if peripheral and peripheral.hasType then
    local ok, result = pcall(peripheral.hasType, side, "inventory")
    if ok and result == true then return true end
  end
  local wrapped = peripheral and peripheral.wrap(side) or nil
  if wrapped and (type(wrapped.list) == "function" or type(wrapped.size) == "function") then return true end
  local name = string.lower(blockName(data))
  for _, marker in ipairs({ "chest", "barrel", "shulker_box", "drawer", "crate", "vault" }) do
    if name:find(marker, 1, true) then return true end
  end
  return false
end

local function movementInterrupted(context)
  if context ~= "mining" and context ~= "service" then return false end
  if state.status ~= "working" then return true end
  -- Only an immediate pause/return/abort interrupts an in-flight move.  A
  -- finish_row/finish_layer request is evaluated by the route boundary logic.
  if state.request == "pause_now" or state.request == "return_home" or state.request == "abort" or state.request == "recall" or state.request == "service" then
    return true
  end
  return false
end

local function updatePoseAfterMove(direction)
  state.pose = geo.poseAfterMove(state.pose, direction)
  state.stats.moves = (state.stats.moves or 0) + 1
  state.routeMetrics = state.routeMetrics or { moves = 0, turns = 0, distance = 0 }
  state.routeMetrics.moves = (state.routeMetrics.moves or 0) + 1
  state.routeMetrics.distance = (state.routeMetrics.distance or 0) + 1
  state.stats.routeMoves = (state.stats.routeMoves or 0) + 1
  state.stats.routeDistance = (state.stats.routeDistance or 0) + 1
  state.timeMetrics = state.timeMetrics or {}
  state.timeMetrics.lastMoveAt = common.nowSeconds()
end

local function sealFluid(action, direction, data, fluidKind)
  fluidKind = fluidKind or (isWater(data) and "water" or "lava")
  local mode = fluidKind == "water" and waterMode() or (config.lavaMode or "seal")
  if mode ~= "seal" then
    if fluidKind == "water" and mode == "stop" then
      state.stats.waterBlocked = (state.stats.waterBlocked or 0) + 1
      state.stats.waterStopped = (state.stats.waterStopped or 0) + 1
      state.water.blocked = (state.water.blocked or 0) + 1
      state.water.stopped = (state.water.stopped or 0) + 1
      state.water.last = { kind = "water", name = blockName(data), pose = poseCopy() }
    end
    return false, fluidKind .. ":" .. blockName(data)
  end
  local continuous = tonumber(state.fluidSealRun) or 0
  if continuous >= maxContinuousSeal() then
    if fluidKind == "water" then state.stats.waterBlocked = (state.stats.waterBlocked or 0) + 1 end
    return false, fluidKind == "water" and "water_seal_limit" or "lava_seal_limit"
  end
  local originalSlot = turtle.getSelectedSlot()
  local slot = selectSealMaterial()
  if not slot then
    turtle.select(originalSlot)
    return false, "seal_material"
  end
  local material = itemName(slot)
  local prepared, prepareError = beginPhysicalAction("seal_" .. fluidKind .. "_" .. direction, {
    fluid = blockName(data), material = material, fluidKind = fluidKind,
  }, poseCopy())
  if not prepared then turtle.select(originalSlot); return false, prepareError end
  local placed, placeReason = action.place()
  turtle.select(originalSlot)
  if not placed then
    cancelPhysicalAction()
    return false, "lava_seal_failed:" .. tostring(placeReason or blockName(data))
  end
  if fluidKind == "water" then
    state.stats.waterSealed = (state.stats.waterSealed or 0) + 1
    state.water.sealed = (state.water.sealed or 0) + 1
    state.water.lastRun = continuous + 1
  else
    state.stats.lavaSealed = (state.stats.lavaSealed or 0) + 1
  end
  state.fluidSealRun = continuous + 1
  state.water.continuousSeals = state.fluidSealRun
  state.fluidSealMarker = {
    kind = fluidKind,
    direction = direction,
    material = material,
    pose = poseCopy(),
    at = common.nowSeconds(),
  }
  commitPhysicalAction()
  sleep(0.15)
  return true
end

local function sealLava(action, direction, data)
  return sealFluid(action, direction, data, "lava")
end

local function effectiveLighting()
  -- lighting.mode is an explicit safety choice and is never changed by a
  -- profile.  Profiles only adjust the requested placement cadence.
  return effectiveLightingValues()
end

local function noteMinedMaterial(name)
  if not isSealItemName(name) then return end
  local materials, recycle = materialsConfig()
  local enabled = materials.recycleMinedBlocks
  if enabled == nil then enabled = recycle.enabled end
  if enabled == false then return end
  state.recycle = state.recycle or { byName = {}, held = 0, cap = 64, overflow = 0 }
  state.recycle.byName = state.recycle.byName or {}
  state.recycle.byName[name] = (state.recycle.byName[name] or 0) + 1
  state.recycle.held = (state.recycle.held or 0) + 1
  state.recycle.cap = math.max(0, math.floor(tonumber(materials.retainSealTarget or recycle.maxHeld or config.retainSealTarget or config.sealTarget or state.recycle.cap or 64) or 64))
  if state.recycle.held > state.recycle.cap then
    state.recycle.overflow = state.recycle.held - state.recycle.cap
  end
  state.stats.recycledBlocks = (state.stats.recycledBlocks or 0) + 1
  state.stats.recycled = (state.stats.recycled or 0) + 1
end

local function isGravityBlock(data)
  local name = string.lower(blockName(data))
  for _, marker in ipairs({ "sand", "gravel", "concrete_powder", "anvil", "dragon_egg", "scaffolding" }) do
    if name:find(marker, 1, true) then return true end
  end
  return false
end

local function tryPlaceTorchWall(relativeDir)
  local originalDir = state.pose.dir
  local originalSlot = turtle.getSelectedSlot()
  local targetDir = (originalDir + relativeDir) % 4
  local turned, turnError = turnTo(targetDir)
  if not turned then return false, turnError end

  local function restoreContext(reason)
    turtle.select(originalSlot)
    local restored, restoreError = turnTo(originalDir)
    if not restored then return false, restoreError end
    return false, reason
  end

  local present, data = turtle.inspect()
  if present then
    if relativeDir ~= 1 and relativeDir ~= 3 then return restoreContext("occupied") end
    local protected, name = isProtected(data)
    if protected or isInventoryBlock("front", data) or isLava(data) or isWater(data) or isGravityBlock(data) then
      return restoreContext("occupied")
    end
    local _, emptySlots = inventoryStats()
    if emptySlots <= 0 then return restoreContext("inventory_full") end
    -- In a normal 1x1 tunnel, carve a one-block niche only from an ordinary
    -- solid side block.  The dig and subsequent place are separately journaled
    -- so a power loss can be re-inspected idempotently.
    turtle.select(originalSlot)
    local prepared, prepareError = beginPhysicalAction("dig_torch_niche_forward", {
      block = name, side = relativeDir,
    }, poseCopy())
    if not prepared then return restoreContext(prepareError) end
    local dug, digError = turtle.dig()
    if not dug then
      cancelPhysicalAction()
      return restoreContext(digError or "torch_niche_dig_failed")
    end
    state.stats.blocksDug = (state.stats.blocksDug or 0) + 1
    noteMinedMaterial(name)
    state.fluidSealRun = 0
    state.fluidSealMarker = nil
    commitPhysicalAction()
    local slot = selectTorchMaterial()
    if not slot then return restoreContext("torch_material") end
    local placedPrepared, placedPrepareError = beginPhysicalAction("torch_niche_forward", {
      side = relativeDir, material = itemName(slot),
    }, poseCopy())
    if not placedPrepared then return restoreContext(placedPrepareError) end
    local placed, placeError = turtle.place()
    if not placed then
      cancelPhysicalAction()
      return restoreContext(placeError or "torch_niche_place_failed")
    end
    state.stats.torchesPlaced = (state.stats.torchesPlaced or 0) + 1
    state.lighting.placed = (state.lighting.placed or 0) + 1
    state.lighting.torchesPlaced = (state.lighting.torchesPlaced or 0) + 1
    commitPhysicalAction()
    turtle.select(originalSlot)
    local restored, restoreError = turnTo(originalDir)
    if not restored then return false, restoreError end
    state.lighting.lastAt = common.nowSeconds()
    state.lighting.lastPose = poseCopy()
    return true
  end

  local slot = selectTorchMaterial()
  if not slot then return restoreContext("torch_material") end
  local prepared, prepareError = beginPhysicalAction("torch_wall", {
    side = relativeDir, material = itemName(slot), pose = poseCopy(),
  }, poseCopy())
  if not prepared then return restoreContext(prepareError) end
  local placed, placeError = turtle.place()
  if placed then
    state.stats.torchesPlaced = (state.stats.torchesPlaced or 0) + 1
    state.lighting.placed = (state.lighting.placed or 0) + 1
    state.lighting.torchesPlaced = (state.lighting.torchesPlaced or 0) + 1
    commitPhysicalAction()
  else
    cancelPhysicalAction()
  end
  turtle.select(originalSlot)
  local restored, restoreError = turnTo(originalDir)
