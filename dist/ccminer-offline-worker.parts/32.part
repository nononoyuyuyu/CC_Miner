    lastReason = moveReason or lastReason
    local blockedNow = action.inspect()
    if not blockedNow then
      if config.attackEntities and action.attack then pcall(action.attack) end
      sleep(retryDelay)
    else
      sleep(0.1)
    end
  end
  return false, lastReason
end

local function moveX(targetX, context)
  while state.pose.x ~= targetX do
    local targetDir = state.pose.x < targetX and 1 or 3
    local ok, err = turnTo(targetDir)
    if not ok then return false, err end
    ok, err = moveOne("forward", context)
    if not ok then return false, err end
  end
  return true
end

local function moveZ(targetZ, context)
  while state.pose.z ~= targetZ do
    local targetDir = state.pose.z < targetZ and 0 or 2
    local ok, err = turnTo(targetDir)
    if not ok then return false, err end
    ok, err = moveOne("forward", context)
    if not ok then return false, err end
  end
  return true
end

local function moveY(targetY, context)
  while state.pose.y < targetY do
    local ok, err = moveOne("up", context)
    if not ok then return false, err end
  end
  while state.pose.y > targetY do
    local ok, err = moveOne("down", context)
    if not ok then return false, err end
  end
  return true
end

local function navigateTo(target, route, context)
  target = target or { x = 0, y = 0, z = 0 }
  local ok, err
  if route == "home" then
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
  elseif route == "inside" then
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
  else
    ok, err = moveZ(target.z or 0, context); if not ok then return false, err end
    ok, err = moveX(target.x or 0, context); if not ok then return false, err end
    ok, err = moveY(target.y or 0, context); if not ok then return false, err end
  end
  return true
end

local function chunkAnchor(plan, key, y)
  local chunk = plan and plan.chunks and plan.chunks[key]
  if not chunk then return nil, "Unknown chunk " .. tostring(key) end
  return { x = chunk.anchor.x, y = y, z = chunk.anchor.z }
end

local function serviceDockAnchor(plan, y)
  local key = plan and (plan.dockKey or plan.entranceKey or plan.rootKey)
  if not key then return nil, "Service plan has no dock chunk." end
  local anchor, err = chunkAnchor(plan, key, y)
  if not anchor then return nil, err end
  anchor.chunkKey = key
  return anchor, key
end

local function moveBetweenChunkAnchors(plan, fromKey, toKey, y, context)
  local from = plan.chunks[fromKey]
  local target, err = chunkAnchor(plan, toKey, y)
  if not from or not target then return false, err or "Missing chunk anchor." end
  local adjacent = false
  for _, key in ipairs(from.neighbors or {}) do if key == toKey then adjacent = true; break end end
  if not adjacent then return false, "Chunk route is not adjacent: " .. tostring(fromKey) .. " -> " .. tostring(toKey) end
  return navigateTo(target, "inside", context)
end

local function normalizeWaypoint(value, fallbackY)
  if type(value) ~= "table" then return nil end
  local pose = value.pose or value.position or value.target or value
  if type(pose) ~= "table" then return nil end
  local x, z = tonumber(pose.x), tonumber(pose.z)
  if not x or not z then return nil end
  return { x = x, y = tonumber(pose.y) or tonumber(fallbackY) or 0, z = z,
    dir = pose.dir ~= nil and ((tonumber(pose.dir) or 0) % 4) or nil }
end

local function routeChunkKeys(plan, fromKey, toKey)
  if type(quarry.shortestChunkPath) == "function" then
    local ok, path = pcall(quarry.shortestChunkPath, plan, fromKey, toKey)
    if ok and type(path) == "table" then path = path.chunkKeys or path.path or path.keys end
    if ok and type(path) == "table" and #path > 0 then return path, "bfs" end
  end
  if fromKey == toKey then return { fromKey }, "same" end
  return nil
end

-- Assigned plans intentionally do not persist mutable parent pointers, so a
-- worker that resumes with an older quarry module may not have pathToRoot.
-- Keep a bounded graph-only DFS fallback over the validated neighbor edges.
local function dfsChunkPath(plan, fromKey, toKey)
  if fromKey == toKey then return { fromKey } end
  local chunks = plan and plan.chunks or {}
  if not chunks[fromKey] or not chunks[toKey] then return nil end
  local visited = { [fromKey] = true }
  local stack = { { key = fromKey, next = 1 } }
  local parent = {}
  while #stack > 0 do
    local frame = stack[#stack]
    if frame.key == toKey then
      local path, key = {}, toKey
      while key do path[#path + 1] = key; key = parent[key] end
      local reversed = {}
      for index = #path, 1, -1 do reversed[#reversed + 1] = path[index] end
      return reversed
    end
    local neighbors = chunks[frame.key].neighbors or {}
    local nextKey
    while frame.next <= #neighbors do
      local candidate = tostring(neighbors[frame.next]); frame.next = frame.next + 1
      if chunks[candidate] and not visited[candidate] then nextKey = candidate; break end
    end
    if nextKey then
      visited[nextKey] = true; parent[nextKey] = frame.key
      stack[#stack + 1] = { key = nextKey, next = 1 }
    else
      stack[#stack] = nil
    end
  end
  return nil
end

local function transitionWaypoints(plan, fromKey, toKey, y)
  if type(quarry.edgeTransition) == "function" then
    local attempts = {
      function() return quarry.edgeTransition(plan, fromKey, toKey, y) end,
      function() return quarry.edgeTransition(plan, plan.chunks[fromKey], plan.chunks[toKey], y) end,
    }
    for _, attempt in ipairs(attempts) do
      local ok, result = pcall(attempt)
      if ok and result then
        if type(result) == "table" and (result.waypoints or result.path) then result = result.waypoints or result.path end
        if type(result) == "table" and result.from and result.to then
          -- New quarry API returns one validated edge as `{from,to}`;
          -- normalize it to the waypoint sequence consumed by the turtle.
          result = { result.from, result.to }
        end
        if type(result) == "table" then
          local normalized = {}
          for _, waypoint in ipairs(result) do
            local item = normalizeWaypoint(waypoint, y)
            if item then normalized[#normalized + 1] = item end
          end
          if #normalized > 0 then return normalized end
        end
      end
    end
  end
  return nil
end

local function navigateServiceRoute(plan, fromPose, toPose, context, mode)
  if not plan then return navigateTo(toPose, mode or "work", context) end
  fromPose, toPose = poseCopy(fromPose), poseCopy(toPose)
  local endpointFromKey = quarry.findChunk(plan, fromPose.x, fromPose.z)
  local endpointToKey = quarry.findChunk(plan, toPose.x, toPose.z)
  if not endpointFromKey or not endpointToKey then
    return false, "Service route endpoint is outside the assigned chunk plan."
  end
  local routeResult
  if type(quarry.shortestServiceRoute) == "function" then
    local ok, result = pcall(quarry.shortestServiceRoute, plan, fromPose, toPose, {
      mode = mode or "work", context = context,
      breadcrumbs = state.job and state.job.route and state.job.route.breadcrumbs or nil,
    })
    if ok and type(result) == "table" then routeResult = result end
  end
