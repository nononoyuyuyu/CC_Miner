  if config.remoteConsole.enabled ~= true then
    return false, "Remote console is disabled.", nil, nil
  end
  local action = string.lower(common.trim(payload.action or payload.remoteAction or ""))
  remoteSessionExpired()
  if action == "open" then
    local pinnedController = tonumber(config.controllerId or 0) or 0
    if config.remoteConsole.allowShell == true and pinnedController <= 0 then
      return false, "Arbitrary remote shell requires a pinned controllerId.", nil, nil
    end
    if pinnedController > 0 and tonumber(sender) ~= pinnedController then
      return false, "Remote console sender is not the pinned controller.", nil, nil
    end
    if remoteSession then
      if tonumber(remoteSession.sender) ~= tonumber(sender) then
        return false, "Remote console session is already open for another controller.", nil, nil
      end
      -- Re-opening from the pinned controller is idempotent.  This recovers
      -- when the OPEN ACK was lost without making the operator wait for the
      -- whole session timeout or issuing a second shell session.
      local existing = {
        action = "open",
        sessionId = remoteSession.sessionId,
        nonce = remoteSession.nonce,
        expiresAt = remoteSession.expiresAt,
        seq = tonumber(remoteSession.lastSeq) or 0,
        nextSeq = (tonumber(remoteSession.lastSeq) or 0) + 1,
        resumed = true,
      }
      return true, "Remote console session resumed.", existing, existing
    end
    local ready, readyError = remoteConsoleReady()
    if not ready then return false, readyError, nil, nil end
    local now = common.nowSeconds()
    remoteSession = {
      sessionId = remoteToken("session", sender),
      nonce = remoteToken("nonce", sender),
      sender = tonumber(sender),
      openedAt = now,
      expiresAt = now + math.max(1, math.floor(tonumber(config.remoteConsole.sessionSeconds) or 120)),
      lastSeq = 0,
    }
    remoteAuditRecord("remote_console open", true)
    local result = {
      action = "open",
      sessionId = remoteSession.sessionId,
      nonce = remoteSession.nonce,
      expiresAt = remoteSession.expiresAt,
      seq = 0,
      nextSeq = 1,
    }
    return true, "Remote console session opened.", result, result
  elseif action == "exec" or action == "close" then
    if action == "exec" then
      local ready, readyError = remoteConsoleReady()
      if not ready then return false, readyError, nil, nil end
    end
    local consumed, consumeError, consumedSeq = remoteConsumeSession(sender, payload)
    if not consumed then return false, consumeError, nil, nil end
    local sessionId = remoteSession and remoteSession.sessionId
    if action == "close" then
      remoteAuditRecord("remote_console close", true)
      remoteSession = nil
      return true, "Remote console session closed.", {
        action = "close", closed = true, sessionId = sessionId, seq = consumedSeq,
      }, nil
    end
    local commandText = payload.commandText or payload.commandLine or payload.execCommand
      or payload.cmd or payload.input or payload.text
    if type(commandText) ~= "string" then
      remoteAuditRecord("remote_console exec", false)
      return false, "Remote console command text is required.", {
        action = "exec", seq = consumedSeq,
        output = "", truncated = false,
        nextSeq = (tonumber(remoteSession.lastSeq) or 0) + 1,
      }, nil
    end
    commandText = common.trim(commandText)
    if not config.remoteConsole.allowShell and not remoteSafeCommand(commandText) then
      remoteAuditRecord(commandText, false)
      return false, "Remote console command is not on the safe allowlist.", {
        action = "exec", seq = consumedSeq,
        output = "", truncated = false,
        nextSeq = (tonumber(remoteSession.lastSeq) or 0) + 1,
      }, nil
    end
    local ok, text, result = runRemoteShell(commandText)
    remoteAuditRecord(commandText, ok)
    result = result or { output = "", truncated = false }
    result.action, result.seq = "exec", consumedSeq
    result.nextSeq = (tonumber(remoteSession.lastSeq) or 0) + 1
    return ok, text, result, nil
  end
  return false, "Unknown remote console action: " .. tostring(action), nil, nil
end

local function applyControlCommand(command, payload, sender)
  payload = payload or {}
  if command == "remote_console" then
    return remoteConsoleAction(sender, payload)
  end
  -- Movement/job commands take priority over maintenance.  Close the
  -- in-memory console before accepting any command which may leave the dock,
  -- so a forgotten terminal can never remain attached during mining.
  if remoteSession and ({
    start = true, resume = true, recall = true, service = true, abort = true,
    stop = true, pause = true, pause_now = true, finish_row = true,
    finish_layer = true, return_home = true, calibrate_gps = true, rehome = true,
  })[tostring(command)] then
    remoteAuditRecord("remote_console auto_close", true)
    remoteSession = nil
  end
  if command == "pause_now" or command == "finish_row" or command == "finish_layer" or command == "return_home" then
    payload.mode = command
    command = "stop"
  end
  if state.pendingAction and command ~= "rehome" and command ~= "ping" and command ~= "status" and command ~= "gps_fix" then
    return false, "Recovery required: return the turtle to its dock and use REHOME, or reboot with working GPS recovery."
  end
  if command == "discard_config" then
    if not isHome() then return false, "Discard settings can only be changed while the worker is at its dock." end
    if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output"
      or state.status == "waiting_seal" or state.status == "waiting_torch" or state.service or state.request then
      return false, "Stop the worker at its dock before changing discard settings."
    end
    local mode = tostring(payload.mode or "KEEP_ALL"):upper()
    if mode ~= "KEEP_ALL" and mode ~= "DISCARD_EXCESS_STONE" and mode ~= "CUSTOM_ALLOWLIST" then
      return false, "Unknown discard mode: " .. mode
    end
    if payload.allowlist ~= nil and type(payload.allowlist) ~= "table" then
      return false, "Discard allowlist must be a list of complete item IDs."
    end
    local allowlist, seen = {}, {}
    for _, raw in ipairs(payload.allowlist or {}) do
      local name = tostring(raw)
      if #name > 128 or not name:match("^[a-z0-9_.-]+:[a-z0-9_./-]+$") then
        return false, "Invalid item ID in discard allowlist: " .. name
      end
      if not seen[name] then
        if #allowlist >= 64 then return false, "Discard allowlist is limited to 64 item IDs." end
        seen[name] = true
        allowlist[#allowlist + 1] = name
      end
    end
    local nextPolicy = common.copy(config.discard or {})
    nextPolicy.mode, nextPolicy.allowlist = mode, allowlist
    config.discard = nextPolicy
    config.materials = config.materials or {}
    config.materials.discard = common.copy(nextPolicy)
    local saved, saveError = common.saveConfig(config)
    if saved == false then return false, "Could not save discard settings: " .. tostring(saveError) end
    state.discardStats = state.discardStats or {}
    state.discardStats.mode = mode
    state.discardStats.allowlist = common.copy(allowlist)
    saveState("discard_config")
    return true, ("Discard settings saved: %s (%d selected)."):format(mode, #allowlist)
  elseif command == "start" then
    return startJob(payload)
  elseif command == "stop" then
    if not state.job then return false, "No active job." end
    local mode = tostring(payload.mode or "pause_now")
    local allowed = {
      pause_now = true, finish_row = true, finish_layer = true,
      return_home = true, abort = true,
    }
    if not allowed[mode] then return false, "Unknown staged stop mode: " .. mode end
    state.stagedStop = {
      mode = mode,
      requestedAt = common.nowSeconds(),
      requestedBy = payload.requestedBy and tostring(payload.requestedBy) or nil,
      source = "stop",
    }
    if mode == "pause_now" then
      state.request = "pause_now"
      if state.status ~= "working" then state.status = "working" end
    elseif mode == "return_home" or mode == "abort" then
      state.request = mode
      if mode == "abort" then state.completionReason = "aborted" end
      if state.status ~= "working" then state.status = "working" end
    elseif state.status ~= "working" then
      state.status = "working"
    end
    saveState("stop_" .. mode)
    return true, "Staged stop accepted: " .. mode
  elseif command == "pause" then
    if state.status == "working" or state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
      state.stagedStop = { mode = "pause_now", requestedAt = common.nowSeconds(), source = "pause" }
      state.request = "pause_now"
      if state.status ~= "working" then state.status = "working" end
      saveState("pause")
      return true, "Pause accepted; stopping at the next safe boundary."
    end
    return false, "Worker is not running."
  elseif command == "resume" then
    if state.status == "paused" or state.status == "blocked" then
      if state.status == "blocked" then
        local criticalPhase = {
          state_corrupt = true,
          gps_drift = true,
          recovery_required = true,
          gps_error = true,
        }
        if criticalPhase[tostring(state.phase or "")] then
          return false, "Cannot resume from " .. tostring(state.phase) .. "; resolve GPS/state recovery or use REHOME first."
        end
      end
      state.lastError = nil
      state.stagedStop = false
      if state.service then
        state.status, state.phase = "working", "service_requested"
      elseif isHome() and state.checkpoint and state.job then
        state.service = { resumeAfter = true, finalStatus = "working", preserveCheckpoint = false, reason = "resume" }
        state.status, state.phase = "working", "resume_service"
      else
        state.status, state.phase = "working", "mining"
      end
      state.request = nil
      saveState("resume", true)
      return true, "Resume accepted."
    elseif state.status == "waiting_fuel" or state.status == "waiting_output" or state.status == "waiting_seal" or state.status == "waiting_torch" then
      state.status = "working"
      saveState()
      return true, "Service retry accepted."
    end
    return false, "Worker is not paused or blocked."
  elseif command == "recall" then
    if not state.job then return false, "No active job." end
    state.request = "recall"
    state.stagedStop = { mode = "return_home", requestedAt = common.nowSeconds(), source = "recall" }
    if state.status ~= "working" then state.status = "working" end
    saveState()
    return true, "Recall accepted. Worker will return and pause."
  elseif command == "service" then
    if not state.job then return false, "No active job." end
    state.request = "service"
    if state.status ~= "working" then state.status = "working" end
    saveState()
    return true, "Service return accepted."
  elseif command == "abort" then
    if not state.job then return false, "No job to abort." end
    state.request = "abort"
    state.completionReason = "aborted"
    state.stagedStop = { mode = "abort", requestedAt = common.nowSeconds(), source = "abort" }
    if state.status ~= "working" then state.status = "working" end
    saveState()
    return true, "Abort accepted. Worker will return home."
  elseif command == "clear" then
    if state.pendingAction then return false, "Cannot clear while physical position is uncertain." end
    if not isHome() then return false, "Worker must be at home." end
    if state.job and state.status ~= "complete" and state.status ~= "aborted" then
      return false, "Cannot clear an unfinished job; ABORT it first."
    end
    if not state.job and state.status ~= "idle" then
