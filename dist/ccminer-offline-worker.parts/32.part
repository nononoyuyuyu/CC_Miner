        if dug then
          state.stats.blocksDug = (state.stats.blocksDug or 0) + 1
          if not preserveSealMarker then noteMinedMaterial(name) end
          commitPhysicalAction()
          sleep(0.1)
        else
          cancelPhysicalAction()
          lastReason = digReason or ("Cannot dig " .. name)
          sleep(retryDelay)
        end
      end
    end

    local after = geo.poseAfterMove(state.pose, direction)
    local prepared, prepareError = beginPhysicalAction("move_" .. direction, nil, after)
    if not prepared then return false, prepareError end
    local moved, moveReason = action.move()
    if moved then
      updatePoseAfterMove(direction)
      -- A successful move normally ends a fluid-seal run.  When the moved
      -- block was the seal marker we just carved, preserve the run so a
      -- contiguous fluid column reaches maxContinuousSeal across cells.
      if preserveSealMarker then
        state.fluidSealMarker = nil
      else
        state.fluidSealRun = 0
        state.water.continuousSeals = 0
        state.fluidSealMarker = nil
