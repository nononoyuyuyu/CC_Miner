  -- Emergency fuel/service requests take precedence over ordinary staggered
  -- starts.  The cap is persisted per group so restarts cannot overfill a bay.
  for _, job in pairs(db.groupJobs or {}) do
    if type(job) == "table" and (job.status == "starting" or job.status == "queued" or job.status == "working" or job.status == "PARTIAL_START") then
      local group = groupRecord(job.groupId)
      job.awaitingAck = job.awaitingAck or {}
      job.pending = job.pending or {}
      job.attempts = job.attempts or {}
      if job.pendingReassignment and now - tonumber(job.pendingReassignment.sentAt or now) >= 10 then
        local pending = job.pendingReassignment
        job.pendingReassignment = nil
        job.alerts = job.alerts or {}
        job.alerts[#job.alerts + 1] = "REASSIGN_TIMEOUT:#" .. tostring(pending.targetWorkerId)
        updateGroupAggregate(job)
        saveControllerDb()
      end
      for waitingKey, waiting in pairs(job.awaitingAck) do
        if now - tonumber(waiting.sentAt or now) >= 10 then
          local attempts = tonumber(job.attempts[waitingKey] or waiting.attempts or 1)
          job.awaitingAck[waitingKey] = nil
          if attempts >= 2 then
            rejectGroupStart(job, waitingKey, "start ACK timeout")
          else
            job.pending[waitingKey] = true
            local assignment = job.assignments and (job.assignments[waitingKey] or job.assignments[tonumber(waitingKey)])
            if assignment then assignment.status = "queued" end
            job.nextDispatchAt = now
          end
        end
      end
      local limit = math.max(1, tonumber(group and group.replenishConcurrency or db.groupScheduler.replenishConcurrency) or 1)
      local activeService = 0
      job.serviceSentAt = job.serviceSentAt or {}
      for _, id in ipairs(groupWorkerIds(group)) do
        local data = workerData(id) or {}
        if data.status == "waiting_fuel" or tonumber(data.fuel) and tonumber(data.fuel) <= tonumber(data.fuelLowWatermark or 0) then
          activeService = activeService + 1
          if activeService <= limit and now - tonumber(job.serviceSentAt[tostring(id)] or 0) >= 5 then
            sendCommand(id, "service", { scope = "group", group = true, groupCommand = "SERVICE", groupId = job.groupId, groupJobId = job.groupJobId, priority = "EMERGENCY_FUEL", targetWorkerId = id, workerId = id })
            job.serviceSentAt[tostring(id)] = now
          end
        end
      end
      if job.status == "starting" and now >= tonumber(job.nextDispatchAt or 0) then dispatchGroupJob(job, false) end
    end
  end
end

local function buildAssignments(result)
  local id, worker = draftWorker()
  if not id or not worker then return nil, "No worker selected." end
  -- A worker's calibrated home is the authoritative entrance for its plan.
  -- Until a future protocol can describe independent entrances, never split a
  -- single footprint at runtime; queue dispatch below handles parallel jobs.
  local assignments = {}
  local base = "q-" .. tostring(os.getComputerID()) .. "-" .. tostring(common.nowMillis())
  local selectedKeys = {}
  for _, chunk in ipairs(result.catalog or {}) do
    local excluded = false
    for _, item in ipairs(result.excludedChunks or {}) do if item.key == chunk.key then excluded = true; break end end
    if not excluded then selectedKeys[#selectedKeys + 1] = chunk.key end
  end
  assignments[1] = { workerId = id, assignmentId = base .. ":1", jobId = base, chunks = selectedKeys }
  return assignments
end

local function startDraft()
  if not draft then return false end
  local result = draft.preflight or computePreflight()
  if not result then setNotice("Preflight failed.", true); return false end
  if result.fatal then setNotice("Start blocked by a fatal preflight item.", true); return false end
  local assignments, assignmentError = buildAssignments(result)
  if not assignments then setNotice(assignmentError, true); return false end
  local leases = {}
  for _, assignment in ipairs(assignments) do
    local lease, err = reserveLease(assignment.jobId, assignment.workerId, result.chunkMode, assignment.chunks, assignment.assignmentId)
    if not lease then
      for _, prior in ipairs(leases) do releaseLeasesForWorker(prior.workerId, prior.jobId) end
      setNotice(err, true)
      return false
    end
    leases[#leases + 1] = lease
  end
  local sent, sentAssignments = true, {}
  for _, assignment in ipairs(assignments) do
    local payloadDepth = result.jobDepth or draft.depth
    local payloadLighting = common.copy(draft.lighting)
    if type(payloadLighting) ~= "table" then payloadLighting = { mode = "safe" } end
    if result.effectiveInterval == 0 then payloadLighting.interval = nil else payloadLighting.interval = result.effectiveInterval end
    local payload = {
      width = draft.width, length = draft.length, depth = payloadDepth,
      chunkMode = result.chunkMode, excludedChunks = result.excludedChunks,
      lighting = payloadLighting, waterMode = draft.waterMode, profile = draft.profile,
      name = draft.name or ("Quarry %dx%dx%d"):format(draft.width, draft.length, payloadDepth),
      jobId = assignment.jobId, assignmentId = assignment.assignmentId,
    }
    if result.chunkMode == "world" then payload.targetY = result.targetY end
    if not sendCommand(assignment.workerId, "start", payload) then sent = false; break end
    sentAssignments[#sentAssignments + 1] = assignment
  end
  if not sent then
    for _, assignment in ipairs(sentAssignments) do sendCommand(assignment.workerId, "stop", { mode = "abort", assignmentId = assignment.assignmentId }) end
    for _, assignment in ipairs(assignments) do releaseLeasesForWorker(assignment.workerId, assignment.jobId) end
    setNotice("One or more workers rejected the job; all assignments were stopped.", true)
    return false
  end
  db.lastDraft = persistentDraft(draft)
  db.lastPreset = draft.profile or db.lastPreset
  if draft.queueIndex and db.queue[draft.queueIndex] then
    db.queue[draft.queueIndex].awaiting = { workerId = assignments[1].workerId, jobId = assignments[1].jobId, sentAt = common.nowSeconds() }
    db.queue[draft.queueIndex].retryAt = common.nowSeconds() + 10
  end
  saveControllerDb()
  mode, draft = "dashboard", nil
  setNotice(("Job sent to %d worker%s."):format(#assignments, #assignments == 1 and "" or "s"), false)
  return true
end

local function queueDraft()
  if not draft then return false end
  if config.queueEnabled == false then setNotice("Queue is disabled by controller configuration.", true); return false end
  local previousQueueing = draft.queueing
  draft.queueing = true
  local result = computePreflight()
  draft.queueing = previousQueueing
  if not result or result.fatal then setNotice("Cannot queue: preflight has a fatal item.", true); return false end
  local queuedKeys = {}
  for _, chunk in ipairs(result.catalog or {}) do
    local excluded = false
    for _, item in ipairs(result.excludedChunks or {}) do if item.key == chunk.key then excluded = true; break end end
    if not excluded then queuedKeys[#queuedKeys + 1] = chunk.key end
  end
  if result.chunkMode == "world" then
    local conflict = activeLeaseOverlap(result.chunkMode, draft.workerId, queuedKeys)
    if conflict then setNotice("Cannot queue: world chunks overlap active job " .. tostring(conflict.jobId or "unknown"), true); return false end
    for _, queued in ipairs(db.queue or {}) do
      if queued.chunkMode == "world" and type(queued.chunkKeys) == "table" then
        local seen = {}; for _, value in ipairs(queued.chunkKeys) do seen[tostring(value)] = true end
        for _, value in ipairs(queuedKeys) do if seen[tostring(value)] then setNotice("Cannot queue: world chunks overlap another queued job.", true); return false end end
      end
    end
  end
  local item = persistentDraft(draft)
  item.workerId, item.queuedAt = draft.workerId, common.nowSeconds()
  item.chunkMode, item.chunkKeys = result.chunkMode, queuedKeys
  item.excludedChunks, item.jobDepth, item.targetY = common.copy(result.excludedChunks), result.jobDepth, result.targetY
  item.retryAt, item.awaiting = common.nowSeconds(), nil
  db.queue[#db.queue + 1] = item
  saveControllerDb()
  setNotice("Job added to queue.", false)
  return true
end

local lastQueueDispatch = 0
local function workerCanStart(worker)
  local status = statusOf(worker)
  if not worker or not worker.data or worker.data.atHome == false then return false end
  return status == "idle" or status == "complete" or status == "aborted"
end

local function idleWorkerId(preferred)
  if preferred and workers[preferred] and workerCanStart(workers[preferred]) then return preferred end
  for _, id in ipairs(orderedIds()) do
    local worker = workers[id]
    if workerCanStart(worker) then return id end
  end
  return nil
end

local function dispatchQueue()
  local now = common.nowSeconds()
  if config.queueEnabled == false or now - lastQueueDispatch < 5 or #db.queue == 0 then return end
  lastQueueDispatch = now
  for index, item in ipairs(db.queue) do
    if item.awaiting and now - (item.awaiting.sentAt or now) > 10 then item.awaiting, item.retryAt, item.lastError = nil, now + 5, "start acknowledgement timeout" end
    if not item.awaiting and (not item.retryAt or now >= item.retryAt) then
      -- A queued job is dock-relative (and world calibration is worker
      -- specific), so it must run only on its explicitly selected worker.
      local id = item.workerId and idleWorkerId(item.workerId) or nil
      if id then
        local candidate = common.copy(item)
        candidate.workerId, candidate.queueIndex = id, index
        candidate.lighting = normalizedLighting(candidate.lighting)
        candidate.waterMode = normalizedWaterMode(candidate.waterMode)
        candidate.profile = normalizedProfile(candidate.profile)
        draft = candidate
        local result = computePreflight()
        local sent = false
        if result and not result.fatal then
          sent = startDraft()
          if not sent and db.queue[index] then db.queue[index].retryAt, db.queue[index].lastError = now + 5, notice end
        elseif db.queue[index] then
          db.queue[index].retryAt, db.queue[index].lastError = now + 15, result and "preflight blocked" or "preflight unavailable"
          saveControllerDb()
        end
        if draft then draft = nil end
        if sent then return end
      end
    end
  end
end

local function applyPreset(name)
  for _, preset in ipairs(db.presets or {}) do
    if tostring(preset.name) == tostring(name) then
      if draft then
        local source = type(preset.draft) == "table" and preset.draft or preset
        for key, value in pairs(source) do if key ~= "name" and key ~= "schema" and key ~= "version" and key ~= "updatedAt" then draft[key] = common.copy(value) end end
      end
      db.lastPreset = name
      saveControllerDb()
      return true
    end
  end
  return false
end

local function savePreset(name, source)
  name = common.trim(name or "")
  if name == "" then return false, "Preset name is empty." end
  local draftValue = persistentDraft(source or draft or db.lastDraft or {})
  local value = { name = name, schema = common.SCHEMA, version = common.VERSION, updatedAt = common.nowSeconds(), draft = draftValue }
  local replaced = false
  for index, preset in ipairs(db.presets) do
    if tostring(preset.name) == name then db.presets[index] = value; replaced = true end
  end
  if not replaced then db.presets[#db.presets + 1] = value end
  db.lastPreset = name
  saveControllerDb()
  return true
end

local function stageStop(id, stopMode)
  if not id then setNotice("No worker selected.", true); return false end
  local worker = workers[id]
  local caps = worker and worker.data and worker.data.capabilities or {}
  local sent = sendCommand(id, "stop", { mode = stopMode, staged = true })
  -- V2 workers do not know `stop`; provide the old command after the explicit
