        if not catalogWorldSet[tostring(homeKey)] then check("bay footprint:#" .. tostring(id), "bad", "worker bay entrance is outside common world footprint", true) end
        local forwardX, forwardZ = tonumber(gps.home.x) + tonumber(gps.forward.x), tonumber(gps.home.z) + tonumber(gps.forward.z)
        local forwardKey = quarry.chunkKey("world", math.floor(forwardX / 16), math.floor(forwardZ / 16))
        if not catalogWorldSet[tostring(forwardKey)] then check("forward footprint:#" .. tostring(id), "bad", "worker bay forward entrance is outside common footprint", true) end
        if tostring(homeKey) ~= tostring(forwardKey) then check("bay chunk:#" .. tostring(id), "bad", "worker home and forward entrance must share one bay chunk", true) end
        if homeChunkOwners[tostring(homeKey)] then
          check("bay chunk unique:#" .. tostring(id), "bad", "bay chunk already owned by worker #" .. tostring(homeChunkOwners[tostring(homeKey)]), true)
        else
          homeChunkOwners[tostring(homeKey)] = id
        end
        if type(quarry.inverseWorldToLocal) == "function" and referenceCalibration then
          local okInverse, localForward = pcall(quarry.inverseWorldToLocal, referenceCalibration, forwardX, forwardZ)
          if not okInverse or type(localForward) ~= "table" then
            check("bay cell:#" .. tostring(id), "bad", "cannot rebase worker forward entrance to common catalog", true)
          else
            local forwardCell = false
            for _, chunk in ipairs(catalog or {}) do
              if tonumber(localForward.x) >= tonumber(chunk.minX) and tonumber(localForward.x) <= tonumber(chunk.maxX)
                and tonumber(localForward.z) >= tonumber(chunk.minZ) and tonumber(localForward.z) <= tonumber(chunk.maxZ) then
                forwardCell = tostring(chunk.key) == tostring(homeKey) or forwardCell
              end
            end
            if not forwardCell then check("bay cell:#" .. tostring(id), "bad", "worker forward entrance is outside its bay chunk cells", true)
            else check("bay cell:#" .. tostring(id), "ok", "forward entrance is inside its bay chunk", false) end
          end
        end
      end
      if not workerBay then
        check("bay:#" .. tostring(id), "bad", "registered bay metadata unavailable", true)
      elseif not workerBay.world then
        check("bay pose:#" .. tostring(id), "bad", "bay world pose unavailable", true)
      elseif workerBay.world then
        local pos = data.world or data.position
        local match = pos and tonumber(pos.x) == tonumber(workerBay.world.x) and tonumber(pos.y) == tonumber(workerBay.world.y) and tonumber(pos.z) == tonumber(workerBay.world.z)
        if match then check("bay pose:#" .. tostring(id), "ok", "world pose verified", false) else check("bay pose:#" .. tostring(id), "bad", "worker is not at bay world pose", true) end
        local facing = data.facing or data.pose and data.pose.dir
        if facing == nil then check("bay facing:#" .. tostring(id), "bad", "worker facing unavailable", true)
        elseif workerBay.facing ~= nil and tostring(facing) ~= tostring(workerBay.facing) then check("bay facing:#" .. tostring(id), "bad", "facing mismatch", true)
        else check("bay facing:#" .. tostring(id), "ok", tostring(facing), false) end
      end
    end
    if worldMode and not workerDock then check("dock:#" .. tostring(id), "bad", "registered dock metadata unavailable", true) end
    if workerDock and workerDock.maxDepth and tonumber(spec.maxDepth) and tonumber(workerDock.maxDepth) < tonumber(spec.maxDepth) then spec.maxDepth = tonumber(workerDock.maxDepth) end
    local homeY = tonumber(spec.homeY)
    local bottom = commonBottom
    if worldMode and (not homeY or not bottom) then check("Y:#" .. tostring(id), "bad", "HOME Y/BOTTOM Y unavailable", true) end
    if worldMode and homeY and bottom then
      local layers = math.floor(homeY - bottom + 1)
      local maxDepth = tonumber(spec.maxDepth or config.maxDepth)
      if layers < 1 then check("maxDepth:#" .. tostring(id), "bad", "BOTTOM Y is above HOME Y", true) elseif layers > maxDepth then check("maxDepth:#" .. tostring(id), "bad", tostring(layers) .. " > " .. tostring(maxDepth), true) else check("maxDepth:#" .. tostring(id), "ok", tostring(layers), false) end
      minDepth = minDepth and math.min(minDepth, layers) or layers
    end
    local availableFuel = tonumber(data.fuel or data.materials and data.materials.fuel)
    if availableFuel and (minFuel == nil or availableFuel < minFuel) then minFuel = availableFuel end
    local workerDepth = (worldMode and homeY and commonBottom and math.max(1, math.floor(homeY - commonBottom + 1))) or tonumber(value.depth) or 1
    maxRequiredFuel = math.max(maxRequiredFuel, estimateFuel(#catalog * workerDepth, value.width, value.length, workerDepth))
    if chunkMode == "local" and #ids > 1 then check("local group partition", "bad", "local jobs cannot be auto-split", true) end
  end
  -- Bay metadata is controller-owned and may differ from GPS calibration
  -- coordinates.  Validate all registered positions as a set before asking
  -- quarry to partition; otherwise two workers can share one entrance or be
  -- placed on different floors/orientations while each individual check
  -- still appears valid.
  if worldMode and #specs > 1 then
    local bayPoints = {}
    for _, spec in ipairs(specs) do
      local bayId, workerBay = groupWorkerResource(group, spec.workerId, "bay")
      local point = workerBay and (workerBay.world or workerBay.position or workerBay)
      if point and tonumber(point.x) and tonumber(point.y) and tonumber(point.z) then
        bayPoints[#bayPoints + 1] = {
          workerId = spec.workerId, bayId = bayId, x = tonumber(point.x), y = tonumber(point.y), z = tonumber(point.z),
          facing = workerBay.facing or workerBay.direction or spec.facing,
        }
      end
    end
    local requireSameFloor = not (config.dock and config.dock.requireSameFloor == false)
    local spacing = math.max(0, tonumber(config.dock and config.dock.baySpacing) or 0)
    for i = 1, #bayPoints do
      for j = i + 1, #bayPoints do
        local a, b = bayPoints[i], bayPoints[j]
        if requireSameFloor and a.y ~= b.y then check("bay floor:#" .. tostring(a.workerId) .. "/#" .. tostring(b.workerId), "bad", "registered bay HOME Y differs", true) end
        if a.facing ~= nil and b.facing ~= nil and tostring(a.facing) ~= tostring(b.facing) then
          check("bay facing:#" .. tostring(a.workerId) .. "/#" .. tostring(b.workerId), "bad", "registered bay orientation differs", true)
        end
        local dx, dz = a.x - b.x, a.z - b.z
        local distance = math.sqrt(dx * dx + dz * dz)
        if distance <= 0 or (spacing > 0 and distance < spacing) then
          check("bay spacing:#" .. tostring(a.workerId) .. "/#" .. tostring(b.workerId), "bad", "registered bay positions overlap or are closer than " .. tostring(spacing), true)
        end
      end
    end
  end
  local partition, partitionError = partitionGroupCatalog(catalog, group, { chunkMode = chunkMode, strategy = partitionStrategy, bottomY = commonBottom, layers = chunkMode == "local" and tonumber(value.depth) or nil }, specs)
  if not partition then check("connected partition", "bad", tostring(partitionError), true) else check("connected partition", "ok", value.partition or group.partition or "stripe", false) end
  local assignments = partition
  local selectedKeys = {}
  if assignments then
    for _, spec in ipairs(specs) do
      local assignment = assignments[tostring(spec.workerId)] or assignments[spec.workerId]
      local ownsBay = false
      local mineSet = {}
      if not assignment then check("assignment:#" .. tostring(spec.workerId), "bad", "partition missing worker assignment", true) end
      for _, key in ipairs(assignment and assignment.chunkKeys or {}) do mineSet[tostring(key)] = true; selectedKeys[#selectedKeys + 1] = key end
      if worldMode and spec.bayChunkKey and mineSet[tostring(spec.bayChunkKey)] then ownsBay = true end
      if worldMode and not ownsBay then check("assignment bay chunk:#" .. tostring(spec.workerId), "bad", "assignment does not own worker bay chunk", true) end
      for _, key in ipairs(assignment and assignment.transitKeys or {}) do
        if not mineSet[tostring(key)] then check("transit ownership:#" .. tostring(spec.workerId), "bad", "transit chunk leaves worker assignment", true) end
      end
      if worldMode and spec.bayChunkKey and assignment and tostring(assignment.seedKey or "") ~= tostring(spec.bayChunkKey) then
        check("assignment bay seed:#" .. tostring(spec.workerId), "bad", "assignment seed is not worker bay chunk", true)
      end
    end
  end
  local mineConflict = groupLeaseConflict(chunkMode, nil, selectedKeys, "mine", groupId)
  if mineConflict then check("mine lease", "bad", "overlaps " .. tostring(mineConflict.groupJobId or mineConflict.jobId or "active"), true) else check("mine lease", "ok", "available", false) end
  local transitKeys = {}
  if assignments then for _, assignment in pairs(assignments) do for _, key in ipairs(assignment.transitKeys or {}) do transitKeys[#transitKeys + 1] = key end end end
  local transitConflict = groupLeaseConflict(chunkMode, nil, transitKeys, "transit", groupId)
  if transitConflict then check("transit lease", "bad", "overlaps " .. tostring(transitConflict.groupJobId or transitConflict.jobId or "active"), true) else check("transit lease", "ok", "available", false) end
  if not minFuel then check("minimum fuel", "warn", "unknown / estimate " .. tostring(maxRequiredFuel) .. " (refill scheduler)", false) elseif minFuel < maxRequiredFuel then check("minimum fuel", "warn", tostring(minFuel) .. " < estimate " .. tostring(maxRequiredFuel) .. " (refill scheduler)", false) else check("minimum fuel", "ok", tostring(minFuel) .. " / estimate " .. tostring(maxRequiredFuel), false) end
  local result = {
    groupId = tostring(groupId), group = common.copy(group), value = common.copy(value), checks = checks, fatal = fatal,
    catalog = catalog, catalogDescriptor = groupCatalogDescriptor(catalog, chunkMode, rootKey, specs), chunkMode = chunkMode, rootKey = rootKey, assignments = assignments,
    workers = specs, bottomY = commonBottom, minLayers = minDepth, minFuel = minFuel, requiredFuel = maxRequiredFuel, partition = partitionStrategy,
    totalChunks = #catalog, selectedChunks = #selectedKeys, warnings = {}, minimumFuel = minFuel, requiredFuel = maxRequiredFuel, computedAt = common.nowSeconds(),
  }
  for _, item in ipairs(checks) do if item.state == "warn" then result.warnings[#result.warnings + 1] = item.name .. ": " .. tostring(item.detail) end end
  return result
end

local function groupLeaseEntries(job, assignment)
  local entries = {}
  for _, kind in ipairs({ "transit", "mine" }) do
    local keys = kind == "transit" and (assignment.transitKeys or {}) or (assignment.chunkKeys or {})
    entries[#entries + 1] = {
      jobId = tostring(assignment.jobId), groupJobId = tostring(job.groupJobId), assignmentId = tostring(assignment.assignmentId), workerId = assignment.workerId,
      kind = kind, mode = job.chunkMode, chunks = common.copy(keys), createdAt = common.nowSeconds(),
    }
  end
  return entries
end

releaseGroupLeases = function(job, onlyPending)
  if type(job) ~= "table" then return end
  local removed = {}
  local function keep(lease)
    if tostring(lease.groupJobId or "") ~= tostring(job.groupJobId or "") then return true end
    if onlyPending and job.started and job.started[tostring(lease.workerId)] then return true end
    removed[#removed + 1] = lease
    return false
  end
  local kept, keptGroup = {}, {}
  for _, lease in ipairs(db.leases or {}) do if keep(lease) then kept[#kept + 1] = lease end end
  for _, lease in ipairs(db.groupLeases or {}) do
