    elseif character == "c" and noticeState.groupSelectMode then noticeState.createGroupFromWorkers()
    elseif character == "n" then noticeState.workerPage = (tonumber(noticeState.workerPage) or 1) + 1; invalidate()
    elseif character == "p" then noticeState.workerPage = math.max(1, (tonumber(noticeState.workerPage) or 1) - 1); invalidate()
    elseif character == "b" or character == "q" then mode = "dashboard"; invalidate() end
    return
  elseif mode == "items" then
    if character == "1" and noticeState.discardDraft then noticeState.discardDraft.mode = "KEEP_ALL"; invalidate()
    elseif character == "2" and noticeState.discardDraft then noticeState.discardDraft.mode = "DISCARD_EXCESS_STONE"; invalidate()
    elseif character == "3" and noticeState.discardDraft then noticeState.discardDraft.mode = "CUSTOM_ALLOWLIST"; invalidate()
    elseif character == "b" or character == "q" then mode = "more"; invalidate() end
    return
