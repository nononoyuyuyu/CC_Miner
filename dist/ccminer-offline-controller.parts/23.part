  { source = [[src/ccminer/controller_parts/01.part]], target = [[controller_parts/01.part]], digest = [[bb606e69849c61057523698299dc307493e811bd0369629ff285db1503b316ef]], content = [[-- CC Miner V4 - controller state, persistence and job orchestration.
-- The controller is deliberately tolerant of V2 worker payloads.  New
-- fields are additive and every command has a legacy equivalent where one
-- exists.

local args = { ... }
local common = dofile("/ccminer/lib/common.lua")
local protocol = dofile("/ccminer/lib/protocol.lua")
local quarry = dofile("/ccminer/lib/quarry.lua")

local config, configError = common.loadConfig()
if not config or config.role ~= "controller" then
  error(configError or "Controller configuration not found. Run: ccm setup controller", 0)
end

if not os.getComputerLabel or not os.getComputerLabel() then
  if os.setComputerLabel then os.setComputerLabel(config.controllerName) end
end

local networkReady, modemNames = protocol.open()
if not networkReady then error("No wireless modem found next to the controller.", 0) end

local DB_PATH = "/ccminer/data/controller.db"
local function dbDefaults()
  return {
    schema = common.SCHEMA,
    version = common.VERSION,
    presets = {},
    queue = {},
    history = {},
    leases = {},
    pendingStarts = {},
    activeLeases = {}, -- independent compatibility snapshot for V4 draft tools.
    -- Group state is deliberately additive.  The legacy queue/history/preset
    -- keys above remain authoritative for single-worker operation.
    groups = {},
    docks = {},
    bays = {},
    groupJobs = {},
    groupLeases = {},
    groupScheduler = { replenishConcurrency = 1, staggerSeconds = 0 },
    lastPreset = nil,
    lastDraft = nil,
    lastCommandError = nil,
    updatedAt = common.nowSeconds(),
  }
end

local db = dbDefaults()
local dbError = nil

-- Drafts carry UI-only preflight data.  That data includes chunk plans with
-- compatibility aliases (for example `route`/`optimizedRoute`) which
-- textutils.serialize cannot encode.  Keep only the durable form when a
-- draft is copied into the controller database; copy each field separately
-- so an accidental shared reference between fields cannot leak into storage.
local function persistentDraft(source)
  local value = {}
  if type(source) ~= "table" then return value end
  for key, item in pairs(source) do
    if key ~= "preflight" and key ~= "queueIndex" and key ~= "awaiting" then
      value[key] = common.copy(item)
    end
  end
  return value
end

-- Group records intentionally retain preflight/report fields.  Clone every
-- field independently (rather than copying one shared root) to keep the
-- ComputerCraft serializer free of table aliases while preserving the
-- durable group-job audit trail.
local function persistentGroupValue(source)
  local value = {}
  if type(source) ~= "table" then return value end
  for key, item in pairs(source) do value[common.copy(key)] = common.copy(item) end
  return value
end

local function loadControllerDb()
  local loaded, err = common.loadTable(DB_PATH, dbDefaults())
  db = common.merge(dbDefaults(), loaded or {})
  -- `leases` is authoritative for V4.  Fall back to the old draft alias only
  -- when a legacy file has no leases table at all.
  if type(loaded) == "table" and type(loaded.leases) ~= "table" and type(loaded.activeLeases) == "table" then
    db.leases = common.copy(loaded.activeLeases)
  end
  db.leases = type(db.leases) == "table" and db.leases or {}
  db.pendingStarts = type(db.pendingStarts) == "table" and db.pendingStarts or {}
  db.activeLeases = common.copy(db.leases)
  db.presets, db.queue, db.history = db.presets or {}, db.queue or {}, db.history or {}
  db.groups = type(db.groups) == "table" and db.groups or {}
  db.docks = type(db.docks) == "table" and db.docks or {}
  db.bays = type(db.bays) == "table" and db.bays or {}
  db.groupJobs = type(db.groupJobs) == "table" and db.groupJobs or {}
  db.groupLeases = type(db.groupLeases) == "table" and db.groupLeases or {}
  if #db.groupLeases == 0 then
    for _, lease in ipairs(db.leases) do if type(lease) == "table" and lease.groupJobId then db.groupLeases[#db.groupLeases + 1] = common.copy(lease) end end
  end
  db.groupScheduler = type(db.groupScheduler) == "table" and db.groupScheduler or { replenishConcurrency = 1, staggerSeconds = 0 }
  db.groupScheduler.replenishConcurrency = math.max(1, math.floor(tonumber(db.groupScheduler.replenishConcurrency) or 1))
  db.groupScheduler.staggerSeconds = math.max(0, tonumber(db.groupScheduler.staggerSeconds) or 0)
  dbError = err
end

local function saveControllerDb()
  db.schema, db.version, db.updatedAt = common.SCHEMA, common.VERSION, common.nowSeconds()
  -- Keep the compatibility field, but never point it at `leases`: CC's
  -- serializer rejects repeated table references.
  db.activeLeases = common.copy(db.leases or {})
  -- Group tables may have been assembled from live worker payloads.  Copy
  -- each top-level value independently so `groups`/`groupJobs`/leases never
  -- share a table reference in the serialized database.
  local persistedGroups, persistedDocks, persistedBays, persistedJobs, persistedGroupLeases = {}, {}, {}, {}, {}
  for key, value in pairs(db.groups or {}) do persistedGroups[key] = persistentGroupValue(value) end
  for key, value in pairs(db.docks or {}) do persistedDocks[key] = persistentGroupValue(value) end
  for key, value in pairs(db.bays or {}) do persistedBays[key] = persistentGroupValue(value) end
  for key, value in pairs(db.groupJobs or {}) do persistedJobs[key] = persistentGroupValue(value) end
  for key, value in pairs(db.groupLeases or {}) do persistedGroupLeases[key] = persistentGroupValue(value) end
  -- Do not replace the live tables with sanitized copies: callers may hold a
  -- reference to a group job while saving an ACK or scheduler transition.
  -- Build a detached root exclusively for serialization instead.
  local persistedDb = {}
  for key, value in pairs(db) do persistedDb[key] = common.copy(value) end
  persistedDb.groups, persistedDb.docks, persistedDb.bays = persistedGroups, persistedDocks, persistedBays
  persistedDb.groupJobs, persistedDb.groupLeases = persistedJobs, persistedGroupLeases
  persistedDb.groupScheduler = persistentDraft(db.groupScheduler or {})
  persistedDb.activeLeases = common.copy(db.leases or {})
  local ok, err = common.saveTable(DB_PATH, persistedDb)
  if not ok then dbError = err end
  return ok, err
end

loadControllerDb()

local workers = {}
local selected = 1
local selectedGroup = 1
local groupMode = false
local groupDraft = nil
local groupCommandAcks = {}
local groupSchedulerLast = 0
