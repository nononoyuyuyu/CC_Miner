  if character == "d" then discover()
  elseif character == "n" then dashboardAction("new")()
  elseif character == "p" then sendCommand(id, "pause")
  elseif character == "r" then sendCommand(id, "resume")
  elseif character == "h" then sendCommand(id, "recall")
  elseif character == "s" then dashboardAction("stop")()
  elseif character == "x" then dashboardAction("abort")()
  elseif character == "c" then dashboardAction("clear")()
  elseif character == "i" then dashboardAction("info")()
  elseif character == "g" then dashboardAction("progress")()
  elseif character == "o" then dashboardAction("remote")()
  elseif character == "e" then dashboardAction("recovery")()
  elseif character == "t" then dashboardAction("report")()
  elseif character == "l" then dashboardAction("gps")()
  elseif character == "v" then dashboardAction("groups")()
  elseif character == "q" then running = false end
end

local function processKey(keyCode)
  if keys and keyCode == keys.escape then
    if mode == "dashboard" then
      running = false
    else
      mode, draft, confirmState = "dashboard", nil, nil
      invalidate()
    end
    return
  end
  if mode == "dashboard" then
    local ids = orderedIds()
    if keys and keyCode == keys.up then
      selected = math.max(1, selected - 1)
      invalidate()
    elseif keys and keyCode == keys.down then
      selected = math.min(math.max(1, #ids), selected + 1)
      invalidate()
    elseif keys and keyCode == keys.enter then
      mode = "info"
      invalidate()
    end
  elseif mode == "error_detail" then
    if keys and (keyCode == keys.enter or keyCode == keys.backspace or keyCode == keys.escape) then noticeState.dismiss() end
  elseif mode == "groups" then
    local ids = orderedGroupIds()
    if keys and keyCode == keys.up then selectedGroup = math.max(1, selectedGroup - 1); invalidate()
    elseif keys and keyCode == keys.down then selectedGroup = math.min(math.max(1, #ids), selectedGroup + 1); invalidate()
    elseif keys and keyCode == keys.enter then mode = "group_info"; invalidate()
    elseif keys and keyCode == keys.backspace then mode = "dashboard"; invalidate() end
  elseif mode == "group_info" then
    if keys and (keyCode == keys.enter or keyCode == keys.backspace) then mode = "groups"; invalidate() end
  elseif mode == "group_dimensions" or mode == "group_job" then
    if keys and keyCode == keys.backspace then
      groupDraftBackspace(); invalidate()
    elseif keys and keyCode == keys.tab then
      local position = 1
      local fields = groupFieldOrder()
      for index, field in ipairs(fields) do if field == (groupDraft and groupDraft.selectedField) then position = index end end
      chooseGroupDraftField(fields[position % #fields + 1]); invalidate()
    elseif keys and keyCode == keys.enter then
      local gid = selectedGroupRecord()
      if gid and groupDraft then commitGroupDraftField(); groupDraft.preflight = computeGroupPreflight(gid, groupDraft); invalidate() end
    elseif keys and keyCode == keys.left then
      adjustGroupDraft(groupDraft and groupDraft.selectedField or "width", -1); invalidate()
    elseif keys and keyCode == keys.right then
      adjustGroupDraft(groupDraft and groupDraft.selectedField or "width", 1); invalidate()
    end
  elseif mode == "job_dimensions" then
    if keys and keyCode == keys.backspace then
      draftBackspace()
      invalidate()
    elseif keys and keyCode == keys.tab then
      local position = 1
      local fields = currentFieldOrder()
      for index, field in ipairs(fields) do
        if field == draft.selectedField then position = index end
      end
      chooseDraftField(fields[position % #fields + 1])
      invalidate()
    elseif keys and keyCode == keys.enter then
      commitDraftField()
      mode = "job_grid"
      invalidate()
    elseif keys and keyCode == keys.left then
      adjustDraft(draft.selectedField or "width", -1)
      invalidate()
    elseif keys and keyCode == keys.right then
      adjustDraft(draft.selectedField or "width", 1)
      invalidate()
    end
  elseif mode == "job_grid" or mode == "job_chunks" then
    if keys and keyCode == keys.left then
      draft.gridPageX = math.max(1, (draft.gridPageX or 1) - 1)
      invalidate()
    elseif keys and keyCode == keys.right then
      draft.gridPageX = (draft.gridPageX or 1) + 1
      invalidate()
    elseif keys and keyCode == keys.up then
      draft.gridPageZ = math.max(1, (draft.gridPageZ or 1) - 1)
      invalidate()
    elseif keys and keyCode == keys.down then
      draft.gridPageZ = (draft.gridPageZ or 1) + 1
      invalidate()
    elseif keys and keyCode == keys.enter then
      local result = computePreflight()
      if result then mode = "preflight" end
      invalidate()
    end
  elseif mode == "preflight" then
    if keys and keyCode == keys.enter and draft and draft.preflight and not draft.preflight.fatal then
      startDraft()
    elseif keys and keyCode == keys.q then
      queueDraft()
    end
  elseif mode == "progress" or mode == "recovery" or mode == "report" or mode == "info" or mode == "stop_menu" then
    if keys and (keyCode == keys.enter or keyCode == keys.backspace) then
      mode = "dashboard"
      invalidate()
    end
  elseif mode == "confirm" and keys and keyCode == keys.y then
    processChar("y")
  end
end

local function pumpFor(seconds)
  local deadline = common.nowSeconds() + (seconds or 1)
  while common.nowSeconds() <= deadline do
    local sender, message = protocol.receive(0.25)
    if sender then handleMessage(sender, message) end
    groupSchedulerTick()
  end
end

local function makeCliDraft(id, width, length, depth)
  local previous = db.lastDraft or {}
  local calibration = draftCalibration(id)
  local targetY = calibration and calibration.home and tonumber(calibration.home.y) and (tonumber(calibration.home.y) - depth + 1) or nil
  return {
    workerId = id, width = width, length = length, depth = depth,
    targetY = targetY,
    lighting = normalizedLighting(previous.lighting),
    waterMode = normalizedWaterMode(previous.waterMode), profile = normalizedProfile(previous.profile),
    selectedField = "width", buffer = tostring(width), excluded = {},
    gridPageX = 1, gridPageZ = 1, rectMode = false, autoAssign = false,
    name = "CLI Quarry",
  }
end

local function printQueue()
  if #db.queue == 0 then print("Queue empty."); return end
  for index, item in ipairs(db.queue) do print(("%d: #%s %dx%dx%d profile=%s queued=%s"):format(index, tostring(item.workerId or "-"), tonumber(item.width) or 0, tonumber(item.length) or 0, tonumber(item.depth) or 0, tostring(item.profile or "balanced"), tostring(item.queuedAt or "-"))) end
end

local function printHistory()
  if #db.history == 0 then print("No history."); return end
  for index = #db.history, 1, -1 do
    local item = db.history[index]
    print(("%s %-8s worker=%s job=%s reason=%s"):format(tostring(item.finishedAt or "-"), tostring(item.status or "-"), tostring(item.workerId or "-"), tostring(item.jobId or item.id or "-"), tostring(item.reason or "-")))
  end
end

local function splitCsv(value)
  local out = {}
  for item in tostring(value or ""):gmatch("[^,]+") do out[#out + 1] = tonumber(item) or common.trim(item) end
  return out
end

local function splitMap(value)
  local out = {}
  for item in tostring(value or ""):gmatch("[^,]+") do
    local key, mapped = item:match("^([^=]+)=(.+)$")
    if key and mapped then out[common.trim(key)] = common.trim(mapped) end
  end
  return out
end

local function printGroups()
  local ids = orderedGroupIds()
  if #ids == 0 then print("No groups."); return end
  for _, gid in ipairs(ids) do
    local group = groupRecord(gid)
    local job = activeGroupJob(gid)
    local aggregate = job and (job.aggregate or updateGroupAggregate(job)) or { percent = 0, online = 0, total = #groupWorkerIds(group), minFuel = "-", warnings = {}, acks = 0, ackTotal = #groupWorkerIds(group) }
    print(("%s name=%s workers=%d/%d status=%s progress=%s%% minFuel=%s ACK=%d/%d warn=%s"):format(tostring(gid), groupName(group, gid), aggregate.online or 0, aggregate.total or 0, tostring(job and job.status or "idle"), tostring(aggregate.percent or 0), tostring(aggregate.minFuel or "-"), aggregate.acks or 0, aggregate.ackTotal or 0, table.concat(aggregate.warnings or {}, ";")))
  end
end

local function commandGroupMode()
  local sub = string.lower(args[2] or "list")
  if sub == "list" or sub == "status" then printGroups(); return true end
  if sub == "show" then
    local gid = args[3]
    local group = gid and groupRecord(gid)
    if not group then print("Group not found.") else
      local job = activeGroupJob(gid)
      local aggregate = job and (job.aggregate or updateGroupAggregate(job)) or { percent = 0, minFuel = "-", warnings = {}, acks = 0, ackTotal = #groupWorkerIds(group) }
      print(("%s name=%s mode=%s partition=%s dock=%s bay=%s progress=%s%% minFuel=%s ACK=%d/%d"):format(tostring(gid), groupName(group, gid), tostring(group.mode or "world"), tostring(group.partition or "stripe"), tostring(group.dockId or "-"), tostring(group.bayId or "-"), tostring(aggregate.percent or 0), tostring(aggregate.minFuel or "-"), aggregate.acks or 0, aggregate.ackTotal or 0))
      print("workers=" .. table.concat(groupWorkerIds(group), ",") .. " warnings=" .. table.concat(aggregate.warnings or {}, ";"))
    end
    return true
  end
  if sub == "register" or sub == "save" then
    local gid, csv = args[3], args[4]
    local ids = splitCsv(csv)
    local ok, err = registerGroup(gid, ids, { name = args[5], dockId = args[6], bayId = args[7], mode = args[8], partition = args[9], workerBays = splitMap(args[10]), workerDocks = splitMap(args[11]) })
    print(ok and "Group saved." or ("Group error: " .. tostring(err))); return true
  end
  local gid = args[3]
  if not gid then print("Usage: group list|show <id>|register <id> <workerIds comma> [name dock bay mode partition workerBayMap workerDockMap]|start|pause|resume|return|service|abort|clear|reassign <id> <stopped> [target]"); return true end
  if sub == "start" then
    discover(); pumpFor(1)
    local group = groupRecord(gid)
    if not group then print("Group not found."); return true end
    local value = groupDraftDefaults(group)
    value.width, value.length = tonumber(args[4]) or value.width, tonumber(args[5]) or value.length
    if value.mode == "world" then value.bottomY = tonumber(args[6]) or value.bottomY else value.depth = tonumber(args[6]) or value.depth end
    local result = computeGroupPreflight(gid, value)
    if result and not result.fatal then startGroup(gid, value) else print("Group preflight blocked: " .. tostring(result and result.warnings and table.concat(result.warnings, ";") or "unavailable")) end
    pumpFor(2); print(notice); return true
  end
  if sub == "reassign" then
    local stopped, target = tonumber(args[4]), tonumber(args[5])
    local job = activeGroupJob(gid)
    local ok = job and stopped and reassignGroupAssignment(job.groupJobId, stopped, target)
    print(ok and "Residual range reassigned." or (notice ~= "" and notice or "Reassign failed.")); return true
  end
  local wire = sub == "return" and "return" or sub
  if sub == "pause" or sub == "resume" or sub == "return" or sub == "service" or sub == "abort" or sub == "clear" then
    groupCommand(gid, wire); pumpFor(2); print(notice); return true
  end
  print("Usage: group list|show|register|start|pause|resume|return|service|abort|clear|reassign"); return true
end

local function commandLineMode()
  local command = string.lower(args[1] or "")
  if command == "group" or command == "groups" then return commandGroupMode() end
  if command == "dock" or command == "bay" then
    local sub, id = string.lower(args[2] or "list"), args[3]
    local registry = command == "dock" and db.docks or db.bays
    if sub == "list" then
