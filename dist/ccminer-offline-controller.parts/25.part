    if status == "working" or status == "mining" or status == "starting" then aggregate.active = aggregate.active + 1 end
    local fuel = data and tonumber(data.fuel or data.materials and data.materials.fuel)
    if fuel and (aggregate.minFuel == nil or fuel < aggregate.minFuel) then aggregate.minFuel = fuel end
    local progress = data and data.progress or {}
    local cursor, total = tonumber(progress and progress.cursor or data and data.job and data.job.cursor), tonumber(progress and progress.total or data and data.job and data.job.total)
    if cursor and total and total > 0 then weightedDone, weightedTotal = weightedDone + math.max(0, math.min(cursor, total)), weightedTotal + total end
    local warning = data and (data.lastError or data.completionReason)
    if warning and not seenWarning[tostring(warning)] then seenWarning[tostring(warning)] = true; aggregate.warnings[#aggregate.warnings + 1] = tostring(warning) end
    local ack = groupJob.acks and groupJob.acks[tostring(id)]
    if ack and ack.ok ~= nil then aggregate.acks = aggregate.acks + 1 end
  end
  aggregate.percent = weightedTotal > 0 and math.floor(weightedDone * 100 / weightedTotal + 0.5) or (#ids > 0 and math.floor(aggregate.complete * 100 / #ids + 0.5) or 0)
  if aggregate.blocked > 0 then aggregate.warnings[#aggregate.warnings + 1] = "blocked=" .. tostring(aggregate.blocked) end
  if aggregate.waiting > 0 then aggregate.warnings[#aggregate.warnings + 1] = "service=" .. tostring(aggregate.waiting) end
  if aggregate.minFuel == nil then aggregate.warnings[#aggregate.warnings + 1] = "minFuel=unknown" end
  for _, eventWarning in ipairs(groupJob.alerts or {}) do
    local text = tostring(eventWarning)
    if not seenWarning[text] then seenWarning[text] = true; aggregate.warnings[#aggregate.warnings + 1] = text end
  end
  groupJob.aggregate = persistentDraft(aggregate)
  groupJob.minFuel = aggregate.minFuel
  groupJob.warnings = common.copy(aggregate.warnings)
  groupJob.updatedAt = common.nowSeconds()
  return aggregate
end

local function findGroupJobForWorker(id, data)
  local explicit = groupJobIdForWorker(id, data)
  if explicit and db.groupJobs[explicit] then return db.groupJobs[explicit], explicit end
  return nil, explicit
end

local function normalizeStatus(data)
  data = data or {}
  -- V2 workers expose cursor/total under job and have no progress/materials
  -- objects.  Keep a normalized view without requiring a worker upgrade.
  data.progress = type(data.progress) == "table" and data.progress or {}
  if data.job then
    if data.progress.cursor == nil then data.progress.cursor = data.job.cursor end
    if data.progress.total == nil then data.progress.total = data.job.total end
    if data.progress.percent == nil then data.progress.percent = data.job.percent end
    if data.progress.layer == nil then data.progress.layer = data.job.currentLayer end
  end
  data.materials = type(data.materials) == "table" and data.materials or {}
  if data.materials.fuel == nil then data.materials.fuel = data.fuel end
  if data.materials.inventoryEmpty == nil then data.materials.inventoryEmpty = data.inventoryEmpty end
  if data.materials.seal == nil and data.seal then data.materials.seal = data.seal.count end
  data.capabilities = type(data.capabilities) == "table" and data.capabilities or {}
  return data
end

local function activeJobId(data)
  return data and data.job and tostring(data.job.id or "") or nil
end

local function addHistory(id, data, reason)
  if not data then return end
  local job = data.job or {}
  local report = data.report or {}
  db.history[#db.history + 1] = {
    id = tostring(job.id or ("worker-" .. tostring(id) .. "-" .. common.nowMillis())),
    jobId = job.id,
    workerId = tonumber(id) or id,
    worker = workerLabel(workers[id], id),
    name = job.name,
    status = data.status,
    reason = reason or data.completionReason,
    startedAt = job.startedAt,
    finishedAt = common.nowSeconds(),
    progress = common.copy(data.progress or job),
    stats = common.copy(data.stats or {}),
    report = common.copy(report),
  }
  local historyLimit = math.max(1, tonumber(config.historyLimit) or 50)
  while #db.history > historyLimit do table.remove(db.history, 1) end
  saveControllerDb()
end

local function releaseLeasesForWorker(id, jobId)
  local kept = {}
  local currentAtHome = workers[id] and workers[id].data and workers[id].data.atHome == true
  for _, lease in ipairs(db.leases or {}) do
    local sameWorker = tonumber(lease.workerId) == tonumber(id)
    local sameJob = not jobId or tostring(lease.jobId) == tostring(jobId)
    if not (sameWorker and sameJob and (not lease.groupJobId or currentAtHome)) then kept[#kept + 1] = lease end
  end
  db.leases = kept
  local keptGroup = {}
  for _, lease in ipairs(db.groupLeases or {}) do
    local sameWorker = tonumber(lease.workerId) == tonumber(id)
    local sameJob = not jobId or tostring(lease.jobId) == tostring(jobId) or tostring(lease.groupJobId) == tostring(jobId)
    if not (sameWorker and sameJob and (not lease.groupJobId or currentAtHome)) then keptGroup[#keptGroup + 1] = lease end
  end
  db.groupLeases = keptGroup
  db.activeLeases = common.copy(kept)
  saveControllerDb()
end

-- A direct single-worker START is a two-phase operation: rednet.send only
-- confirms that the packet was queued, not that the worker accepted it. Keep
-- the lease until an ACK/status confirms acceptance, and release it
-- immediately on an explicit rejection. This also repairs leases left by
-- older controllers which treated a rejected packet as a started job.
local function reconcileSingleWorkerLeases(id, data)
  if not id or type(data) ~= "table" then return false end
  local key = tostring(id)
  local pending = db.pendingStarts and db.pendingStarts[key]
  local activeId = activeJobId(data)
  if pending and activeId and tostring(activeId) == tostring(pending.jobId) then
    db.pendingStarts[key] = nil
    saveControllerDb()
    setNotice("Worker #" .. key .. " accepted the job.", false)
    pending = nil
  end
  local status = tostring(data.status or "")
  local safelyIdle = data.atHome == true and (status == "idle" or status == "complete" or status == "completed" or status == "aborted")
  if not safelyIdle then return false end
  local kept, removed = {}, 0
  for _, lease in ipairs(db.leases or {}) do
    local sameWorker = tonumber(lease.workerId) == tonumber(id)
    local directLease = not lease.groupJobId
    local matchesActive = activeId and tostring(lease.jobId or "") == tostring(activeId)
    local matchesPending = pending and tostring(lease.jobId or "") == tostring(pending.jobId or "")
    if sameWorker and directLease and not matchesActive and not matchesPending then
      removed = removed + 1
    else
      kept[#kept + 1] = lease
    end
  end
  if removed > 0 then
    db.leases = kept
    db.activeLeases = common.copy(kept)
    saveControllerDb()
    setNotice(("Cleared %d rejected/stale START reservation%s for worker #%s."):format(removed, removed == 1 and "" or "s", key), false)
    return true
  end
  return false
end

local function handleSingleStartAck(sender, message, payload)
  local key = tostring(sender)
  local pending = db.pendingStarts and db.pendingStarts[key]
  if not pending or tostring(payload.command or "") ~= "start" then return false end
  if pending.messageId and message.replyTo and tostring(pending.messageId) ~= tostring(message.replyTo) then return false end
  db.pendingStarts[key] = nil
  if payload.ok == true then
    saveControllerDb()
    setNotice("START accepted by worker #" .. key .. ".", false)
  else
    for _, item in ipairs(db.queue or {}) do
      local awaiting = item.awaiting
      if awaiting and tonumber(awaiting.workerId) == tonumber(sender) and tostring(awaiting.jobId) == tostring(pending.jobId) then
        item.awaiting = nil
        item.retryAt = common.nowSeconds() + 15
        item.lastError = tostring(payload.message or "worker rejected START")
      end
    end
    releaseLeasesForWorker(sender, pending.jobId)
    setNotice("START rejected by worker #" .. key .. ": " .. tostring(payload.message or "unknown reason"), true)
  end
  return true
end

local function acknowledgeQueuedStart(id, data)
  local job = data and data.job
  if not job then return end
  for index, item in ipairs(db.queue or {}) do
    local awaiting = item.awaiting
    if awaiting and tonumber(awaiting.workerId) == tonumber(id) and tostring(awaiting.jobId) == tostring(job.id) then
      table.remove(db.queue, index)
      saveControllerDb()
      setNotice("Queued job accepted by worker #" .. tostring(id) .. ".", false)
      return
    end
  end
end

local function alert(kind, id, text)
  -- Offline/unknown are intentionally not alerts.  Respect the optional
  -- per-channel settings and allow the same condition after cooldown.
  local settings = config.alerts or {}
  if settings.enabled == false then return end
  if kind == "complete" and settings.onComplete == false then return end
  if kind == "material" and settings.onWaiting == false then return end
  if kind == "blocked" and settings.onError == false then return end
  local key = tostring(id) .. ":" .. tostring(kind)
  local now = common.nowSeconds()
  local previous = alertLedger[key]
  local cooldown = math.max(0, tonumber(settings.cooldownSeconds) or 30)
  if previous and now - (previous.at or 0) < cooldown then return end
  alertLedger[key] = { at = now }
  if settings.speaker ~= false then
    local instrument = kind == "complete" and "pling" or kind == "material" and "bell" or "bass"
    local pitch = kind == "complete" and 12 or kind == "material" and 6 or 4
    for _, entry in ipairs(speakers) do
      local speaker = entry.device
      if speaker and speaker.playNote then pcall(speaker.playNote, instrument, 1, pitch)
      elseif speaker and speaker.playSound then pcall(speaker.playSound, "minecraft:block.note_block." .. instrument, 1, 1) end
    end
  end
  if settings.redstone ~= false then
    local side = tostring(settings.redstoneSide or "back")
    local timer = os.startTimer and os.startTimer(0.25)
    if redstone and redstone.setOutput then
      pcall(redstone.setOutput, side, true)
      if timer then alertTimers[timer] = { global = true, side = side } end
    else
      local relays = {}
      for _, entry in ipairs(redstoneDevices) do
        local relay = entry.device
        if relay and relay.setOutput then
          pcall(relay.setOutput, side, true)
          relays[#relays + 1] = relay
        end
      end
      if timer and #relays > 0 then alertTimers[timer] = { relays = relays, side = side } end
    end
  end
  if text and text ~= "" then setNotice(text, kind == "blocked") end
end

local function clearAlert(id, kind)
  alertLedger[tostring(id) .. ":" .. tostring(kind)] = nil
end

local function handleMessage(sender, message)
  local valid = protocol.validate(message, config.networkKey, os.getComputerID(), sender)
  if not valid then return false end
  if message.kind == "status" then
    local payload = normalizeStatus(message.payload)
    local id = tonumber(payload.id)
    if not id or id ~= tonumber(sender) then return false end
    workers[id] = workers[id] or {}
    local previous = workers[id].data
    workers[id].data = payload
    workers[id].lastSeen = common.nowSeconds()
    workers[id].sender = sender
    reconcileSingleWorkerLeases(id, payload)
    local groupJob = findGroupJobForWorker(id, payload)
    if groupJob then
      if groupJob.status == "starting" and payload.job and payload.job.assignmentId then acceptGroupStart(groupJob, id, payload.job.assignmentId) end
      finalizePendingReassignment(groupJob, id, payload)
      local assignment = groupJob.assignments and (groupJob.assignments[tostring(id)] or groupJob.assignments[id])
      if assignment then
        assignment.status = payload.status or payload.phase or assignment.status
