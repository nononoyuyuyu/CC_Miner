    check("torches", "warn", tostring(torchNeed) .. " estimated @" .. tostring(profileInfo.effectiveInterval), false)
  end
  check("exclusions", #excludedChunks > 0 and "warn" or "ok", tostring(#excludedChunks), false)
  if plan then check("connectivity", "ok", "connected", false) else check("connectivity", "bad", tostring(planError), true) end
  if partialMask then check("selection", "bad", "partial cell mask cannot be sent; select whole chunks", true) end
  if chunkMode == "world" then
    local gpsData = type(data.gps) == "table" and data.gps or {}
    local calibrated = gpsData.calibrated == true and calibration ~= nil
    local available = gpsData.available == true and type(gpsData.lastFix) == "table"
    check("GPS calibration", calibrated and "ok" or "bad", calibrated and "calibrated" or "run GPS CAL at the dock", not calibrated)
    check("GPS fix", available and "ok" or "bad", available and "current position available" or tostring(gpsData.lastError or "GPS hosts are not reachable"), not available)
  else
    check("GPS", "ok", "local mode (world features unavailable)", false)
  end
  local workerStatus = worker and statusOf(worker) or "offline"
  if id and worker and workerStatus ~= "offline" then check("worker", "ok", workerLabel(worker, id), false)
  else check("worker", "bad", "offline or not selected", true) end
  local startableStatus = workerStatus == "idle" or workerStatus == "complete" or workerStatus == "completed" or workerStatus == "aborted"
  check("start state", startableStatus and "ok" or "bad", workerStatus, not startableStatus)
  check("home", data.atHome == true and "ok" or "bad", data.atHome == true and "at home" or "worker is not at home", data.atHome ~= true)
  local poseDir = tonumber(data.pose and data.pose.dir)
  check("facing", poseDir == 0 and "ok" or "bad", poseDir == 0 and "facing quarry" or (poseDir and ("direction=" .. tostring(poseDir)) or "direction unknown"), poseDir ~= 0)
  local recoveryRequired = data.recoveryRequired == true or data.pendingAction ~= nil
  check("recovery", recoveryRequired and "bad" or "ok", recoveryRequired and "pending physical recovery" or "ready", recoveryRequired)
  local unfinished = data.job ~= nil and workerStatus ~= "complete" and workerStatus ~= "completed" and workerStatus ~= "aborted"
  check("existing job", unfinished and "bad" or "ok", unfinished and "abort or clear the unfinished job first" or "clear", unfinished)
  if fuel and fuel >= requiredFuel then
    check("worker fuel", "ok", ("available %s / need %d"):format(tostring(fuel), requiredFuel), false)
  elseif fuel then
    check("worker fuel", "warn", ("available %s / need %d (dock refill expected)"):format(tostring(fuel), requiredFuel), false)
  else
    check("worker fuel", "warn", ("unknown / need %d"):format(requiredFuel), false)
  end
  if data.inventoryEmpty ~= nil then
    check("inventory", tonumber(data.inventoryEmpty) > 0 and "ok" or "warn", tostring(data.inventoryEmpty or 0) .. " empty", false)
  else check("inventory", "warn", "unknown", false) end
  local seal = tonumber(data.materials and (data.materials.sealCount or data.materials.seal) or data.seal and data.seal.count)
  local torchStock = tonumber(data.lighting and data.lighting.torchCount or data.materials and data.materials.torchCount)
  if draft.waterMode == "seal" and seal and seal <= 0 then check("seal material", "warn", "0 (dock refill expected)", false)
  elseif draft.waterMode == "seal" then check("seal material", "warn", "seal stock unknown", false) end
  if draft.lighting and draft.lighting.mode ~= "off" and torchStock and torchStock < torchNeed then check("torch material", "warn", tostring(torchStock) .. "/" .. tostring(torchNeed) .. " (dock refill expected)", false)
  elseif draft.lighting and draft.lighting.mode ~= "off" then check("torch material", "warn", "torch stock unknown", false) end
  local caps = data.capabilities or {}
  if draft.waterMode ~= "ignore" then
    if caps.waterHandling == false then check("water capability", "bad", "worker lacks waterHandling", true)
    elseif caps.waterHandling == nil then check("water capability", "warn", "worker capability unknown", false)
    else check("water capability", "ok", "ready", false) end
  else check("water capability", "ok", "ignore", false) end
  if draft.lighting and draft.lighting.mode ~= "off" then
    if caps.lighting == false then check("lighting capability", "bad", "worker lacks lighting", true)
    elseif caps.lighting == nil then check("lighting capability", "warn", "worker capability unknown", false)
    else check("lighting capability", "ok", "ready", false) end
  else check("lighting capability", "ok", "off", false) end
  local selectedChunkKeys = {}
  for _, chunk in ipairs(catalog) do
    local excluded = false
    for _, item in ipairs(excludedChunks) do if item.key == chunk.key then excluded = true; break end end
    if not excluded then selectedChunkKeys[#selectedChunkKeys + 1] = chunk.key end
  end
  local leaseConflict = (not draft.queueing) and id and activeLeaseOverlap and activeLeaseOverlap(chunkMode, id, selectedChunkKeys)
  if leaseConflict then check("lease", "bad", "overlaps active job " .. tostring(leaseConflict.jobId or "unknown"), true) end
  local fatal = false
  for _, item in ipairs(checks) do if item.fatal or item.state == "bad" and item.fatal then fatal = true end end
  local result = {
    checks = checks, fatal = fatal, catalog = catalog, plan = plan, planError = planError,
    chunkMode = chunkMode, calibration = calibration, rootKey = rootKey,
    excludedChunks = excludedChunks, cells = estimate and (estimate.surfaceCells or estimate.columns) or (cells - cellExcluded), blocks = estimate and (estimate.blocks or estimate.totalBlocks) or blocks,
    chunks = plan and plan.catalogCount or #catalog, selectedChunks = (plan and plan.selectedChunks) or (#catalog - #excludedChunks), totalChunks = #catalog, exclusions = #excludedChunks,
    torches = torchNeed, fuel = requiredFuel, baseFuel = baseFuelEstimate, estimate = estimate, jobDepth = jobDepth, targetY = targetY,
    profile = profileInfo.profile, requestedInterval = profileInfo.requestedInterval, effectiveInterval = profileInfo.effectiveInterval,
    fuelMultiplier = profileInfo.fuelMultiplier,
  }
  draft.preflight = result
  return result
end

activeLeaseOverlap = function(mode, workerId, chunks)
  for _, lease in ipairs(db.leases or {}) do
    local leaseMode = lease.mode == "world" and "world" or "local"
    if mode == "world" and leaseMode == "world" then
      local set = {}
      for _, key in ipairs(lease.chunks or {}) do set[tostring(key)] = true end
      for _, key in ipairs(chunks or {}) do if set[tostring(key)] then return lease end end
    elseif mode == "local" and leaseMode == "local" and tonumber(lease.workerId) == tonumber(workerId) then
      return lease
    end
  end
  return nil
end

local function reserveLease(jobId, workerId, mode, chunks, assignmentId)
  local conflict = activeLeaseOverlap(mode, workerId, chunks)
  if conflict then return nil, "Active lease overlap with " .. tostring(conflict.jobId or conflict.assignmentId) end
  local lease = {
    jobId = tostring(jobId), assignmentId = assignmentId, workerId = tonumber(workerId) or workerId,
    mode = mode, chunks = common.copy(chunks or {}), createdAt = common.nowSeconds(),
  }
  db.leases[#db.leases + 1] = lease
  db.activeLeases = common.copy(db.leases)
  local ok, err = saveControllerDb()
  if not ok then table.remove(db.leases); return nil, err or "Could not persist active lease" end
  return lease
end

local function chunkKeySet(catalog)
  local set = {}
  for _, chunk in ipairs(catalog or {}) do set[chunk.key] = true end
  return set
end

local function deterministicPartition(chunks, count)
  local out = {}
  count = math.max(1, tonumber(count) or 1)
  for index = 1, count do out[index] = {} end
  for index, chunk in ipairs(chunks or {}) do out[((index - 1) % count) + 1][#out[((index - 1) % count) + 1] + 1] = chunk end
  return out
end

-- Group planning ---------------------------------------------------------
-- The quarry module may expose the richer partitionGroup API in newer
-- runtimes.  Controllers assembled with an older quarry.lua still work for
-- world plans through partitionChunks; local plans intentionally never get an
-- automatic split because their coordinates are dock-relative.
local function groupWorkerSpecs(group)
  local specs = {}
  for _, id in ipairs(groupWorkerIds(group)) do
    local data = workerData(id) or {}
    local calibration = data.gps and data.gps.calibration or data.calibration
    local home = calibration and calibration.home or data.home
    local world = data.world or data.position
    local bayId, bay = groupWorkerResource(group, id, "bay")
    local dockId, dock = groupWorkerResource(group, id, "dock")
    local bayPoint = bay and (bay.world or bay.position or bay) or nil
    local bayChunkKey = bayPoint and tonumber(bayPoint.x) and tonumber(bayPoint.z)
      and quarry.chunkKey("world", math.floor(tonumber(bayPoint.x) / 16), math.floor(tonumber(bayPoint.z) / 16)) or nil
    specs[#specs + 1] = {
      workerId = tonumber(id) or id,
      id = tonumber(id) or id,
      version = data.version or data.workerVersion,
      home = common.copy(home),
      calibration = common.copy(calibration),
      world = common.copy(world),
      facing = data.facing or data.pose and data.pose.dir,
      homeY = tonumber(home and home.y or data.homeY),
      maxDepth = tonumber(data.maxDepth or data.capabilities and data.capabilities.maxDepth),
      capability = common.copy(data.capabilities or {}),
      bayId = bayId, bay = common.copy(bayPoint), bayChunkKey = bayChunkKey, bayMeta = common.copy(bay), dockId = dockId, dock = common.copy(dock),
    }
  end
  return specs
end

local function normalizeGroupAssignments(raw, workerSpecs)
  local source = type(raw) == "table" and (raw.byWorker or raw.assignments or raw) or nil
  if type(source) ~= "table" then return nil, "invalid_group_assignments" end
  local out, count = {}, 0
  for index, spec in ipairs(workerSpecs or {}) do
    local id, key = spec.workerId, tostring(spec.workerId)
    -- Never pair assignments by array index: quarry is allowed to sort worker
    -- IDs.  Match the explicit workerId (or byWorker map key) only.
    local value = source[key] or source[id]
    if type(value) ~= "table" then
      for candidateKey, candidate in pairs(source) do
        if type(candidate) == "table" and tostring(candidate.workerId or candidate.id) == key then value = candidate; break end
        if tostring(candidateKey) == key and type(candidate) == "table" then value = candidate; break end
      end
    end
    if type(value) ~= "table" then return nil, "group_assignment_missing_worker_" .. key end
    local chunks = value.chunkKeys or value.chunks or value.assignmentChunks or {}
    if type(chunks) ~= "table" then return nil, "group_assignment_invalid_chunks_" .. key end
    local assignment = {
      workerId = tonumber(value.workerId or id) or value.workerId or id,
      chunkKeys = common.copy(chunks),
      transitKeys = common.copy(value.transitKeys or value.transit or {}),
      seedKey = value.seedKey,
      estimatedCost = tonumber(value.estimatedCost or value.cost or value.cells) or 0,
      homeY = tonumber(value.homeY or spec.homeY),
      bottomY = tonumber(value.bottomY),
      layers = tonumber(value.layers),
    }
    if #assignment.chunkKeys == 0 then return nil, "group_assignment_empty_" .. key end
    out[key] = assignment
    count = count + 1
  end
  return out, count
end

local function partitionGroupCatalog(catalog, group, options, workerSpecs)
  local specs = workerSpecs or groupWorkerSpecs(group)
  if #specs == 0 then return nil, "group_workers_required" end
  options = type(options) == "table" and options or {}
  options.strategy = options.strategy or (group and group.partition) or "stripe"
