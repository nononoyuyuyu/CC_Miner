  end
  if not valuable or not bulk or not seal then
    if not sortingWarned then sortingWarned = true; setNotice("Sorting WARN: one or more target inventories are missing.", false) end
    return
  end
  local valuableItems, sealItems = settings.valuableItems or {}, settings.sealBlocks or {}
  for slot, item in pairs(source.list() or {}) do
    local destination = bulk
    if valuableItems[item.name] == true then destination = valuable
    elseif sealItems[item.name] == true then destination = seal end
    local targetName = destination == valuable and (settings.valuableTarget or "") or destination == seal and (settings.sealTarget or "") or (settings.bulkTarget or "")
    pcall(source.pushItems, targetName, slot, item.count)
  end
end
]] },
  { source = [[src/ccminer/controller_parts/02.part]], target = [[controller_parts/02.part]], digest = [[275aa46fafae37455f4fad273121b8daf54bc38af0218c4843400a9d0a6f41a1]], content = [[-- CC Miner V4 - adaptive touch views.  Every view has a keyboard fallback and
-- uses bounded hitboxes, so a 20x8 monitor remains operable.

local fieldOrder = { "width", "length", "depth", "targetY" }
local fieldLabels = { width = "WIDTH", length = "LENGTH", depth = "DEPTH", targetY = "BOTTOM Y" }
local fieldLimits = { width = 128, length = 512, depth = 128, targetY = 32000 }

local function currentFieldOrder()
  if draft and draftCalibration() then return { "width", "length", "targetY" } end
  return { "width", "length", "depth" }
end

-- Group dimensions intentionally use a separate draft.  The single-worker
-- `draft` remains untouched so an operator can leave GROUPS and resume a
-- queued/legacy job without losing its inputs.
local function groupDraftWorldMode()
  return groupDraft and tostring(groupDraft.mode or "world") == "world"
end

local function groupFieldOrder()
  return groupDraftWorldMode() and { "width", "length", "targetY" } or { "width", "length", "depth" }
end

local function commitGroupDraftField()
  if not groupDraft then return end
  local field = groupDraft.selectedField or "width"
  local value = tonumber(groupDraft.buffer)
  if not value then value = groupDraft[field] or 1 end
  value = common.clamp(math.floor(value), fieldLimits[field] and -fieldLimits[field] or 1, fieldLimits[field] or 512)
  if field ~= "targetY" then value = math.max(1, value) end
  groupDraft[field], groupDraft.buffer = value, tostring(value)
end

local function chooseGroupDraftField(field)
  commitGroupDraftField()
  if not groupDraft then return end
  groupDraft.selectedField = field
  groupDraft.buffer = tostring(groupDraft[field] or 0)
end

local function groupDraftDigit(digit)
  if not groupDraft then return end
  local buffer = tostring(groupDraft.buffer or "")
  if tostring(digit) == "-" then
    if groupDraft.selectedField == "targetY" and buffer:sub(1, 1) ~= "-" then groupDraft.buffer = "-" .. (buffer == "0" and "" or buffer); groupDraft.preflight = nil end
    return
  end
  if buffer == "0" then buffer = "" end
  if #buffer < 6 then groupDraft.buffer = buffer .. tostring(digit); groupDraft.preflight = nil end
end

local function groupDraftBackspace()
  if not groupDraft then return end
  local buffer = tostring(groupDraft.buffer or "")
  groupDraft.buffer = buffer:sub(1, math.max(0, #buffer - 1))
  if groupDraft.buffer == "" or groupDraft.buffer == "-" then groupDraft.buffer = "0" end
  groupDraft.preflight = nil
end

local function adjustGroupDraft(field, delta)
  chooseGroupDraftField(field)
  if not groupDraft then return end
  local value = tonumber(groupDraft[field]) or 1
  local minimum = field == "targetY" and -fieldLimits.targetY or 1
  local maximum = fieldLimits[field] or 512
  groupDraft[field], groupDraft.buffer = common.clamp(value + delta, minimum, maximum), nil
  groupDraft.buffer = tostring(groupDraft[field])
  groupDraft.preflight = nil
end

local function commitDraftField()
  if not draft then return end
  local field = draft.selectedField or "width"
  local value = tonumber(draft.buffer)
  if not value then value = draft[field] or 1 end
  value = common.clamp(math.floor(value), fieldLimits[field] and -fieldLimits[field] or 1, fieldLimits[field] or 512)
  if field ~= "targetY" then value = math.max(1, value) end
  draft[field], draft.buffer = value, tostring(value)
end

local function chooseDraftField(field)
  commitDraftField()
  draft.selectedField = field
  draft.buffer = tostring(draft[field] or 0)
end

local function draftDigit(digit)
  if not draft then return end
  local buffer = tostring(draft.buffer or "")
  if tostring(digit) == "-" then
    if draft.selectedField == "targetY" and buffer:sub(1, 1) ~= "-" then draft.buffer = "-" .. (buffer == "0" and "" or buffer) end
    return
  end
  if buffer == "0" then buffer = "" end
  if #buffer < 6 then draft.buffer = buffer .. tostring(digit) end
end

local function draftBackspace()
  if not draft then return end
  local buffer = tostring(draft.buffer or "")
  draft.buffer = buffer:sub(1, math.max(0, #buffer - 1))
  if draft.buffer == "" or draft.buffer == "-" then draft.buffer = "0" end
end

local function adjustDraft(field, delta)
  chooseDraftField(field)
  local value = tonumber(draft[field]) or 1
  local minimum = field == "targetY" and -fieldLimits.targetY or 1
  local maximum = fieldLimits[field] or 512
  draft[field], draft.buffer = common.clamp(value + delta, minimum, maximum), nil
  draft.buffer = tostring(draft[field])
end

local function writeHeader(title, target, background)
  local width = target.getSize()
  common.writeAt(1, 1, common.center(title, width), colors and colors.black or nil, background or (colors and colors.cyan or nil))
end

local function noticeLine(target, y)
  local width, height = target.getSize()
  y = y or height
  if y < 1 then return end
  local noticeColor = noticeIsError and (colors and colors.red or nil) or (colors and colors.lime or nil)
  common.writeAt(1, y, common.fit(notice, width), noticeColor)
end

local function statusGlyph(state)
  return ({ ok = "OK", warn = "!!", bad = "XX" })[state] or "??"
end

local function renderDashboard(target, key)
  local width, height = target.getSize()
  writeHeader("CC MINER V4 TOUCH CONTROL", target)
  local ids = orderedIds()
  local online = 0
  for _, id in ipairs(ids) do if statusOf(workers[id]) ~= "offline" then online = online + 1 end end
  common.writeAt(1, 2, common.fit(("Controller #%d | Workers %d/%d | Q%d H%d"):format(os.getComputerID(), online, #ids, #db.queue, #db.history), width), colors and colors.lightGray or nil)
  local headerY = 4
  common.writeAt(1, headerY, common.fit(width >= 48 and " ID    NAME           STATUS       PROGRESS       FUEL" or " ID NAME      STATUS   PROGRESS", width), colors and colors.yellow or nil)
  local maxRows = math.max(1, height - 10)
  if #ids == 0 then
    common.writeAt(2, headerY + 2, common.fit("No workers. DISCOVER (D).", math.max(1, width - 2)), colors and colors.lightGray or nil)
  else
    local first = selected > maxRows and selected - maxRows + 1 or 1
    for row = 1, maxRows do
      local index = first + row - 1
      local id = ids[index]
      if not id then break end
      local worker, data = workers[id], workers[id].data or {}
      local status = statusOf(worker)
      local line
      if width >= 48 then
        line = ("%s%-5s %-14s %-12s %-16s %-7s"):format(index == selected and ">" or " ", tostring(id), common.fit(workerLabel(worker, id), 14), common.fit(status, 12), common.fit(progressText(data), 16), tostring(data.fuel or "-"))
      else
        line = ("%s%-3s %-10s %-8s %s"):format(index == selected and ">" or " ", tostring(id), common.fit(workerLabel(worker, id), 10), common.fit(status, 8), progressText(data))
      end
      local y = headerY + row
      common.writeAt(1, y, common.fit(line, width), index == selected and (colors and colors.black or nil) or common.statusColor(status), index == selected and (colors and colors.white or nil) or (colors and colors.black or nil))
      addHitbox(key, 1, y, width, y, function() selected = index; invalidate() end)
    end
  end
  local bottom = math.max(1, height - 4)
  buttonRow(key, bottom, width, {
    { "DISCOVER", dashboardAction("discover") }, { "NEW JOB", dashboardAction("new") },
    { "PROGRESS", dashboardAction("progress") }, { "INFO", dashboardAction("info") },
  })
  buttonRow(key, bottom + 1, width, {
    { "STOP", dashboardAction("stop") }, { "RECOVERY", dashboardAction("recovery") },
    { "REPORT", dashboardAction("report") }, { "GPS", dashboardAction("gps") },
  })
  buttonRow(key, bottom + 2, width, {
    { "PAUSE", dashboardAction("pause") }, { "RESUME", dashboardAction("resume") },
    { "RECALL", dashboardAction("recall") }, { "SERVICE", dashboardAction("service") },
  })
  buttonRow(key, bottom + 3, width, {
    { "ABORT", dashboardAction("abort") }, { "CLEAR", dashboardAction("clear") },
    { "REHOME", dashboardAction("rehome") }, { "QUIT", dashboardAction("quit") },
  })
  -- Group controls are additive; the legacy single-worker rows above remain
  -- unchanged so old monitors and keyboard shortcuts continue to work.
  buttonRow(key, math.max(1, bottom - 1), width, {
    { "GROUPS", dashboardAction("groups") }, { "G START", dashboardAction("group_start") },
    { "G PAUSE", dashboardAction("group_pause") }, { "G RETURN", dashboardAction("group_return") },
  })
  local groupIds = orderedGroupIds()
  if #groupIds > 0 then
    local gy = math.max(2, bottom - 2)
    local gid, g = selectedGroupRecord()
    local gj = gid and activeGroupJob(gid) or nil
    local aggregate = gj and (gj.aggregate or updateGroupAggregate(gj)) or nil
    local line = ("Group %s %s %d workers %s%% minFuel=%s ACK=%s/%s"):format(tostring(gid), groupName(g, gid), #(groupWorkerIds(g)), tostring(aggregate and aggregate.percent or 0), tostring(aggregate and aggregate.minFuel or "-"), tostring(aggregate and aggregate.acks or 0), tostring(aggregate and aggregate.ackTotal or #groupWorkerIds(g)))
    common.writeAt(1, gy, common.fit(line, width), colors and colors.cyan or nil)
  end
  noticeLine(target, height)
end

local function groupAction(groupCommandName)
  return function()
    local gid = selectedGroupRecord()
    if not gid then setNotice("No group selected.", true); return end
    if groupCommandName == "start" then
      groupDraft = groupDraftDefaults(groupRecord(gid))
      groupDraft.selectedField = "width"
      groupDraft.buffer = tostring(groupDraft.width or 1)
      groupDraft.preflight = nil
      mode = "group_dimensions"
    else
      groupCommand(gid, groupCommandName)
    end
    invalidate()
  end
end

local function groupAssignmentCount(result)
  local count = 0
  for _, assignment in pairs(result and result.assignments or {}) do if type(assignment) == "table" then count = count + 1 end end
  return count
end

local function renderGroupDimensions(target, key)
  local width, height = target.getSize()
  local gid, group = selectedGroupRecord()
  writeHeader("GROUP JOB / DIMENSIONS", target, colors and colors.cyan or nil)
  if not gid or not group then
    common.writeAt(1, 3, common.fit("No group selected.", width), colors and colors.yellow or nil)
    buttonRow(key, math.max(1, height - 2), width, { { "BACK", function() mode = "groups" end } })
    noticeLine(target, height)
    return
  end
  groupDraft = groupDraft or groupDraftDefaults(group)
  local ids = groupWorkerIds(group)
  local worldMode = groupDraftWorldMode()
  common.writeAt(1, 2, common.fit(("Group %s (%s) | workers=%d | %s | partition=%s"):format(groupName(group, gid), tostring(gid), #ids, worldMode and "WORLD" or "LOCAL", tostring(groupDraft.partition or group.partition or "stripe")), width), colors and colors.lightGray or nil)
  common.writeAt(1, 3, common.fit(worldMode and "BOTTOM Y is absolute; each worker reports HOME Y/LAYERS." or "LOCAL uses DEPTH; multi-worker automatic splitting is disabled.", width), colors and colors.lightGray or nil)
  local visibleFields = groupFieldOrder()
