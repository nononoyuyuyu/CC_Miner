  local existingTarget = job.assignments[targetKey]
  local target = existingTarget and common.copy(existingTarget) or { workerId = tonumber(targetWorkerId) or targetWorkerId, groupJobId = job.groupJobId, parentJobId = job.groupJobId, jobId = job.groupJobId .. "/reassign-" .. targetKey, assignmentId = job.groupJobId .. ":reassign:" .. targetKey, chunkKeys = {}, transitKeys = {}, status = "pending_reassign" }
  target.chunkKeys = common.copy(source.chunkKeys)
  target.transitKeys = common.copy(source.transitKeys or {})
  target.bay, target.bayId, target.dock, target.dockId = bayId, bayId, common.copy(dock or {}), dockId
  target.homeWorld = dock and common.copy(dock.homeWorld or dock.world) or common.copy(target.homeWorld or targetData.world)
  target.maxDepth = tonumber(dock and dock.maxDepth or target.maxDepth or config.maxDepth)
  target.facing = targetData.facing or target.facing
  if job.chunkMode == "world" and targetData.gps and targetData.gps.calibration and targetData.gps.calibration.home then
    local targetHome = targetData.gps.calibration.home
    if tonumber(targetHome.x) and tonumber(targetHome.z) then
      target.bayChunkKey = quarry.chunkKey("world", math.floor(tonumber(targetHome.x) / 16), math.floor(tonumber(targetHome.z) / 16))
    end
  end
  target.homeY = target.homeY or source.homeY
  target.bottomY = target.bottomY or source.bottomY
  target.layers = target.layers or source.layers
  local outboundToken = sourceToken and common.copy(sourceToken) or nil
  if outboundToken then
    outboundToken.sourceAssignmentId = source.assignmentId
    outboundToken.reassignedFromAssignmentId = source.assignmentId
    outboundToken.assignmentId = target.assignmentId
    outboundToken.groupJobId = job.groupJobId
    outboundToken.jobId = target.jobId
    outboundToken.sourceWorkerId = tonumber(stoppedWorkerId) or stoppedWorkerId
    outboundToken.workerId = target.workerId
    target.assignmentResumeToken = common.copy(outboundToken)
  else
    target.assignmentResumeToken = nil
  end
  local pending = {
    sourceWorkerId = tonumber(stoppedWorkerId) or stoppedWorkerId, targetWorkerId = tonumber(targetWorkerId) or targetWorkerId, assignmentId = target.assignmentId, sourceAssignmentId = source.assignmentId,
    jobId = target.jobId, chunkKeys = common.copy(source.chunkKeys), transitKeys = common.copy(source.transitKeys or {}), bay = bayId, bayId = bayId, dock = common.copy(dock or {}), dockId = dockId,
    homeWorld = common.copy(target.homeWorld), maxDepth = target.maxDepth, facing = target.facing, homeY = target.homeY, bottomY = target.bottomY, layers = target.layers, assignmentResumeToken = common.copy(outboundToken), sentAt = common.nowSeconds(), status = "awaiting_ack",
  }
  local payload = {
    scope = "group", group = true, groupId = job.groupId, groupJobId = job.groupJobId, parentGroupJobId = job.groupJobId, groupCommand = "START", requestedCommand = "start", command = "start", assignmentCatalog = common.copy(job.catalog),
    assignmentId = target.assignmentId, sourceAssignmentId = source.assignmentId, reassignedFromAssignmentId = source.assignmentId, assignmentResumeToken = common.copy(outboundToken), assignmentChunks = common.copy(pending.chunkKeys), chunkKeys = common.copy(pending.chunkKeys), transitKeys = common.copy(pending.transitKeys), seedKey = target.seedKey,
    homeY = target.homeY, bottomY = target.bottomY, targetY = target.bottomY, layers = target.layers, width = job.width, length = job.length, depth = target.layers or job.depth, chunkMode = job.chunkMode,
    name = job.name, profile = job.profile, waterMode = job.waterMode, lighting = common.copy(job.lighting or {}), workerId = target.workerId, targetWorkerId = target.workerId,
    bay = target.bay, bayId = target.bayId, dock = common.copy(target.dock or {}), dockId = target.dockId, homeWorld = common.copy(target.homeWorld), maxDepth = target.maxDepth, facing = target.facing,
    lease = { groupJobId = job.groupJobId, assignmentId = target.assignmentId, workerId = target.workerId, mode = job.chunkMode, kind = "mine", chunks = common.copy(pending.chunkKeys) }, assignment = common.copy(target),
    leases = { transit = { groupJobId = job.groupJobId, assignmentId = target.assignmentId, workerId = target.workerId, mode = job.chunkMode, kind = "transit", chunks = common.copy(pending.transitKeys) }, mine = { groupJobId = job.groupJobId, assignmentId = target.assignmentId, workerId = target.workerId, mode = job.chunkMode, kind = "mine", chunks = common.copy(pending.chunkKeys) } },
  }
  job.pendingReassignment = pending
  saveControllerDb()
  local ok = sendCommand(target.workerId, "start", payload)
  if ok then
    pending.sentAt = common.nowSeconds()
    pending.status = "awaiting_ack"
    saveControllerDb()
    setNotice("Residual reassignment sent; awaiting worker ACK.", false)
  else
    job.pendingReassignment = nil
    saveControllerDb()
    setNotice("Residual reassignment send failed; original lease retained.", true)
  end
  return ok
end

local function groupSchedulerTick()
  local now = common.nowSeconds()
  if now == groupSchedulerLast then return end
  groupSchedulerLast = now
  -- Emergency fuel/service requests take precedence over ordinary staggered
  -- starts.  The cap is persisted per group so restarts cannot overfill a bay.
  for _, job in pairs(db.groupJobs or {}) do
    if type(job) == "table" and (job.status == "starting" or job.status == "queued" or job.status == "working" or job.status == "PARTIAL_START") then
      local group = groupRecord(job.groupId)
      job.awaitingAck = job.awaitingAck or {}
      job.pending = job.pending or {}
      job.attempts = job.attempts or {}
      if job.pendingReassignment and now - tonumber(job.pendingReassignment.sentAt or now) >= 10 then
        local pending = job.pendingReassignment
        job.pendingReassignment = nil
        job.alerts = job.alerts or {}
        job.alerts[#job.alerts + 1] = "REASSIGN_TIMEOUT:#" .. tostring(pending.targetWorkerId)
        updateGroupAggregate(job)
        saveControllerDb()
      end
      for waitingKey, waiting in pairs(job.awaitingAck) do
        if now - tonumber(waiting.sentAt or now) >= 10 then
          local attempts = tonumber(job.attempts[waitingKey] or waiting.attempts or 1)
          job.awaitingAck[waitingKey] = nil
          if attempts >= 2 then
            rejectGroupStart(job, waitingKey, "start ACK timeout")
          else
            job.pending[waitingKey] = true
            local assignment = job.assignments and (job.assignments[waitingKey] or job.assignments[tonumber(waitingKey)])
            if assignment then assignment.status = "queued" end
            job.nextDispatchAt = now
          end
        end
      end
      local limit = math.max(1, tonumber(group and group.replenishConcurrency or db.groupScheduler.replenishConcurrency) or 1)
      local activeService = 0
      job.serviceSentAt = job.serviceSentAt or {}
      for _, id in ipairs(groupWorkerIds(group)) do
        local data = workerData(id) or {}
        if data.status == "waiting_fuel" or tonumber(data.fuel) and tonumber(data.fuel) <= tonumber(data.fuelLowWatermark or 0) then
          activeService = activeService + 1
          if activeService <= limit and now - tonumber(job.serviceSentAt[tostring(id)] or 0) >= 5 then
            sendCommand(id, "service", { scope = "group", group = true, groupCommand = "SERVICE", groupId = job.groupId, groupJobId = job.groupJobId, priority = "EMERGENCY_FUEL", targetWorkerId = id, workerId = id })
            job.serviceSentAt[tostring(id)] = now
          end
        end
      end
      if job.status == "starting" and now >= tonumber(job.nextDispatchAt or 0) then dispatchGroupJob(job, false) end
    end
  end
end

local function buildAssignments(result)
  local id, worker = draftWorker()
  if not id or not worker then return nil, "No worker selected." end
  -- A worker's calibrated home is the authoritative entrance for its plan.
  -- Until a future protocol can describe independent entrances, never split a
  -- single footprint at runtime; queue dispatch below handles parallel jobs.
  local assignments = {}
  local base = "q-" .. tostring(os.getComputerID()) .. "-" .. tostring(common.nowMillis())
  local selectedKeys = {}
  for _, chunk in ipairs(result.catalog or {}) do
    local excluded = false
    for _, item in ipairs(result.excludedChunks or {}) do if item.key == chunk.key then excluded = true; break end end
    if not excluded then selectedKeys[#selectedKeys + 1] = chunk.key end
  end
  assignments[1] = { workerId = id, assignmentId = base .. ":1", jobId = base, chunks = selectedKeys }
  return assignments
end

local function startDraft()
  if not draft then return false end
  -- Worker position, GPS visibility and active-job state may change while the
  -- preflight page is open. START must use a fresh result, not yesterday's
  -- green snapshot.
  local result = computePreflight()
  if not result then setNotice("Preflight failed.", true); return false end
  if result.fatal then setNotice("Start blocked by a fatal preflight item.", true); return false end
  local assignments, assignmentError = buildAssignments(result)
  if not assignments then setNotice(assignmentError, true); return false end
  local leases = {}
  for _, assignment in ipairs(assignments) do
    local lease, err = reserveLease(assignment.jobId, assignment.workerId, result.chunkMode, assignment.chunks, assignment.assignmentId)
    if not lease then
      for _, prior in ipairs(leases) do releaseLeasesForWorker(prior.workerId, prior.jobId) end
      setNotice(err, true)
      return false
    end
    leases[#leases + 1] = lease
  end
  local sent, sentAssignments = true, {}
  for _, assignment in ipairs(assignments) do
    local payloadDepth = result.jobDepth or draft.depth
    local payloadLighting = common.copy(draft.lighting)
    if type(payloadLighting) ~= "table" then payloadLighting = { mode = "safe" } end
    if result.effectiveInterval == 0 then payloadLighting.interval = nil else payloadLighting.interval = result.effectiveInterval end
    local payload = {
      width = draft.width, length = draft.length, depth = payloadDepth,
      chunkMode = result.chunkMode, excludedChunks = result.excludedChunks,
      lighting = payloadLighting, waterMode = draft.waterMode, profile = draft.profile,
      name = draft.name or ("Quarry %dx%dx%d"):format(draft.width, draft.length, payloadDepth),
      -- assignmentId is group-only wire metadata. Sending it for an ordinary
      -- one-worker quarry makes the worker correctly demand assignmentChunks
      -- and reject the otherwise valid full-footprint job.
      jobId = assignment.jobId,
    }
    if result.chunkMode == "world" then payload.targetY = result.targetY end
    local sentOK, _, messageId = sendCommand(assignment.workerId, "start", payload)
    if not sentOK then sent = false; break end
    db.pendingStarts[tostring(assignment.workerId)] = {
      workerId = assignment.workerId, jobId = assignment.jobId,
      assignmentId = assignment.assignmentId, messageId = messageId,
      sentAt = common.nowSeconds(),
    }
    sentAssignments[#sentAssignments + 1] = assignment
  end
  if not sent then
    for _, assignment in ipairs(assignments) do db.pendingStarts[tostring(assignment.workerId)] = nil end
    for _, assignment in ipairs(sentAssignments) do sendCommand(assignment.workerId, "stop", { mode = "abort", assignmentId = assignment.assignmentId }) end
    for _, assignment in ipairs(assignments) do releaseLeasesForWorker(assignment.workerId, assignment.jobId) end
    setNotice("One or more workers rejected the job; all assignments were stopped.", true)
    return false
  end
  db.lastDraft = persistentDraft(draft)
  db.lastPreset = draft.profile or db.lastPreset
  if draft.queueIndex and db.queue[draft.queueIndex] then
