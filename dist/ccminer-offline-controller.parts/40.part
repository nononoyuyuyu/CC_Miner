local function processChar(character)
  character = string.lower(character or "")
  if mode == "job_dimensions" then
    if character:match("%d") or character == "-" then draftDigit(character) end
    return
  elseif mode == "group_dimensions" or mode == "group_job" then
    if character:match("%d") or character == "-" then groupDraftDigit(character)
    elseif character == "p" then
      local gid = selectedGroupRecord()
      if gid and groupDraft then commitGroupDraftField(); groupDraft.preflight = computeGroupPreflight(gid, groupDraft); invalidate() end
    elseif character == "s" then
      local gid = selectedGroupRecord()
      if gid and groupDraft then commitGroupDraftField(); local result = groupDraft.preflight or computeGroupPreflight(gid, groupDraft); groupDraft.preflight = result; if result and not result.fatal then startGroup(gid, groupDraft) end; invalidate() end
    elseif character == "b" or character == "q" then mode = "groups"; invalidate() end
    return
  elseif mode == "confirm" then
    if character == "y" then
      if confirmState and confirmState.twoStep and not confirmState.armed then
        confirmState.armed = true; confirmState.message = "FINAL confirmation: press Y again to send REHOME RESET."; invalidate(); return
      end
      local id = selectedWorker()
      if confirmState and id then
        if confirmState.command == "stop" then stageStop(id, (confirmState.payload or {}).mode or "abort") else sendCommand(id, confirmState.command, confirmState.payload) end
      end
      confirmState, mode = nil, "dashboard"
    elseif character == "n" then confirmState, mode = nil, "dashboard"; setNotice("Cancelled.", false) end
    return
  elseif mode == "error_detail" then
    if character == "o" or character == "b" or character == "q" then noticeState.dismiss() end
    return
  elseif mode == "job_grid" then
    if character == "a" then allGrid(true) elseif character == "c" then allGrid(false) elseif character == "i" then invertGrid() elseif character == "r" then draft.rectMode = not draft.rectMode; draft.rectStart = nil; invalidate() end
    return
  elseif mode == "groups" then
    local ids = orderedGroupIds()
    if character == "s" then groupAction("start")()
    elseif character == "p" then groupAction("pause")()
    elseif character == "r" then groupAction("resume")()
    elseif character == "h" then groupAction("return")()
    elseif character == "v" then mode = "group_info"; invalidate()
    end
    return
  elseif mode == "group_info" then
    if character == "b" or character == "q" then mode = "groups"; invalidate() end
    return
  end
  if mode ~= "dashboard" then return end
  local id = selectedWorker()
  if character == "d" then discover()
  elseif character == "n" then dashboardAction("new")()
  elseif character == "p" then sendCommand(id, "pause")
  elseif character == "r" then sendCommand(id, "resume")
  elseif character == "h" then sendCommand(id, "recall")
  elseif character == "s" then dashboardAction("stop")()
  elseif character == "x" then dashboardAction("abort")()
  elseif character == "c" then dashboardAction("clear")()
  elseif character == "i" then dashboardAction("info")()
  elseif character == "g" then dashboardAction("progress")()
  elseif character == "o" then dashboardAction("remote")()
  elseif character == "e" then dashboardAction("recovery")()
  elseif character == "t" then dashboardAction("report")()
  elseif character == "l" then dashboardAction("gps")()
  elseif character == "v" then dashboardAction("groups")()
  elseif character == "q" then running = false end
end

local function processKey(keyCode)
  if keys and keyCode == keys.escape then
    if mode == "dashboard" then
      running = false
    else
      mode, draft, confirmState = "dashboard", nil, nil
      invalidate()
    end
    return
  end
  if mode == "dashboard" then
    local ids = orderedIds()
    if keys and keyCode == keys.up then
      selected = math.max(1, selected - 1)
      invalidate()
    elseif keys and keyCode == keys.down then
      selected = math.min(math.max(1, #ids), selected + 1)
      invalidate()
    elseif keys and keyCode == keys.enter then
      mode = "info"
      invalidate()
    end
  elseif mode == "error_detail" then
    if keys and (keyCode == keys.enter or keyCode == keys.backspace or keyCode == keys.escape) then noticeState.dismiss() end
  elseif mode == "groups" then
    local ids = orderedGroupIds()
    if keys and keyCode == keys.up then selectedGroup = math.max(1, selectedGroup - 1); invalidate()
    elseif keys and keyCode == keys.down then selectedGroup = math.min(math.max(1, #ids), selectedGroup + 1); invalidate()
    elseif keys and keyCode == keys.enter then mode = "group_info"; invalidate()
