    name = previous.name or (group and group.name and ("Group " .. tostring(group.name)) or "Group Quarry"),
  }
end

local function groupCatalogAndShape(group, value)
  local mode = value.mode == "world" and "world" or "local"
  local specs = groupWorkerSpecs(group)
  local calibration
  for _, spec in ipairs(specs) do
    if spec.calibration then calibration = spec.calibration; break end
  end
  local catalog, err
  if type(value.catalog) == "table" and #value.catalog > 0 then
    catalog = common.copy(value.catalog)
  else
    catalog, err = quarry.buildCatalog(value.width, value.length, mode, calibration)
  end
  if not catalog then return nil, err end
  local rootKey
  for _, chunk in ipairs(catalog) do
    if 0 >= chunk.minX and 0 <= chunk.maxX and 1 >= chunk.minZ and 1 <= chunk.maxZ then rootKey = chunk.key; break end
  end
  return catalog, nil, mode, rootKey, specs
end

local function groupCatalogDescriptor(catalog, mode, rootKey, specs)
  local reference
  for _, spec in ipairs(specs or {}) do if spec.calibration then reference = spec.calibration; break end end
  local descriptor = { mode = mode, rootKey = rootKey, chunks = {}, origin = reference and common.copy(reference.home) or nil, calibrationSeed = reference and { home = common.copy(reference.home), forward = common.copy(reference.forward) } or nil }
  for _, chunk in ipairs(catalog or {}) do
    descriptor.chunks[#descriptor.chunks + 1] = {
      key = tostring(chunk.key), mode = mode, cx = tonumber(chunk.cx), cz = tonumber(chunk.cz), cells = tonumber(chunk.cells),
      minX = tonumber(chunk.minX), maxX = tonumber(chunk.maxX), minZ = tonumber(chunk.minZ), maxZ = tonumber(chunk.maxZ),
    }
  end
  return descriptor
end

local function groupLeaseConflict(mode, workerId, keys, kind, groupJobId)
  local function overlaps(lease)
    if tostring(lease.groupJobId or "") == tostring(groupJobId or "") then return false end
    local leaseMode = lease.mode == "world" and "world" or "local"
    if leaseMode ~= mode then return false end
    if mode == "local" and tonumber(lease.workerId) ~= tonumber(workerId) then return false end
    local set = {}; for _, key in ipairs(lease.chunks or lease.keys or {}) do set[tostring(key)] = true end
    for _, key in ipairs(keys or {}) do if set[tostring(key)] then return true end end
    return false
  end
  for _, lease in ipairs(db.groupLeases or {}) do if overlaps(lease) then return lease end end
  for _, lease in ipairs(db.leases or {}) do if overlaps(lease) then return lease end end
  return nil
end

local function computeGroupPreflight(groupId, value)
  local group = groupRecord(groupId)
  if not group then return nil, "group_not_found" end
  value = type(value) == "table" and value or groupDraftDefaults(group)
  local catalog, catalogError, chunkMode, rootKey, specs = groupCatalogAndShape(group, value)
  if not catalog then return nil, catalogError end
  local checks, fatal = {}, false
  local function check(name, state, detail, hard)
    checks[#checks + 1] = { name = name, state = state, detail = detail, fatal = hard == true }
    if hard and state == "bad" then fatal = true end
  end
  local ids = groupWorkerIds(group)
  if #ids == 0 then check("workers", "bad", "group has no workers", true) end
  local maxWorkers = tonumber(config.group and config.group.maxWorkers)
  if maxWorkers and #ids > maxWorkers then check("worker limit", "bad", tostring(#ids) .. " > " .. tostring(maxWorkers), true) end
  local defaultBayId = group.bayId and tostring(group.bayId) or nil
  local defaultDockId = group.dockId and tostring(group.dockId) or nil
  local bay = defaultBayId and db.bays[defaultBayId] or nil
  local dock = defaultDockId and db.docks[defaultDockId] or nil
  local worldMode = chunkMode == "world"
  local partitionStrategy = tostring(value.partition or group.partition or (config.group and config.group.partitionMode) or "stripe"):lower()
  if partitionStrategy ~= "stripe" and partitionStrategy ~= "round_robin" then
    check("partition mode", "bad", partitionStrategy .. " is unsupported", true)
    partitionStrategy = "stripe"
  end
  if worldMode and not rootKey then check("root chunk", "bad", "common catalog has no root chunk", true) end
  if worldMode and #ids > 1 and type(quarry.partitionGroup) ~= "function" and type(quarry.partitionChunks) ~= "function" then
    check("partition API", "bad", "quarry.partitionGroup unavailable", true)
  end
  if #ids > 1 and type(quarry.shortestServiceRoute) ~= "function" then
    check("service route API", "bad", "quarry.shortestServiceRoute unavailable", true)
  else
    check("service route API", "ok", "worker route planner ready", false)
  end
  if worldMode and not bay and type(group.workerBays) ~= "table" then check("bay", "bad", "world group requires a registered bay", true) elseif bay then check("bay", "ok", tostring(group.bayId), false) end
  if dock then check("dock", "ok", tostring(group.dockId), false) elseif worldMode and type(group.workerDocks) ~= "table" then check("dock", "warn", "dock metadata unavailable", false) end
  local commonBottom = tonumber(value.bottomY or value.targetY)
  local minDepth, minFuel, maxRequiredFuel = nil, nil, 0
  local referenceCalibration
  local referenceHomeY, referenceForward
  local catalogWorldSet = {}
  for _, chunk in ipairs(catalog or {}) do catalogWorldSet[tostring(chunk.key)] = true end
  if worldMode and type(quarry.inverseWorldToLocal) ~= "function" then
    check("world inverse API", "bad", "quarry.inverseWorldToLocal unavailable", true)
  end
  local homeChunkOwners = {}
  for index, spec in ipairs(specs) do
    local id, data = spec.workerId, workerData(spec.workerId) or {}
    local bayId, workerBay = groupWorkerResource(group, id, "bay")
    local dockId, workerDock = groupWorkerResource(group, id, "dock")
    local status = statusOf(workers[id])
    if status == "offline" then check("online:#" .. tostring(id), "bad", "offline", true) else check("online:#" .. tostring(id), "ok", status, false) end
    local version = tostring(data.version or data.workerVersion or data.protocolVersion or "")
    if version == "" then check("version:#" .. tostring(id), "bad", "worker version unknown", true) elseif version ~= common.VERSION then check("version:#" .. tostring(id), "bad", version .. " != " .. common.VERSION, true) else check("version:#" .. tostring(id), "ok", version, false) end
    if data.atHome == true then check("home:#" .. tostring(id), "ok", "at home", false) else check("home:#" .. tostring(id), "bad", "worker is not at home", true) end
    local caps = data.capabilities or {}
    local groupCap = caps.groupControl or caps.groupJobs or caps.group or caps.groupAssignment or data.groupSupported
    if groupCap == false then check("capability:#" .. tostring(id), "bad", "group control unsupported", true)
    elseif groupCap == nil and worldMode then check("capability:#" .. tostring(id), "bad", "world group capability must be explicitly supported", true)
    elseif groupCap == nil then check("capability:#" .. tostring(id), "warn", "group capability unknown", false)
    else check("capability:#" .. tostring(id), "ok", "group ready", false) end
    if worldMode then
      local gps = data.gps and data.gps.calibration
      if not gps or not gps.home or not tonumber(gps.home.x) or not tonumber(gps.home.y) or not tonumber(gps.home.z)
        or not gps.forward or not tonumber(gps.forward.x) or not tonumber(gps.forward.z) then
        check("GPS:#" .. tostring(id), "bad", "calibration with home/forward coordinates required", true)
      else check("GPS:#" .. tostring(id), "ok", "calibrated", false) end
      if gps and gps.home and tonumber(gps.home.x) and tonumber(gps.home.y) and tonumber(gps.home.z)
        and gps.forward and tonumber(gps.forward.x) and tonumber(gps.forward.z) then
        referenceHomeY = referenceHomeY or tonumber(gps.home.y)
        referenceForward = referenceForward or { x = tonumber(gps.forward.x), z = tonumber(gps.forward.z) }
        if referenceCalibration then
          local same = tonumber(referenceCalibration.forward.x) == tonumber(gps.forward.x) and tonumber(referenceCalibration.forward.z) == tonumber(gps.forward.z)
          if not same then check("GPS orientation:#" .. tostring(id), "bad", "world calibration differs from group reference", true) end
        else referenceCalibration = gps end
        if referenceHomeY and tonumber(gps.home.y) ~= referenceHomeY then check("GPS floor:#" .. tostring(id), "bad", "worker HOME Y differs from group floor", true) end
        local homeCx, homeCz = math.floor(tonumber(gps.home.x) / 16), math.floor(tonumber(gps.home.z) / 16)
        local homeKey = quarry.chunkKey("world", homeCx, homeCz)
        spec.bayChunkKey = tostring(homeKey)
        if not catalogWorldSet[tostring(homeKey)] then check("bay footprint:#" .. tostring(id), "bad", "worker bay entrance is outside common world footprint", true) end
        local forwardX, forwardZ = tonumber(gps.home.x) + tonumber(gps.forward.x), tonumber(gps.home.z) + tonumber(gps.forward.z)
        local forwardKey = quarry.chunkKey("world", math.floor(forwardX / 16), math.floor(forwardZ / 16))
        if not catalogWorldSet[tostring(forwardKey)] then check("forward footprint:#" .. tostring(id), "bad", "worker bay forward entrance is outside common footprint", true) end
        if tostring(homeKey) ~= tostring(forwardKey) then check("bay chunk:#" .. tostring(id), "bad", "worker home and forward entrance must share one bay chunk", true) end
        if homeChunkOwners[tostring(homeKey)] then
          check("bay chunk unique:#" .. tostring(id), "bad", "bay chunk already owned by worker #" .. tostring(homeChunkOwners[tostring(homeKey)]), true)
        else
          homeChunkOwners[tostring(homeKey)] = id
        end
        if type(quarry.inverseWorldToLocal) == "function" and referenceCalibration then
          local okInverse, localForward = pcall(quarry.inverseWorldToLocal, referenceCalibration, forwardX, forwardZ)
          if not okInverse or type(localForward) ~= "table" then
            check("bay cell:#" .. tostring(id), "bad", "cannot rebase worker forward entrance to common catalog", true)
          else
            local forwardCell = false
            for _, chunk in ipairs(catalog or {}) do
              if tonumber(localForward.x) >= tonumber(chunk.minX) and tonumber(localForward.x) <= tonumber(chunk.maxX)
                and tonumber(localForward.z) >= tonumber(chunk.minZ) and tonumber(localForward.z) <= tonumber(chunk.maxZ) then
                forwardCell = tostring(chunk.key) == tostring(homeKey) or forwardCell
              end
            end
            if not forwardCell then check("bay cell:#" .. tostring(id), "bad", "worker forward entrance is outside its bay chunk cells", true)
            else check("bay cell:#" .. tostring(id), "ok", "forward entrance is inside its bay chunk", false) end
          end
        end
      end
      if not workerBay then
        check("bay:#" .. tostring(id), "bad", "registered bay metadata unavailable", true)
      elseif not workerBay.world then
        check("bay pose:#" .. tostring(id), "bad", "bay world pose unavailable", true)
      elseif workerBay.world then
        local pos = data.world or data.position
        local match = pos and tonumber(pos.x) == tonumber(workerBay.world.x) and tonumber(pos.y) == tonumber(workerBay.world.y) and tonumber(pos.z) == tonumber(workerBay.world.z)
        if match then check("bay pose:#" .. tostring(id), "ok", "world pose verified", false) else check("bay pose:#" .. tostring(id), "bad", "worker is not at bay world pose", true) end
        local facing = data.facing or data.pose and data.pose.dir
        if facing == nil then check("bay facing:#" .. tostring(id), "bad", "worker facing unavailable", true)
        elseif workerBay.facing ~= nil and tostring(facing) ~= tostring(workerBay.facing) then check("bay facing:#" .. tostring(id), "bad", "facing mismatch", true)
