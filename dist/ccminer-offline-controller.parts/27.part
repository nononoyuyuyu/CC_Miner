  if tostring(wireCommand or ""):lower() ~= "remote_console" then return false end
  local action = remoteAckField(payload, result, "action")
    or remoteAckField(payload, result, "remoteAction")
  if action ~= nil and tostring(action):lower() ~= tostring(pending.action):lower() then return false end
  local sessionId = remoteAckField(payload, result, "sessionId")
  local nonce = remoteAckField(payload, result, "nonce")
  -- The worker creates fresh session credentials on OPEN and returns them in
  -- the result table.  Subsequent actions must echo those credentials exactly;
  -- the controller's provisional values are only an anti-collision hint.
  if pending.action ~= "open" then
    if sessionId ~= nil and tostring(sessionId) ~= tostring(session.sessionId) then return false end
    if nonce ~= nil and tostring(nonce) ~= tostring(session.nonce) then return false end
  end
  local sequence = remoteAckField(payload, result, "seq")
    or remoteAckField(payload, result, "sequence")
  if sequence ~= nil and tonumber(sequence) ~= tonumber(pending.seq) then return false end
  if pending.action == "open" then
    if payload.ok == true and (sessionId == nil or tostring(sessionId) == ""
      or nonce == nil or tostring(nonce) == "") then return false end
    if sessionId ~= nil and tostring(sessionId) ~= "" then session.sessionId = tostring(sessionId) end
    if nonce ~= nil and tostring(nonce) ~= "" then session.nonce = tostring(nonce) end
    local nextSequence = tonumber(remoteAckField(payload, result, "nextSeq"))
    if nextSequence and nextSequence >= 1 and nextSequence == math.floor(nextSequence) then
      session.seq = nextSequence - 1
    end
  end
  session.lastResult, session.lastAction = common.copy(payload), pending.action
  session.pending = nil
  return true
end
end

local function handleMessage(sender, message)
  local valid = protocol.validate(message, config.networkKey, os.getComputerID(), sender)
  if not valid then return false end
  if message.kind == "status" then
    local payload = normalizeStatus(message.payload)
    local id = tonumber(payload.id)
    if not id or id ~= tonumber(sender) then return false end
    workers[id] = workers[id] or {}
    local previous = workers[id].data
    workers[id].data = payload
    workers[id].lastSeen = common.nowSeconds()
    workers[id].sender = sender
    reconcileSingleWorkerLeases(id, payload)
    local groupJob = findGroupJobForWorker(id, payload)
    if groupJob then
      if groupJob.status == "starting" and payload.job and payload.job.assignmentId then acceptGroupStart(groupJob, id, payload.job.assignmentId) end
      finalizePendingReassignment(groupJob, id, payload)
      local assignment = groupJob.assignments and (groupJob.assignments[tostring(id)] or groupJob.assignments[id])
      if assignment then
        assignment.status = payload.status or payload.phase or assignment.status
        if payload.status == "complete" or payload.status == "completed" or payload.status == "aborted" or payload.status == "idle" then
          if groupJob.awaitingAck then groupJob.awaitingAck[tostring(id)] = nil end
          if groupJob.pending then groupJob.pending[tostring(id)] = nil end
        end
        assignment.progress = common.copy(payload.progress or payload.job and payload.job.progress or {})
        assignment.lastSeen = common.nowSeconds()
        if payload.status == "complete" or payload.status == "completed" then assignment.finishedAt = common.nowSeconds() end
        if payload.completionReason then assignment.returnReason = payload.completionReason end
        if payload.report or payload.stats then assignment.report = common.copy(payload.report or payload.stats) end
      end
      updateGroupAggregate(groupJob)
      if payload.completionReason then groupJob.returnReason = payload.completionReason end
      if payload.report or payload.stats then
        groupJob.metrics = groupJob.metrics or {}
        local report = payload.report or payload.stats
        for key, value in pairs(report or {}) do if type(value) ~= "table" then groupJob.metrics[key] = value end end
        if report and (report.discard or report.discardStats) then groupJob.metrics.discard = common.copy(report.discard or report.discardStats) end
        groupJob.report = common.copy(groupJob.metrics)
      end
      local allDone = true
      for _, item in pairs(groupJob.assignments or {}) do if type(item) == "table" and item.status ~= "complete" and item.status ~= "completed" and item.status ~= "reassigned" then allDone = false; break end end
      if allDone and groupJob.status == "working" then
        groupJob.status, groupJob.finishedAt = "complete", common.nowSeconds()
        releaseGroupLeases(groupJob)
        if not groupJob.historyRecorded then
          db.history[#db.history + 1] = { id = tostring(groupJob.groupJobId), kind = "group", groupJobId = groupJob.groupJobId, groupId = groupJob.groupId, workerId = nil, worker = groupName(groupRecord(groupJob.groupId), groupJob.groupId), name = groupJob.name, status = "complete", reason = groupJob.returnReason or "complete", startedAt = groupJob.startedAt, finishedAt = groupJob.finishedAt, metrics = common.copy(groupJob.metrics or groupJob.report or {}) }
          groupJob.historyRecorded = true
        end
      end
      maybeFinalizeGroup(groupJob)
      saveControllerDb()
    end
    acknowledgeQueuedStart(id, payload)
    local oldStatus = previous and tostring(previous.status or "") or ""
    local newStatus = tostring(payload.status or "unknown")
    if newStatus == "complete" and oldStatus ~= "complete" then
      addHistory(id, payload, payload.completionReason or "complete")
      releaseLeasesForWorker(id, activeJobId(previous))
      alert("complete", id, "Worker #" .. tostring(id) .. " completed a job.")
    elseif newStatus == "aborted" and oldStatus ~= "aborted" then
      addHistory(id, payload, payload.completionReason or "aborted")
      releaseLeasesForWorker(id, activeJobId(previous))
    elseif newStatus == "blocked" and oldStatus ~= "blocked" then
      alert("blocked", id, "Worker #" .. tostring(id) .. " is blocked.")
    elseif newStatus == "waiting_fuel" or newStatus == "waiting_output" or newStatus == "waiting_seal" or newStatus == "waiting_torch" or newStatus == "waiting_water" then
      alert("material", id, "Worker #" .. tostring(id) .. " needs materials.")
    else
      clearAlert(id, "blocked"); clearAlert(id, "material")
    end
    invalidate()
    return true
  elseif message.kind == "ack" then
    local payload = message.payload or {}
    local remoteMatched = noticeState.remoteApi.ackMatches(sender, message, payload)
    if payload.ok ~= true and not remoteMatched then
      db.lastCommandError = {
        workerId = tonumber(sender) or sender,
        command = tostring(payload.command or "unknown"),
        message = tostring(payload.message or "Unknown rejection"),
        at = common.nowSeconds(),
      }
      saveControllerDb()
    end
    if not remoteMatched then
      setNotice((payload.ok and "OK: " or "ERROR: ") .. tostring(payload.message or ""), not payload.ok)
    end
    handleSingleStartAck(sender, message, payload)
    local ackGroupJobId = payload.groupJobId or payload.parentGroupJobId or payload.group and payload.group.groupJobId
    if ackGroupJobId and db.groupJobs[tostring(ackGroupJobId)] then
      local ackJob = db.groupJobs[tostring(ackGroupJobId)]
      ackJob.acks = ackJob.acks or {}
      ackJob.acks[tostring(sender)] = { ok = payload.ok == true, message = payload.message, command = payload.command, at = common.nowSeconds() }
      updateGroupAggregate(ackJob)
      saveControllerDb()
    end
    if type(payload.status) == "table" and payload.status.id then
      local id = tonumber(payload.status.id)
      if not id or id ~= tonumber(sender) then return false end
      local previous = workers[id] and workers[id].data
      workers[id] = workers[id] or {}
      workers[id].data = normalizeStatus(payload.status)
      workers[id].lastSeen = common.nowSeconds()
      workers[id].sender = sender
      local groupJob = findGroupJobForWorker(id, workers[id].data)
      if groupJob then
        local statusJob = workers[id].data.job or {}
        if payload.ok and statusJob.assignmentId and groupJob.status == "starting" then acceptGroupStart(groupJob, id, statusJob.assignmentId)
        elseif payload.ok == false and groupJob.status == "starting" then rejectGroupStart(groupJob, id, payload.message or "start rejected")
        elseif payload.ok == false and (groupJob.status == "aborting" or groupJob.status == "clear_requested") then
          if groupJob.awaitingAck then groupJob.awaitingAck[tostring(id)] = nil end
          if groupJob.pending then groupJob.pending[tostring(id)] = nil end
        end
        local pending = groupJob.pendingReassignment
        local ackMatchesReassignment = not pending
          or (payload.assignmentId ~= nil and tostring(payload.assignmentId) == tostring(pending.assignmentId))
        if pending and payload.ok == false and (payload.assignmentId == nil or tostring(payload.assignmentId) == tostring(pending.assignmentId)) then
          groupJob.pendingReassignment = nil
          groupJob.alerts = groupJob.alerts or {}
          groupJob.alerts[#groupJob.alerts + 1] = "REASSIGN_REJECTED:#" .. tostring(id) .. ":" .. tostring(payload.message or "worker rejected")
        elseif ackMatchesReassignment then
          finalizePendingReassignment(groupJob, id, workers[id].data)
        end
        groupJob.acks = groupJob.acks or {}
        groupJob.acks[tostring(id)] = { ok = payload.ok == true, message = payload.message, at = common.nowSeconds() }
        updateGroupAggregate(groupJob)
        saveControllerDb()
      end
      acknowledgeQueuedStart(id, workers[id].data)
      local st = workers[id].data.status
      if (st == "complete" or st == "aborted") and previous and previous.status ~= st then
        addHistory(id, workers[id].data, workers[id].data.completionReason or st)
        releaseLeasesForWorker(id, activeJobId(previous))
      end
    end
    return true
  end
  return false
end

local function discover()
  protocol.broadcast(protocol.message("discover", config.networkKey, { controllerName = config.controllerName, v3 = true }))
  lastDiscovery = common.nowSeconds()
  setNotice("Discovery broadcast sent.", false)
end

local function sendCommand(id, command, payload)
  if not id then setNotice("No worker selected.", true); return false end
  payload = payload or {}
  payload.command = command
  local wireMessage = protocol.message("command", config.networkKey, payload, id)
  local ok, err = protocol.send(id, wireMessage)
  if ok then setNotice(("Command '%s' sent to #%s."):format(command, tostring(id)), false)
  else setNotice("Send failed: " .. tostring(err), true) end
  return ok, err, wireMessage.id
end

do
local function remoteToken(prefix)
  local millis = common.nowMillis and common.nowMillis() or math.floor(common.nowSeconds() * 1000)
  return ("%s-%d-%d-%d"):format(tostring(prefix or "remote"), os.getComputerID(), millis, math.random(100000, 999999))
end

local function remoteRedactText(value)
  local text = tostring(value or "")
  local key = type(config.networkKey) == "string" and config.networkKey or ""
  -- Replace the configured key using plain-string searches.  Network keys may
  -- contain Lua pattern characters, and they must never appear in CLI output.
  if key ~= "" then
    local output, cursor = {}, 1
    while true do
      local startAt, endAt = text:find(key, cursor, true)
      if not startAt then output[#output + 1] = text:sub(cursor); break end
      output[#output + 1] = text:sub(cursor, startAt - 1)
      output[#output + 1] = "[REDACTED]"
      cursor = endAt + 1
    end
    text = table.concat(output)
  end
  return text
end

local function remoteSensitiveKey(key)
  local name = tostring(key or ""):lower():gsub("[^%a%d]", "")
