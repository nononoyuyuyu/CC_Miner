      if statusOf(worker) == "offline" then setNotice("Selected worker is offline.", true); return end
      local previous = db.lastDraft or {}
      local previousLighting = normalizedLighting(previous.lighting)
      local previousWater = normalizedWaterMode(previous.waterMode)
      local previousProfile = normalizedProfile(previous.profile)
      local previousDepth = tonumber(previous.depth) or 16
      local calibration = draftCalibration(workerId)
      local previousTarget = tonumber(previous.targetY)
      if calibration and calibration.home and tonumber(calibration.home.y) then
        previousTarget = previousTarget or (tonumber(calibration.home.y) - previousDepth + 1)
      else
        previousTarget = nil
      end
      draft = {
        workerId = workerId, width = tonumber(previous.width) or 8, length = tonumber(previous.length) or 32,
        depth = previousDepth, targetY = previousTarget,
        lighting = previousLighting, waterMode = previousWater, profile = previousProfile,
        selectedField = "width", buffer = tostring(previous.width or 8), excluded = common.copy(previous.excluded or {}),
        partialMask = previous.partialMask == true, chunkPage = 1, gridPageX = 1, gridPageZ = 1,
        rectMode = false, rectStart = nil, autoAssign = false, name = previous.name,
      }
      db.lastDraft = persistentDraft(draft)
      mode = "job_dimensions"
      invalidate()
    elseif name == "info" then
      if id then mode = "info" else setNotice("No worker selected.", true) end
    elseif name == "workers" then
      mode, noticeState.workerPage = "workers", 1
      noticeState.groupSelectMode, noticeState.groupSelection = false, {}
    elseif name == "more" then mode = "more"; noticeState.morePage = 1
    elseif name == "items" then
      if id and noticeState.openItems then noticeState.openItems()
      else setNotice("Select a worker before opening item settings.", true) end
    elseif name == "remote" then
      if id then
        setNotice(("Remote console is CLI-only: ccm remote %s [-- <command...>]"):format(tostring(id)), false)
      else
        setNotice("Select a worker, then use ccm remote <workerId> in the terminal.", true)
      end
    elseif name == "progress" then
      if id then mode = "progress" else setNotice("No worker selected.", true) end
    elseif name == "recovery" then
      if id then mode = "recovery" else setNotice("No worker selected.", true) end
    elseif name == "report" then mode = "report"
    elseif name == "last_error" then noticeState.showLast()
    elseif name == "stop" then if id then mode = "stop_menu" else setNotice("No worker selected.", true) end
    elseif name == "pause" or name == "resume" or name == "recall" or name == "service" then sendCommand(id, name)
    elseif name == "abort" then
      if id then confirmState = { command = "stop", payload = { mode = "abort" }, message = "Abort the active job and return home?" }; mode = "confirm" end
    elseif name == "clear" then
      if id then confirmState = { command = "clear", message = "Clear the completed or aborted job record?" }; mode = "confirm" end
    elseif name == "rehome" then
      if id then confirmState = { command = "rehome", payload = { confirm = "RESET" }, twoStep = true, message = "REHOME RESET clears the active job. Press YES twice only when the turtle is physically in its dock." }; mode = "confirm" end
    elseif name == "gps" then
      if id then confirmState = { command = "calibrate_gps", message = "GPS calibration moves forward one block and back. Is the dock front clear?" }; mode = "confirm" end
    elseif name == "quit" then running = false end
    invalidate()
  end
end

local function sortingTick()
  local settings = config.sorting
  if not settings or settings.enabled ~= true or common.nowSeconds() - lastSorting < (tonumber(settings.interval) or 30) then return end
  lastSorting = common.nowSeconds()
  if not peripheral or not peripheral.wrap then return end
  local source = peripheral.wrap(settings.source or "")
  local valuable = peripheral.wrap(settings.valuableTarget or "")
  local bulk = peripheral.wrap(settings.bulkTarget or "")
  local seal = peripheral.wrap(settings.sealTarget or "")
  if not source or type(source.list) ~= "function" or type(source.pushItems) ~= "function" then
    if not sortingWarned then sortingWarned = true; setNotice("Sorting WARN: source inventory is not configured.", false) end
    return
  end
  if not valuable or not bulk or not seal then
    if not sortingWarned then sortingWarned = true; setNotice("Sorting WARN: one or more target inventories are missing.", false) end
    return
  end
  local valuableItems, sealItems = settings.valuableItems or {}, settings.sealBlocks or {}
  for slot, item in pairs(source.list() or {}) do
    local destination = bulk
    if valuableItems[item.name] == true then destination = valuable
    elseif sealItems[item.name] == true then destination = seal end
    local targetName = destination == valuable and (settings.valuableTarget or "") or destination == seal and (settings.sealTarget or "") or (settings.bulkTarget or "")
    pcall(source.pushItems, targetName, slot, item.count)
  end
end
