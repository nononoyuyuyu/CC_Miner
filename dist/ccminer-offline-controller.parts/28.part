      if (st == "complete" or st == "aborted") and previous and previous.status ~= st then
        addHistory(id, workers[id].data, workers[id].data.completionReason or st)
        releaseLeasesForWorker(id, activeJobId(previous))
      end
    end
    return true
  end
  return false
end

local function discover()
  protocol.broadcast(protocol.message("discover", config.networkKey, { controllerName = config.controllerName, v3 = true }))
  lastDiscovery = common.nowSeconds()
  setNotice("Discovery broadcast sent.", false)
end

local function sendCommand(id, command, payload)
  if not id then setNotice("No worker selected.", true); return false end
  payload = payload or {}
  payload.command = command
  local wireMessage = protocol.message("command", config.networkKey, payload, id)
  local ok, err = protocol.send(id, wireMessage)
  if ok then setNotice(("Command '%s' sent to #%s."):format(command, tostring(id)), false)
  else setNotice("Send failed: " .. tostring(err), true) end
  return ok, err, wireMessage.id
end

do
local function remoteToken(prefix)
  local millis = common.nowMillis and common.nowMillis() or math.floor(common.nowSeconds() * 1000)
  return ("%s-%d-%d-%d"):format(tostring(prefix or "remote"), os.getComputerID(), millis, math.random(100000, 999999))
end

local function remoteRedactText(value)
  local text = tostring(value or "")
  local key = type(config.networkKey) == "string" and config.networkKey or ""
  -- Replace the configured key using plain-string searches.  Network keys may
  -- contain Lua pattern characters, and they must never appear in CLI output.
  if key ~= "" then
    local output, cursor = {}, 1
    while true do
      local startAt, endAt = text:find(key, cursor, true)
      if not startAt then output[#output + 1] = text:sub(cursor); break end
      output[#output + 1] = text:sub(cursor, startAt - 1)
      output[#output + 1] = "[REDACTED]"
      cursor = endAt + 1
    end
    text = table.concat(output)
  end
  return text
end

local function remoteSensitiveKey(key)
  local name = tostring(key or ""):lower():gsub("[^%a%d]", "")
  return name == "networkkey" or name == "password" or name == "passwd"
    or name == "secret" or name == "token" or name == "nonce"
    or name == "sessionid" or name == "apikey" or name == "auth"
end

local function remoteValueText(value, depth, field)
  if remoteSensitiveKey(field) then return "[REDACTED]" end
  depth = tonumber(depth) or 0
  if value == nil then return "-" end
  if type(value) == "string" then return remoteRedactText(value) end
  if type(value) == "number" or type(value) == "boolean" then return tostring(value) end
  if type(value) ~= "table" then return remoteRedactText(value) end
  if depth >= 3 then return "{...}" end
  local keys = {}
  for key in pairs(value) do keys[#keys + 1] = key end
  table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
  local parts = {}
  for _, key in ipairs(keys) do
    parts[#parts + 1] = tostring(key) .. "=" .. remoteValueText(value[key], depth + 1, key)
    if #parts >= 32 then parts[#parts + 1] = "..."; break end
  end
  return "{" .. table.concat(parts, ",") .. "}"
end

local function remoteResultTable(payload)
  if type(payload) ~= "table" then return nil end
  if type(payload.result) == "table" then return payload.result end
  if type(payload.response) == "table" then return payload.response end
  if type(payload.data) == "table" then return payload.data end
  return nil
end

local function remoteAckMessage(payload)
  local result = remoteResultTable(payload)
  local message = payload and (payload.message or payload.reason or payload.error) or nil
  if message == nil and result then message = result.message or result.reason or result.error end
  if message == nil and result then message = remoteValueText(result) end
  if message == nil then message = "Unknown remote-console response." end
  if type(message) == "table" then message = remoteValueText(message) end
  return remoteRedactText(message)
end

local function printRemoteAck(payload, action)
  payload = type(payload) == "table" and payload or {}
  if payload.ok ~= true then
    print("Remote console rejected: " .. remoteAckMessage(payload))
    return false
  end
  local result = remoteResultTable(payload) or payload
  local output = result.output or result.stdout or result.text or payload.output or payload.stdout
  if output ~= nil and tostring(output) ~= "" then print(remoteRedactText(output)) end
  if result.exitCode ~= nil then print("exitCode: " .. remoteValueText(result.exitCode)) end
  if result.truncated ~= nil then print("truncated: " .. remoteValueText(result.truncated)) end
  if action == "open" then
    print("Remote console opened. Type exit or quit to close.")
  elseif action == "close" and result.closed ~= true then
    print("Remote console closed.")
  elseif output == nil and action == "exec" then
    local visible = {}
    for key, value in pairs(result) do
      if not remoteSensitiveKey(key) and key ~= "output" and key ~= "stdout" and key ~= "text" then
        visible[key] = value
      end
    end
    if next(visible) ~= nil then print("Result: " .. remoteValueText(visible)) end
  end
  return true
end

local function remoteTimeoutSeconds()
  local remoteConfig = type(config.remoteConsole) == "table" and config.remoteConsole or {}
  local value = tonumber(remoteConfig.ackTimeoutSeconds or remoteConfig.timeoutSeconds or config.remoteTimeoutSeconds) or 8
  return math.max(1, math.min(60, value))
end

local function remoteRequest(session, action, commandText)
  if type(session) ~= "table" then return nil, "remote session unavailable" end
  local sequence
  if action == "open" then sequence = 0 else sequence = (tonumber(session.seq) or 0) + 1 end
  session.seq = sequence
  local payload = {
    command = "remote_console", action = tostring(action), sessionId = session.sessionId,
    nonce = session.nonce, seq = sequence,
  }
  if commandText ~= nil then
    payload.commandText = tostring(commandText)
    -- commandLine is an additive alias understood by workers from the first
    -- remote-console revision; commandText remains the canonical field.
    payload.commandLine = payload.commandText
  end
  local wireMessage = protocol.message("command", config.networkKey, payload, session.workerId)
  local pending = { action = action, seq = sequence, messageId = wireMessage.id, startedAt = common.nowSeconds() }
  session.pending, session.lastResult, session.lastAction = pending, nil, nil
  local ok, err = protocol.send(session.workerId, wireMessage)
  if not ok then session.pending = nil; return nil, "send failed: " .. tostring(err) end
  local deadline = common.nowSeconds() + (session.timeoutSeconds or remoteTimeoutSeconds())
  while session.pending == pending and common.nowSeconds() < deadline do
    local remaining = math.max(0.05, math.min(0.25, deadline - common.nowSeconds()))
    local sender, message = protocol.receive(remaining)
    if sender then handleMessage(sender, message) end
  end
  if session.pending == pending then
    session.pending = nil
    return nil, ("timeout waiting for remote-console %s ACK from #%s"):format(tostring(action), tostring(session.workerId))
  end
  return session.lastResult
end

local function remoteWorkerReady(workerId)
  local worker = workers[workerId] or workers[tostring(workerId)]
  if worker and statusOf(worker) == "offline" then return false, "Worker is offline." end
  return true
end

noticeState.remoteApi.consoleCommand = function(workerId, oneShot)
  workerId = tonumber(workerId)
  if not workerId or workerId < 1 or workerId ~= math.floor(workerId) then
    print("Usage: ccm remote <workerId> [-- <command...>]")
    return true
  end
  local ready, readyError = remoteWorkerReady(workerId)
  if not ready then print("Remote console rejected: " .. tostring(readyError)); return true end
  local session = {
    workerId = workerId, sessionId = remoteToken("session"), nonce = remoteToken("nonce"),
    seq = 0, timeoutSeconds = remoteTimeoutSeconds(),
  }
  noticeState.remoteSession = session
  local opened, openError = remoteRequest(session, "open")
  if not opened then
    noticeState.remoteSession = nil
    print("Remote console unavailable: " .. remoteRedactText(openError or remoteAckMessage(opened)))
    if opened then printRemoteAck(opened, "open") end
    return true
  end
  if not printRemoteAck(opened, "open") then noticeState.remoteSession = nil; return true end

  local function closeSession()
    if not noticeState.remoteSession then return end
    local closed, closeError = remoteRequest(session, "close")
    if not closed then print("Remote console close warning: " .. remoteRedactText(closeError or "unknown error"))
    elseif closed.ok ~= true then printRemoteAck(closed, "close") end
    noticeState.remoteSession = nil
  end

  if oneShot ~= nil then
    local text = tostring(oneShot)
    if common.trim(text):lower() ~= "exit" and common.trim(text):lower() ~= "quit" then
      local result, requestError = remoteRequest(session, "exec", text)
      if result then printRemoteAck(result, "exec") else print("Remote console timeout: " .. remoteRedactText(requestError or "unknown error")) end
    end
    closeSession()
    return true
  end

  while true do
    write(("remote #%s> "):format(tostring(workerId)))
    local text = read()
    text = tostring(text or "")
    local trimmed = common.trim(text)
    local lower = trimmed:lower()
    if lower == "exit" or lower == "quit" then break end
    if trimmed ~= "" then
      local result, requestError = remoteRequest(session, "exec", text)
      if result then printRemoteAck(result, "exec") else print("Remote console timeout: " .. remoteRedactText(requestError or "unknown error")) end
    end
  end
  closeSession()
  return true
end
end

local GROUP_WIRE_COMMAND = { start = "start", pause = "pause", resume = "resume", return_home = "recall", recall = "recall", service = "service", abort = "abort", clear = "clear" }

local function groupCommand(groupId, command, payload)
  local group = groupRecord(groupId)
  if not group then setNotice("Group not found: " .. tostring(groupId), true); return false, 0 end
  command = tostring(command or ""):lower()
  local requestedCommand = command
  if command == "return" then command = "return_home" end
  if command == "start" and not (payload and payload.groupJobId) then
    local current = activeGroupJob(groupId)
    if current then payload = common.copy(payload or {}); payload.groupJobId = current.groupJobId or current.id end
  end
  payload = type(payload) == "table" and common.copy(payload) or {}
  payload.group = true
  payload.scope = "group"
  payload.groupId = tostring(groupId)
  payload.requestedCommand = requestedCommand
  payload.groupCommand = string.upper(command == "return_home" and "RETURN" or command)
  local groupJob = payload.groupJobId and db.groupJobs[tostring(payload.groupJobId)] or activeGroupJob(groupId)
  if command == "clear" and groupJob and not groupWorkersTerminalAtHome(groupJob, true) then
    setNotice("Group CLEAR blocked until every worker is terminal and home.", true)
    return false, 0
  end
  if groupJob then
    payload.groupJobId = tostring(groupJob.groupJobId or groupJob.id)
    groupJob.acks = groupJob.acks or {}
    groupJob.lastCommand = payload.groupCommand
    groupJob.commandSentAt = common.nowSeconds()
  end
  local sent, attempted = 0, 0
  for _, id in ipairs(groupWorkerIds(group)) do
    attempted = attempted + 1
    local individual = common.copy(payload)
    individual.targetWorkerId = tonumber(id) or id
    individual.workerId = tonumber(id) or id
    individual.command = GROUP_WIRE_COMMAND[command] or command
    local assignment = groupJob and groupJob.assignments and (groupJob.assignments[tostring(id)] or groupJob.assignments[id])
    if assignment and command == "start" then
      individual.assignmentId = assignment.assignmentId
